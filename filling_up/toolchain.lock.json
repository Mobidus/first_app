{
  "locked_from": "reports/preflight.json",
  "tools": {
    "rojo": { "version": "7.5.1", "source": "crates.io", "install": "cargo install --locked rojo --version 7.5.1" },
    "lune": { "version": "0.10.1", "source": "crates.io", "install": "cargo install --locked lune --version 0.10.1" },
    "stylua": { "version": "2.1.0", "source": "crates.io", "install": "cargo install --locked stylua --version 2.1.0 --features luau" },
    "selene": { "version": "0.28.0", "source": "crates.io", "install": "cargo install --locked selene --version 0.28.0 --no-default-features --features roblox" },
    "bpy": { "version": "5.2.3", "source": "pypi", "python": "3.13" },
    "rust": { "version": "1.97.0" },
    "python": { "version": "3.13" }
  },
  "unavailable": ["roblox_studio", "luau-analyze", "roblox_open_cloud"]
}
