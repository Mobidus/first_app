        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">BurialLogic</string>
            <string name="Source"><![CDATA[--!strict
-- Burial confirmation logic (docs/05 §8, runtime.burial). Fed at 10 Hz by BurialService with
-- the results of MULTIPLE probes (5 overhead, 8 lateral) restricted to FillCollider/FillAggregate
-- parts plus an escape-clearance test. One raycast, a Touched event, immobility, elapsed time or
-- a global fill percentage are never enough: they are not even inputs of this module.

local Config = require(script.Parent.Parent.GeneratedConfig)

local B = Config.Runtime.burial
local SAFE = Config.Runtime.safety

local Burial = {}

Burial.SAMPLE_DT = 1 / B.sample_hz
Burial.CONFIRM = B.confirmation_seconds
Burial.RELEASE = B.release_hysteresis_seconds

export type Sample = {
	overheadProbes: number,
	overheadHits: number,
	lateralProbes: number,
	lateralHits: number,
	escapeAvailable: boolean?, -- result of the gabarit-compatible clearance test; nil = not run
	inKillVolume: boolean,
	roomActive: boolean,
	secondsSinceSpawn: number,
}

export type Tracker = { blockedFor: number, freeFor: number, warning: boolean, done: boolean }

function Burial.new(): Tracker
	return { blockedFor = 0, freeFor = 0, warning = false, done = false }
end

function Burial.isBlocked(s: Sample): boolean
	assert(
		s.overheadProbes == B.overhead_probe_count and s.lateralProbes == B.lateral_probe_count,
		"probe set does not match runtime.burial"
	)
	if s.escapeAvailable == nil then
		return false -- clearance test is mandatory to confirm (requires_escape_clearance_test)
	end
	return s.overheadHits >= B.min_overhead_hits and s.lateralHits >= B.min_lateral_hits and s.escapeAvailable == false
end

-- Advances the tracker by dt seconds. Returns nil or one of:
--   "warning_on" | "warning_off" | "ko_burial" | "ko_kill_volume"
function Burial.step(t: Tracker, s: Sample, dt: number): string?
	if t.done or not s.roomActive then
		return nil
	end
	if s.inKillVolume then
		t.done = true
		return "ko_kill_volume"
	end
	local grace = s.secondsSinceSpawn < SAFE.spawn_invulnerability_seconds
	if Burial.isBlocked(s) then
		t.blockedFor += dt
		t.freeFor = 0
		if not t.warning then
			t.warning = true
			return "warning_on"
		end
		if t.blockedFor >= Burial.CONFIRM - 1e-9 and not grace then
			t.done = true
			return "ko_burial"
		end
		return nil
	end
	t.freeFor += dt
	if t.freeFor >= Burial.RELEASE - 1e-9 then
		t.blockedFor = 0
		if t.warning then
			t.warning = false
			return "warning_off"
		end
	end
	return nil
end

return Burial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Checkpoint</string>
            <string name="Source"><![CDATA[--!strict
-- Checkpoints between rooms and resume rules (docs/05 §9, runtime.profile).
-- Resume = same seed, same depth, same config version, room reward mask preserved; the room
-- instance id is derived from runId+depth, so tool charges are NOT refilled by reconnecting.

local Config = require(script.Parent.Parent.GeneratedConfig)

local Checkpoint = {}

function Checkpoint.roomInstanceId(runId: string, depth: number): string
	return runId .. ":" .. tostring(depth)
end

function Checkpoint.fromExpedition(exp, extra: { rateBasisPoints: number, paidBaseCumulative: number, charges: { [string]: number }? }): any
	return {
		runId = exp.runId,
		seed = exp.seed,
		configVersion = exp.configVersion,
		depth = exp.depth,
		roomRewardMask = exp.roomRewardMask,
		lastCommittedDepth = exp.lastCommittedDepth,
		checkpointRevision = exp.checkpointRevision + 1,
		roomInstanceId = Checkpoint.roomInstanceId(exp.runId, exp.depth),
		chargesSnapshot = extra.charges,
		rateBasisPoints = extra.rateBasisPoints,
		paidBaseCumulative = extra.paidBaseCumulative,
	}
end

export type ResumePlan = { mode: "resume" | "extracted" | "none", reason: string?, params: any? }

-- Decide how to resume a stored checkpoint with the running server's config version.
function Checkpoint.plan(cp: any?, currentConfigVersion: string?): ResumePlan
	if cp == nil then
		return { mode = "none" }
	end
	local version = currentConfigVersion or Config.configVersion
	if cp.configVersion ~= version then
		-- incompatible rules: goods are kept (they live in the profile), the run is closed and the
		-- player is told why; no record is fabricated under different rules.
		return { mode = "extracted", reason = "config_version_changed" }
	end
	return {
		mode = "resume",
		params = {
			runId = cp.runId,
			seed = cp.seed,
			depth = cp.depth,
			roomRewardMask = cp.roomRewardMask,
			lastCommittedDepth = cp.lastCommittedDepth,
			checkpointRevision = cp.checkpointRevision,
			resumed = true,
			configVersion = cp.configVersion,
			rateBasisPoints = cp.rateBasisPoints,
			paidBaseCumulative = cp.paidBaseCumulative,
			roomInstanceId = cp.roomInstanceId,
			chargesSnapshot = cp.chargesSnapshot,
		},
	}
end

return Checkpoint
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Consolidation</string>
            <string name="Source"><![CDATA[--!strict
-- Hybrid physics budget planner (docs/05 §7). Keeps <= 40 dynamic bodies and <= 120 static fill
-- colliders in the active room WITHOUT ever removing an occupied, route-critical or accessible
-- support: settled bodies are anchored; only inaccessible buried statics are merged/recycled;
-- if nothing safe can be reclaimed, new drops are deferred (spawn allowance 0) instead.

local Config = require(script.Parent.Parent.GeneratedConfig)

local S = Config.Runtime.streaming

local C = {}

C.MAX_DYNAMIC = S.max_dynamic_objects
C.MAX_STATIC = S.max_static_fill_colliders
C.SETTLE_SECONDS = 0.75

export type Obj = {
	id: string,
	dynamic: boolean,
	settledFor: number, -- seconds with negligible velocity
	occupied: boolean, -- a player stands on / touches it
	routeSupport: boolean, -- guaranteed route node or protected
	buried: boolean, -- covered on top and sides: not reachable
	age: number,
}

export type Plan = { anchor: { string }, merge: { string }, recycle: { string }, spawnAllowance: number }

function C.plan(objects: { Obj }): Plan
	local dyn, stat = {}, {}
	for _, o in objects do
		if o.dynamic then
			table.insert(dyn, o)
		else
			table.insert(stat, o)
		end
	end
	local anchor, merge, recycle = {}, {}, {}
	-- 1. anchor settled dynamic bodies (oldest first) until within budget; occupied ones wait
	table.sort(dyn, function(a, b)
		return a.age > b.age
	end)
	local dynCount = #dyn
	for _, o in dyn do
		if dynCount <= C.MAX_DYNAMIC - 1 then
			break
		end
		if o.settledFor >= C.SETTLE_SECONDS and not o.occupied then
			table.insert(anchor, o.id)
			dynCount -= 1
		end
	end
	-- anchoring always applies to long-settled bodies too (stabilized supports never roll again)
	for _, o in dyn do
		if o.settledFor >= C.SETTLE_SECONDS * 4 and not o.occupied and not table.find(anchor, o.id) then
			table.insert(anchor, o.id)
			dynCount -= 1
		end
	end
	local statCount = #stat + #anchor
	-- 2. static budget: merge buried, never occupied / route / accessible
	if statCount > C.MAX_STATIC then
		table.sort(stat, function(a, b)
			return a.age > b.age
		end)
		local over = statCount - C.MAX_STATIC
		local buriedIds = {}
		for _, o in stat do
			if o.buried and not o.occupied and not o.routeSupport then
				table.insert(buriedIds, o.id)
			end
		end
		-- merging k buried colliders into one aggregate saves k-1 colliders
		local k = math.min(#buriedIds, over + 1)
		if k >= 2 then
			for i = 1, k do
				table.insert(merge, buriedIds[i])
			end
			statCount -= (k - 1)
		end
		local i = k + 1
		while statCount > C.MAX_STATIC and i <= #buriedIds do
			table.insert(recycle, buriedIds[i])
			statCount -= 1
			i += 1
		end
	end
	local allowance = math.max(0, C.MAX_DYNAMIC - dynCount)
	if statCount >= C.MAX_STATIC then
		allowance = 0 -- defer drops: never delete an accessible support to make room
	end
	return { anchor = anchor, merge = merge, recycle = recycle, spawnAllowance = allowance }
end

return C
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Difficulty</string>
            <string name="Source"><![CDATA[--!strict
-- Difficulty bands (rooms.json difficulty_bands). Physical parameters are bounded: beyond the
-- last band nothing escalates any more, only combinations vary.
local Config = require(script.Parent.Parent.GeneratedConfig)

local Difficulty = {}

function Difficulty.bandForDepth(depth: number)
	assert(type(depth) == "number" and depth >= 1, "depth must be >= 1")
	for _, b in Config.Rooms.difficulty_bands do
		if depth >= b.depth_min and (b.depth_max == nil or depth <= b.depth_max) then
			return b
		end
	end
	error("no difficulty band for depth " .. depth)
end

-- Bounds that hold for EVERY depth (used by tests and the soak simulation).
function Difficulty.bounds()
	local minInterval, maxRatio, maxObjects, minWarning = math.huge, 0, 0, math.huge
	for _, b in Config.Rooms.difficulty_bands do
		minInterval = math.min(minInterval, b.wave_interval_seconds)
		maxRatio = math.max(maxRatio, b.maximum_required_gap_ratio)
		maxObjects = math.max(maxObjects, b.physical_objects_per_wave)
		minWarning = math.min(minWarning, b.warning_seconds)
	end
	return { minInterval = minInterval, maxRatio = maxRatio, maxObjectsPerWave = maxObjects, minWarning = minWarning }
end

return Difficulty
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Coin catalog, qualification and purchase planning (docs/03 §4, §6). Prices come ONLY from the
-- compiled economy config. Functions are pure: they inspect a profile and return a plan; the
-- profile mutation itself is applied atomically by ProfileMutations.

local Config = require(script.Parent.Parent.GeneratedConfig)

local Econ = Config.Economy

local Economy = {}

-- Tools actually implemented in this build. Others stay visible but are not purchasable
-- ("Les outils non implémentés ne sont pas achetables dans le MVP").
Economy.IMPLEMENTED_TOOLS = table.freeze({ radar_pop = true, aimant_poche = true, ventouse_chantier = true, parapluie_bonbon = true })

local TOOLS: { [string]: any } = {}
for _, t in Econ.tools do
	TOOLS[t.id] = t
end
local COSMETICS: { [string]: any } = {}
for _, c in Econ.cosmetics do
	COSMETICS[c.id] = c
end
local PREMIUM_GRANTS: { [string]: string } = {}
for _, p in Econ.premium_cosmetics do
	for _, g in p.grants do
		PREMIUM_GRANTS[g] = p.slot
	end
end

function Economy.tool(id: string)
	return TOOLS[id]
end

function Economy.cosmetic(id: string)
	return COSMETICS[id]
end

function Economy.toolStats(id: string, rank: number)
	local t = TOOLS[id]
	assert(t, "unknown tool " .. tostring(id))
	local r = t.ranks[math.clamp(rank, 1, #t.ranks)]
	return r.stats
end

local function completedRooms(profile): number
	return profile.roomMastery and profile.roomMastery.totalCompleted or 0
end

local function tutorialDone(profile): boolean
	return profile.tutorialFlags ~= nil and profile.tutorialFlags.tutorial_exit == true
end

-- Qualification shared by tools and cosmetics (never reset by KO or rebirth).
function Economy.qualifies(profile, unlock): (boolean, string?)
	if unlock.tutorial_complete and not tutorialDone(profile) then
		return false, "tutorial_required"
	end
	if completedRooms(profile) < (unlock.min_completed_rooms or 0) then
		return false, "rooms_required"
	end
	if (profile.rebirthCount or 0) < (unlock.min_rebirth_rank or 0) then
		return false, "rebirth_rank_required"
	end
	if unlock.requires_tool_id and not profile.ownedTools[unlock.requires_tool_id] then
		return false, "tool_required"
	end
	return true, nil
end

export type PurchasePlan = {
	skuId: string,
	kind: "tool" | "upgrade" | "cosmetic",
	itemId: string,
	price: number,
	newRank: number?,
}

-- Parses "tool_id#rankN" upgrade SKUs.
local function parseSku(skuId: string): (string, number?)
	local id, rank = string.match(skuId, "^([%w_]+)#rank(%d)$")
	if id then
		return id, tonumber(rank)
	end
	return skuId, nil
end

-- Returns (true, plan) or (false, reason). Reasons are stable codes for the UI.
function Economy.planCoinPurchase(profile, skuId: string): (boolean, any)
	local id, rank = parseSku(skuId)
	local tool = TOOLS[id]
	if tool then
		if not Economy.IMPLEMENTED_TOOLS[id] then
			return false, "unavailable"
		end
		local ok, why = Economy.qualifies(profile, tool.unlock)
		if not ok then
			return false, why
		end
		if rank == nil then
			if profile.ownedTools[id] then
				return false, "owned"
			end
			return true, { skuId = skuId, kind = "tool", itemId = id, price = tool.coins, newRank = 1 } :: PurchasePlan
		end
		if not profile.ownedTools[id] then
			return false, "tool_required"
		end
		local current = profile.toolRanks[id] or 1
		if rank > #tool.ranks or rank > Econ.upgrade_costs.max_rank then
			return false, "max_rank"
		end
		if rank <= current then
			return false, "owned"
		end
		if rank ~= current + 1 then
			return false, "previous_rank_required"
		end
		return true,
			{ skuId = skuId, kind = "upgrade", itemId = id, price = tool.ranks[rank].upgrade_coins, newRank = rank } :: PurchasePlan
	end
	local cos = COSMETICS[id]
	if cos and rank == nil then
		if profile.ownedCosmetics[id] then
			return false, "owned"
		end
		local ok, why = Economy.qualifies(profile, cos.unlock)
		if not ok then
			return false, why
		end
		return true, { skuId = skuId, kind = "cosmetic", itemId = id, price = cos.coins } :: PurchasePlan
	end
	return false, "unknown_sku"
end

-- Display state for the shop (never authoritative): "owned" | "buyable" | "insufficient" | reason
function Economy.displayState(profile, skuId: string): (string, number?)
	local ok, planOrWhy = Economy.planCoinPurchase(profile, skuId)
	if not ok then
		return planOrWhy, nil
	end
	if profile.coins < planOrWhy.price then
		return "insufficient", planOrWhy.price
	end
	return "buyable", planOrWhy.price
end

function Economy.upgradeCost(toolId: string, rank: number): number
	local t = TOOLS[toolId]
	assert(t and t.ranks[rank], "bad tool/rank")
	return t.ranks[rank].upgrade_coins
end

-- Equipment: 1 active, 1 passive, 1 companion (+ purely visual cosmetic slots).
function Economy.planEquip(profile, itemId: string, slot: string): (boolean, any)
	if itemId == "" then
		return true, { slot = slot, itemId = nil }
	end
	local tool = TOOLS[itemId]
	if tool then
		if not profile.ownedTools[itemId] then
			return false, "not_owned"
		end
		if tool.slot ~= slot then
			return false, "incompatible_slot"
		end
		if not Economy.IMPLEMENTED_TOOLS[itemId] then
			return false, "unavailable"
		end
		return true, { slot = slot, itemId = itemId }
	end
	local cos = COSMETICS[itemId]
	if cos then
		if not profile.ownedCosmetics[itemId] then
			return false, "not_owned"
		end
		if cos.slot ~= slot then
			return false, "incompatible_slot"
		end
		return true, { slot = slot, itemId = itemId }
	end
	local premiumSlot = PREMIUM_GRANTS[itemId]
	if premiumSlot then
		if not profile.purchaseLedger.entitlements[itemId] then
			return false, "not_owned"
		end
		return true, { slot = slot, itemId = itemId }
	end
	return false, "unknown_item"
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">ExpeditionStateMachine</string>
            <string name="Source"><![CDATA[--!strict
-- Pure expedition state machine (docs/05 §4). No engine service, no clock, no fill percentage.
-- Every transition returns a NEW state table; illegal transitions are rejected with a code.
--
-- KO is accepted only for causes listed in config runtime.ko_causes. There is deliberately no
-- event carrying elapsed time or fill percentage: a KO can never be derived from them here.

local Types = require(script.Parent.Parent.Types)
local Config = require(script.Parent.Parent.GeneratedConfig)

type State = Types.ExpeditionState

local Machine = {}

local ALLOWED_KO: { [string]: boolean } = {}
for _, cause in Config.Runtime.ko_causes do
	ALLOWED_KO[cause] = true
end

local TRANSITIONS: { [string]: { [string]: boolean } } = {
	Preparing = { Active = true },
	Active = { Transitioning = true, KO = true, Suspended = true },
	Transitioning = { Active = true, Suspended = true, Extracted = true },
	Suspended = { Preparing = true },
	KO = {},
	Extracted = {},
}
Machine.TRANSITIONS = TRANSITIONS

local function copy(state: State): State
	local s = table.clone(state)
	s.equippedLoadoutSnapshot = table.clone(state.equippedLoadoutSnapshot)
	return s
end

function Machine.create(params: {
	runId: string,
	seed: number,
	controllerProfileId: string?,
	loadout: Types.EquippedLoadout?,
	depth: number?,
	roomRewardMask: number?,
	lastCommittedDepth: number?,
	checkpointRevision: number?,
	resumed: boolean?,
	configVersion: string?,
}): State
	assert(type(params.runId) == "string" and #params.runId > 0, "runId required")
	local depth = params.depth or 1
	assert(depth >= 1 and depth % 1 == 0, "depth must be a positive integer")
	return {
		runId = params.runId,
		seed = params.seed,
		configVersion = params.configVersion or Config.configVersion,
		controllerProfileId = params.controllerProfileId or "R15_normalized_gameplay_body",
		depth = depth,
		state = "Preparing",
		roomId = "",
		waveIndex = 0,
		roomRewardMask = params.roomRewardMask or 0,
		lastCommittedDepth = params.lastCommittedDepth or (depth - 1),
		equippedLoadoutSnapshot = params.loadout and table.clone(params.loadout) or {},
		checkpointRevision = params.checkpointRevision or 0,
		koCause = nil,
		transitionsCommitted = 0,
		resumed = params.resumed == true,
	}
end

export type Event =
	{ type: "RoomReady", roomId: string }
	| { type: "ExitReached", roomId: string, depth: number }
	| { type: "NextRoomActive", roomId: string }
	| { type: "KOConfirmed", cause: string }
	| { type: "Suspend", checkpointRevision: number? }
	| { type: "Resume" }
	| { type: "Extract", inSas: boolean }
	| { type: "WaveAdvanced", waveIndex: number }

local function reject(code: string): (boolean, any)
	return false, code
end

function Machine.can(from: string, to: string): boolean
	local row = TRANSITIONS[from]
	return row ~= nil and row[to] == true
end

-- Returns (true, newState) or (false, errorCode). The input state is never mutated.
function Machine.apply(state: State, event: Event): (boolean, any)
	local kind = event.type
	if kind == "RoomReady" then
		if state.state ~= "Preparing" then
			return reject("illegal_transition")
		end
		local s = copy(state)
		s.state = "Active"
		s.roomId = (event :: any).roomId
		s.waveIndex = 0
		return true, s
	elseif kind == "WaveAdvanced" then
		if state.state ~= "Active" then
			return reject("not_active")
		end
		local idx = (event :: any).waveIndex
		if type(idx) ~= "number" or idx <= state.waveIndex then
			return reject("non_monotonic_wave")
		end
		local s = copy(state)
		s.waveIndex = idx
		return true, s
	elseif kind == "ExitReached" then
		local e = event :: any
		-- a second contact / repeated request is rejected: depth increments exactly once
		if state.state ~= "Active" then
			return reject(state.state == "Transitioning" and "duplicate_exit" or "illegal_transition")
		end
		if e.roomId ~= state.roomId or e.depth ~= state.depth then
			return reject("stale_exit")
		end
		if state.depth <= state.lastCommittedDepth then
			return reject("already_committed")
		end
		local s = copy(state)
		s.state = "Transitioning"
		s.lastCommittedDepth = state.depth
		s.depth = state.depth + 1
		s.transitionsCommitted += 1
		return true, s
	elseif kind == "NextRoomActive" then
		if state.state ~= "Transitioning" then
			return reject("illegal_transition")
		end
		local s = copy(state)
		s.state = "Active"
		s.roomId = (event :: any).roomId
		s.waveIndex = 0
		s.roomRewardMask = 0 -- new room instance: fresh milestones
		return true, s
	elseif kind == "KOConfirmed" then
		local cause = (event :: any).cause
		if not ALLOWED_KO[cause] then
			return reject("ko_cause_not_allowed")
		end
		if state.state ~= "Active" then
			-- the sas (Transitioning) has no hazard; KO there is impossible by contract
			return reject("ko_outside_active_room")
		end
		local s = copy(state)
		s.state = "KO"
		s.koCause = cause
		return true, s
	elseif kind == "Suspend" then
		if not (state.state == "Active" or state.state == "Transitioning") then
			return reject("illegal_transition")
		end
		local s = copy(state)
		s.state = "Suspended"
		s.checkpointRevision = (event :: any).checkpointRevision or state.checkpointRevision
		return true, s
	elseif kind == "Resume" then
		if state.state ~= "Suspended" then
			return reject("illegal_transition")
		end
		local s = copy(state)
		s.state = "Preparing"
		s.resumed = true
		return true, s
	elseif kind == "Extract" then
		if state.state ~= "Transitioning" or (event :: any).inSas ~= true then
			return reject("extract_only_in_sas")
		end
		local s = copy(state)
		s.state = "Extracted"
		return true, s
	end
	return reject("unknown_event")
end

function Machine.isTerminal(state: State): boolean
	return state.state == "KO" or state.state == "Extracted"
end

return Machine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">IntentValidation</string>
            <string name="Source"><![CDATA[--!strict
-- Typed, bounded client intents (docs/05 §5). The server never accepts amounts, prices,
-- permit counts or "room completed" from a client: such fields are not part of any schema and
-- any unexpected argument makes the whole intent invalid.

local Config = require(script.Parent.Parent.GeneratedConfig)

local Intent = {}

local MAX_ID_LEN = 64
local MAX_TOKEN_LEN = 128
local MAX_ARGS = 4

local TOOL_IDS: { [string]: boolean } = {}
for _, t in Config.Economy.tools do
	TOOL_IDS[t.id] = true
end
local COSMETIC_SLOTS: { [string]: string } = {}
for _, c in Config.Economy.cosmetics do
	COSMETIC_SLOTS[c.id] = c.slot
end
local SKUS: { [string]: string } = {}
for _, t in Config.Economy.tools do
	SKUS[t.id] = "tool"
	for r = 2, #t.ranks do
		SKUS[t.id .. "#rank" .. r] = "upgrade"
	end
end
for _, c in Config.Economy.cosmetics do
	SKUS[c.id] = "cosmetic"
end
Intent.SKU_KINDS = SKUS

local SLOTS = {
	active = true,
	passive = true,
	companion = true,
	trail = true,
	tool_skin = true,
	landing_fx = true,
	victory_fx = true,
	workshop_skin = true,
}

local function isId(v: any, max: number?): boolean
	return type(v) == "string" and #v > 0 and #v <= (max or MAX_ID_LEN) and string.match(v, "^[%w_#:%-%.]+$") ~= nil
end

local function isPositiveInt(v: any, max: number): boolean
	return type(v) == "number" and v == v and v % 1 == 0 and v >= 1 and v <= max
end

local function isNonNegInt(v: any): boolean
	return type(v) == "number" and v == v and v % 1 == 0 and v >= 0 and v < 2 ^ 53
end

export type Validated = { name: string, args: { [string]: any } }

local SCHEMAS: { [string]: (args: { any }) -> (boolean, any) } = {
	RequestToolUse = function(a)
		if #a ~= 3 or not TOOL_IDS[a[1]] then
			return false, "bad_tool"
		end
		if not (a[2] == "" or isId(a[2])) or not isId(a[3]) then
			return false, "bad_args"
		end
		return true, { toolId = a[1], targetId = a[2], requestId = a[3] }
	end,
	RequestEquip = function(a)
		if #a ~= 3 or not SLOTS[a[2]] or not isId(a[3]) then
			return false, "bad_args"
		end
		local item = a[1]
		if item ~= "" and not (TOOL_IDS[item] or COSMETIC_SLOTS[item] or (isId(item) and string.sub(item, 1, 8) == "premium_")) then
			return false, "unknown_item"
		end
		return true, { itemId = item, slot = a[2], requestId = a[3] }
	end,
	RequestCoinPurchase = function(a)
		if #a ~= 2 or not SKUS[a[1]] or not isId(a[2]) then
			return false, "bad_args"
		end
		return true, { skuId = a[1], requestId = a[2] }
	end,
	RequestRebirthPreview = function(a)
		if #a ~= 2 or not isPositiveInt(a[1], 1000) or not isId(a[2]) then
			return false, "bad_args"
		end
		return true, { quantity = a[1], requestId = a[2] }
	end,
	RequestRebirth = function(a)
		if #a ~= 4 or not isPositiveInt(a[1], 1000) or not isNonNegInt(a[2]) or not isId(a[3], MAX_TOKEN_LEN) or not isId(a[4]) then
			return false, "bad_args"
		end
		return true, { quantity = a[1], expectedRevision = a[2], previewToken = a[3], requestId = a[4] }
	end,
	RequestSaveExit = function(a)
		if #a ~= 1 or not isId(a[1]) then
			return false, "bad_args"
		end
		return true, { requestId = a[1] }
	end,
	RequestRestart = function(a)
		if #a ~= 1 or not isId(a[1]) then
			return false, "bad_args"
		end
		return true, { requestId = a[1] }
	end,
	RequestRobuxPurchase = function(a)
		if #a ~= 2 or not isId(a[1]) or not isId(a[2]) then
			return false, "bad_args"
		end
		return true, { skuId = a[1], requestId = a[2] }
	end,
}
Intent.NAMES = {}
for name in SCHEMAS do
	table.insert(Intent.NAMES, name)
end
table.sort(Intent.NAMES)

-- validate("RequestCoinPurchase", {"radar_pop", "req-1"}) -> (true, {skuId=..., requestId=...})
function Intent.validate(name: string, args: { any }): (boolean, any)
	local schema = SCHEMAS[name]
	if not schema then
		return false, "unknown_intent"
	end
	if type(args) ~= "table" or #args > MAX_ARGS then
		return false, "bad_args"
	end
	for k in args do
		if type(k) ~= "number" then
			return false, "bad_args"
		end
	end
	return schema(args)
end

-- Token-bucket rate limiter; the clock is injected (server: os.clock / workspace time).
export type Limiter = { capacity: number, refillPerSecond: number, buckets: { [string]: { tokens: number, t: number } } }

function Intent.newLimiter(capacity: number, refillPerSecond: number): Limiter
	return { capacity = capacity, refillPerSecond = refillPerSecond, buckets = {} }
end

function Intent.allow(limiter: Limiter, key: string, now: number): boolean
	local b = limiter.buckets[key]
	if not b then
		b = { tokens = limiter.capacity, t = now }
		limiter.buckets[key] = b
	end
	b.tokens = math.min(limiter.capacity, b.tokens + (now - b.t) * limiter.refillPerSecond)
	b.t = now
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	return false
end

function Intent.forget(limiter: Limiter, keyPrefix: string)
	for k in limiter.buckets do
		if string.sub(k, 1, #keyPrefix) == keyPrefix then
			limiter.buckets[k] = nil
		end
	end
end

return Intent
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">JumpModel</string>
            <string name="Source"><![CDATA[--!strict
-- Jump capability table used by generation and validation.
--
-- STATUS: analytic, PROVISIONAL. docs/01 requires a table MEASURED with the real controller in
-- Studio (T06 MovementLab). Until reports/movement_calibration.json carries measured values, the
-- ballistic model below (config runtime.player: walk 16 studs/s, jump height 7.2, g 196.2) is used
-- and every route is additionally constrained by the band's maximum_required_gap_ratio. When the
-- measured table exists, `Jump.setMeasuredTable` replaces the analytic reach (no other change).

local Config = require(script.Parent.Parent.GeneratedConfig)

local P = Config.Runtime.player

local Jump = {}

Jump.WALK = P.walk_speed_studs_s
Jump.HEIGHT = P.jump_height_studs
Jump.GRAVITY = P.gravity_studs_s2
Jump.V0 = math.sqrt(2 * Jump.GRAVITY * Jump.HEIGHT)
-- Normalized gameplay body (R15_normalized_gameplay_body): collider used for clearance checks.
Jump.AVATAR = { width = 2, height = 5, depth = 1.5 }
-- A required route never asks for more than this fraction of the theoretical maximum rise.
Jump.REQUIRED_RISE_FRACTION = 0.75
Jump.source = "analytic_provisional"

local measured: { { rise: number, reach: number } }? = nil

-- Air time until the feet come back to `rise` studs above take-off (nil if unreachable).
function Jump.airTime(rise: number): number?
	local disc = Jump.V0 * Jump.V0 - 2 * Jump.GRAVITY * rise
	if disc < 0 then
		return nil
	end
	return (Jump.V0 + math.sqrt(disc)) / Jump.GRAVITY
end

-- Max horizontal edge-to-edge distance for a landing `rise` studs higher (negative = lower).
function Jump.reach(rise: number): number
	if measured then
		-- linear interpolation in the measured table (sorted by rise)
		local m = measured :: { { rise: number, reach: number } }
		if rise <= m[1].rise then
			return m[1].reach
		end
		for i = 2, #m do
			if rise <= m[i].rise then
				local a, b = m[i - 1], m[i]
				local t = (rise - a.rise) / (b.rise - a.rise)
				return a.reach + (b.reach - a.reach) * t
			end
		end
		return 0
	end
	local t = Jump.airTime(rise)
	return if t then Jump.WALK * t else 0
end

function Jump.maxRequiredRise(): number
	return Jump.HEIGHT * Jump.REQUIRED_RISE_FRACTION
end

-- Is a REQUIRED hop feasible under the band ratio?
function Jump.requiredHopOk(gap: number, rise: number, gapRatio: number): boolean
	if rise > Jump.maxRequiredRise() + 1e-9 then
		return false
	end
	return gap <= gapRatio * Jump.reach(math.max(rise, 0)) + 1e-9
end

-- Sampled positions of the avatar's feet along a hop from (x0,y0,z0) leaving the edge toward
-- (x1,y1,z1). Horizontal speed = walk speed. Returns { {x,y,z} } including apex.
function Jump.arc(x0: number, y0: number, z0: number, x1: number, y1: number, z1: number, samples: number?): { { number } }
	local n = samples or 16
	local dx, dz = x1 - x0, z1 - z0
	local dist = math.sqrt(dx * dx + dz * dz)
	local rise = y1 - y0
	local t = Jump.airTime(math.max(rise, -1e9)) or (2 * Jump.V0 / Jump.GRAVITY)
	local T = math.max(t, dist / Jump.WALK)
	local pts = {}
	for i = 0, n do
		local tt = T * i / n
		local frac = if dist > 0 then math.min(1, (Jump.WALK * tt) / dist) else 0
		local y = y0 + Jump.V0 * tt - 0.5 * Jump.GRAVITY * tt * tt
		if tt >= T then
			y = y1
		end
		table.insert(pts, { x0 + dx * frac, math.max(y, math.min(y0, y1)), z0 + dz * frac })
	end
	return pts
end

function Jump.setMeasuredTable(rows: { { rise: number, reach: number } })
	table.sort(rows, function(a, b)
		return a.rise < b.rise
	end)
	measured = rows
	Jump.source = "measured"
end

return Jump
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">PlushPose</string>
            <string name="Source"><![CDATA[--!strict
-- Visual plush deformation, reconstructed from the REFERENCE pose and an impact event every time
-- (no cumulative transform => no drift). Output = bone translations + rotations; there is no bone
-- scale (Bone.Transform is a CFrame). Server collisions, rewards and KO never read this module.

local Config = require(script.Parent.Parent.GeneratedConfig)

local D = Config.Runtime.deformation

local Pose = {}

Pose.COMPRESS = D.impact_compression_seconds
Pose.REBOUND = D.rebound_seconds
Pose.TOTAL = D.max_total_settle_seconds
-- settle phase is shortened so that compression + rebound + settle never exceeds the cap
Pose.SETTLE = math.min(D.settle_seconds, D.max_total_settle_seconds - D.impact_compression_seconds - D.rebound_seconds)
Pose.MIN_Y = D.impact_scale_y_min
Pose.MAX_XZ = D.impact_scale_xz_max
Pose.MAX_STRETCH = D.fall_stretch_y_max
Pose.MAX_SECONDARY_RAD = math.rad(D.max_secondary_angle_degrees)
Pose.TOP_TOLERANCE = D.walkable_top_alignment_tolerance_studs
-- reference speeds (decision 0007, to calibrate in PlushLab): full stretch / full impact
Pose.FALL_REF_SPEED = 60
Pose.IMPACT_REF_SPEED = 50
Pose.OVERSHOOT = 0.06
Pose.CONTACT_DENT = 0.15 -- player standing on a supporting plush: <= tolerance (0.25)

export type BoneRest = { name: string, x: number, y: number, z: number, secondary: boolean, sign: number? }

-- Mallow rig as exported by assets/source/blender/build_plush.py (pose_library.json
-- bone_rest_heads, studs, Roblox model space, relative to the non-deforming Root at base centre):
-- 9 belly lattice bones Belly_<x><z> + 5 secondary bones. Used for the proxy and as a fallback;
-- with the imported mesh the controller reads the actual Bones (Pose.rigFromBones).
local MALLOW_REST = {
	{ "Belly_00", -4, 3, 3 },
	{ "Belly_10", -1, 3, 3 },
	{ "Belly_20", 2, 3, 3 },
	{ "Belly_01", -4, 3, 0 },
	{ "Belly_11", -1, 3, 0 },
	{ "Belly_21", 2, 3, 0 },
	{ "Belly_02", -4, 3, -3 },
	{ "Belly_12", -1, 3, -3 },
	{ "Belly_22", 2, 3, -3 },
	{ "Head", 3, 2.6, 0 },
	{ "Arm_L", 1.2, 2.4, -3.1 },
	{ "Arm_R", 1.2, 2.4, 3.1 },
	{ "Leg_L", -3.8, 2.2, -2.6 },
	{ "Leg_R", -3.8, 2.2, 2.6 },
}

local function isSecondary(name: string): boolean
	return string.sub(name, 1, 6) ~= "Belly_"
end

local function sideSign(name: string): number
	return if string.sub(name, -2) == "_R" then -1 else 1
end

function Pose.mallowRig(): { BoneRest }
	local bones = {}
	for _, b in MALLOW_REST do
		table.insert(bones, { name = b[1], x = b[2], y = b[3], z = b[4], secondary = isSecondary(b[1]), sign = sideSign(b[1]) })
	end
	return bones
end

-- Build a rig description from runtime bones: { {name, x, y, z} } in root space. "Root" is skipped
-- (it never moves). Belly lattice = names starting with "Belly_".
function Pose.rigFromBones(list: { { name: string, x: number, y: number, z: number } }): { BoneRest }
	local bones = {}
	for _, b in list do
		if b.name ~= "Root" then
			table.insert(bones, { name = b.name, x = b.x, y = b.y, z = b.z, secondary = isSecondary(b.name), sign = sideSign(b.name) })
		end
	end
	return bones
end

local function easeOut(x: number): number
	return 1 - (1 - x) * (1 - x)
end

function Pose.strengthFromSpeed(impactSpeed: number): number
	return math.clamp(impactSpeed / Pose.IMPACT_REF_SPEED, 0, 1)
end

-- Vertical scale envelope after an impact of `strength` (0..1), t seconds after impact.
function Pose.scaleYAfterImpact(strength: number, t: number): number
	local s = math.clamp(strength, 0, 1)
	local minY = 1 - (1 - Pose.MIN_Y) * s
	local peak = 1 + Pose.OVERSHOOT * s
	if t <= 0 then
		return 1
	elseif t < Pose.COMPRESS then
		return 1 + (minY - 1) * easeOut(t / Pose.COMPRESS)
	elseif t < Pose.COMPRESS + Pose.REBOUND then
		local u = (t - Pose.COMPRESS) / Pose.REBOUND
		return minY + (peak - minY) * easeOut(u)
	elseif t < Pose.TOTAL then
		local u = (t - Pose.COMPRESS - Pose.REBOUND) / (Pose.TOTAL - Pose.COMPRESS - Pose.REBOUND)
		-- damped oscillation from the overshoot back to rest (1.5 half-periods), exactly 1 at the end
		local amp = (peak - 1) * (1 - u)
		return 1 + amp * math.cos(u * math.pi * 3)
	end
	return 1
end

function Pose.scaleYFalling(verticalSpeed: number): number
	local f = math.clamp(math.abs(verticalSpeed) / Pose.FALL_REF_SPEED, 0, 1)
	return 1 + (Pose.MAX_STRETCH - 1) * f
end

function Pose.scaleXZFor(scaleY: number): number
	if scaleY < 1 then
		return math.min(Pose.MAX_XZ, 1 + (1 - scaleY) * ((Pose.MAX_XZ - 1) / (1 - Pose.MIN_Y)))
	end
	return math.max(0.94, 1 - (scaleY - 1) * 0.5)
end

function Pose.settleState(t: number): string
	if t < 0 then
		return "falling"
	elseif t < Pose.COMPRESS then
		return "impact"
	elseif t < Pose.TOTAL then
		return "settling"
	end
	return "supporting"
end

export type BonePose = { name: string, offset: { number }, rotation: { number } }
export type PoseResult = { scaleY: number, scaleXZ: number, state: string, bones: { BonePose }, topOffset: number }

-- Full pose. `phase` = "falling" (uses verticalSpeed) or "impact" (uses strength + t).
-- `enabled=false` (low-end devices / reduced effects) => reference pose; gameplay unchanged.
function Pose.compute(
	rig: { BoneRest },
	params: { phase: string, t: number?, strength: number?, verticalSpeed: number?, standing: boolean?, enabled: boolean? }
): PoseResult
	local sy = 1
	local state = "supporting"
	local t = params.t or 0
	if params.enabled ~= false then
		if params.phase == "falling" then
			sy = Pose.scaleYFalling(params.verticalSpeed or 0)
			state = "falling"
		else
			sy = Pose.scaleYAfterImpact(params.strength or 0, t)
			state = Pose.settleState(t)
		end
	elseif params.phase == "falling" then
		state = "falling"
	else
		state = Pose.settleState(t)
	end
	local sxz = Pose.scaleXZFor(sy)
	local bones = {}
	local lag = 0
	if params.enabled ~= false and params.phase ~= "falling" and t > 0 and t < Pose.TOTAL then
		lag = math.sin(math.pi * math.min(1, t / (Pose.COMPRESS + Pose.REBOUND)))
			* (1 - t / Pose.TOTAL)
			* math.clamp(params.strength or 0, 0, 1)
	elseif params.enabled ~= false and params.phase == "falling" then
		lag = -0.5 * (sy - 1) / (Pose.MAX_STRETCH - 1 + 1e-9)
	end
	local dent = if params.standing and state == "supporting" and params.enabled ~= false then Pose.CONTACT_DENT else 0
	local topOffset = 0
	for _, b in rig do
		local ox, oy, oz = b.x * (sxz - 1), b.y * (sy - 1), b.z * (sxz - 1)
		local rx, rz = 0, 0
		if b.secondary then
			rx = Pose.MAX_SECONDARY_RAD * lag * (b.sign or 1)
			rz = Pose.MAX_SECONDARY_RAD * lag * 0.5 * (b.sign or 1)
		else
			oy -= dent
			topOffset = math.min(topOffset, oy)
		end
		table.insert(bones, { name = b.name, offset = { ox, oy, oz }, rotation = { rx, 0, rz } })
	end
	return { scaleY = sy, scaleXZ = sxz, state = state, bones = bones, topOffset = topOffset }
end

return Pose
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">ProfileMutations</string>
            <string name="Source"><![CDATA[--!strict
-- Pure, atomic profile mutations (docs/05 §4, §9). `apply` deep-copies the profile, re-validates
-- the request against canonical config, mutates the copy and validates numeric bounds. The caller
-- (PlayerProfileRepository) commits the copy only after a durable write succeeded.
-- Debit + ownership are a single mutation: there is no state where coins left without the item.

local Config = require(script.Parent.Parent.GeneratedConfig)
local Economy = require(script.Parent.Economy)
local Rebirth = require(script.Parent.Rebirth)
local Rewards = require(script.Parent.Rewards)

local Mut = {}

Mut.SCHEMA_VERSION = Config.Runtime.profile.schema_version
-- Technical bound for integer fields (decision 0005): far above any reachable balance,
-- below 2^53 so that every value stays an exact integer in a double.
Mut.MAX_INT = 1e12
Mut.MAX_RECEIPTS_KEPT = 500

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = deepCopy(x)
	end
	return out
end
Mut.deepCopy = deepCopy

function Mut.newProfile(): any
	return {
		schemaVersion = Mut.SCHEMA_VERSION,
		revision = 0,
		coins = 0,
		xp = 0,
		permits = 0,
		rebirthCount = 0,
		ownedTools = {},
		toolRanks = {},
		ownedCosmetics = {},
		equippedLoadout = {},
		roomMastery = { totalCompleted = 0, families = {}, firstRebirthQualified = false },
		bestDepth = 0,
		tutorialFlags = {},
		checkpoint = nil,
		settings = { reducedEffects = false, language = "fr", ghostHints = true },
		purchaseLedger = { receipts = {}, receiptOrder = {}, entitlements = {} },
	}
end

local function isInt(v: any): boolean
	return type(v) == "number" and v == v and v % 1 == 0 and v >= 0 and v <= Mut.MAX_INT
end

-- Validates shape, known ids and numeric bounds. Returns (true) or (false, reason).
function Mut.validate(p: any): (boolean, string?)
	if type(p) ~= "table" then
		return false, "not_a_table"
	end
	for _, f in { "revision", "coins", "xp", "permits", "rebirthCount", "bestDepth" } do
		if not isInt(p[f]) then
			return false, "bad_int:" .. f
		end
	end
	for id, owned in p.ownedTools do
		if owned ~= true or not Economy.tool(id) then
			return false, "unknown_tool:" .. tostring(id)
		end
		local r = p.toolRanks[id] or 1
		if not isInt(r) or r < 1 or r > Config.Economy.upgrade_costs.max_rank then
			return false, "bad_rank:" .. id
		end
	end
	for id in p.toolRanks do
		if not p.ownedTools[id] then
			return false, "rank_without_tool:" .. tostring(id)
		end
	end
	for id, owned in p.ownedCosmetics do
		if owned ~= true or not Economy.cosmetic(id) then
			return false, "unknown_cosmetic:" .. tostring(id)
		end
	end
	if not isInt(p.roomMastery.totalCompleted) then
		return false, "bad_int:totalCompleted"
	end
	return true, nil
end

-- Conservative migrations: never drop coins, permits or possessions (docs/05 §9).
function Mut.migrate(raw: any): (any, { string })
	local notes = {}
	if raw == nil then
		return Mut.newProfile(), { "new_profile" }
	end
	local p = deepCopy(raw)
	local v = p.schemaVersion or 1
	if v > Mut.SCHEMA_VERSION then
		error("profile schema " .. v .. " is newer than this server (" .. Mut.SCHEMA_VERSION .. "); refusing to downgrade")
	end
	local base = Mut.newProfile()
	if v < 2 then
		-- v1 stored tools as a list and had no roomMastery
		if type(p.tools) == "table" then
			p.ownedTools = {}
			for _, id in p.tools do
				if Economy.tool(id) then
					p.ownedTools[id] = true
				else
					table.insert(notes, "dropped_unknown_tool:" .. tostring(id))
				end
			end
			p.tools = nil
		end
		table.insert(notes, "migrated_v1_to_v2")
	end
	if v < 3 then
		-- v2 had no purchase ledger and no first-rebirth qualification flag
		p.purchaseLedger = p.purchaseLedger or base.purchaseLedger
		p.roomMastery = p.roomMastery or base.roomMastery
		if p.roomMastery.firstRebirthQualified == nil then
			p.roomMastery.firstRebirthQualified = false
		end
		-- checkpoints of older rule sets cannot be resumed with new rules: extracted conservatively
		if p.checkpoint then
			table.insert(notes, "incompatible_checkpoint_extracted")
			p.checkpoint = nil
		end
		table.insert(notes, "migrated_v2_to_v3")
	end
	for k, dv in base do
		if p[k] == nil and k ~= "checkpoint" then
			p[k] = dv
		end
	end
	p.schemaVersion = Mut.SCHEMA_VERSION
	return p, notes
end

local function updateCheckpointMask(p: any, runId: string, depth: number, mask: number, paid: number)
	local cp = p.checkpoint
	if cp and cp.runId == runId and cp.depth == depth then
		cp.roomRewardMask = mask
		cp.paidBaseCumulative = paid
	end
end

local HANDLERS: { [string]: (p: any, m: any, ctx: any) -> (boolean, any) } = {}

-- Authoritative per-room claim ledger (decision 0005). The mask sent by the caller is only a hint:
-- with a yielding store, several requests can be built from the same stale mask before the first
-- write returns. Claims are therefore checked against the ledger committed in the profile itself.
local function roomLedger(p: any, runId: string, depth: number): any
	local rc = p.roomClaims
	if rc and rc.runId == runId and rc.depth == depth then
		return rc
	end
	rc = { runId = runId, depth = depth, mask = 0, paid = 0 }
	local cp = p.checkpoint
	if cp and cp.runId == runId and cp.depth == depth then
		rc.mask = cp.roomRewardMask or 0
		rc.paid = cp.paidBaseCumulative or 0
	end
	p.roomClaims = rc
	return rc
end

HANDLERS.GrantProgress = function(p, m)
	-- m: { runId, depth, index, mask (hint), rateBp, paidBaseCumulative (hint) }
	local rc = roomLedger(p, m.runId, m.depth)
	local claim = Rewards.planProgress({
		runId = m.runId,
		depth = m.depth,
		index = m.index,
		mask = bit32.bor(m.mask or 0, rc.mask),
		rateBp = m.rateBp,
		paidBaseCumulative = math.max(m.paidBaseCumulative or 0, rc.paid),
	})
	if #claim.lines == 0 then
		return false, "already_claimed"
	end
	p.coins += claim.coins
	p.permits += claim.permits
	p.xp += claim.xp
	rc.mask = claim.newMask
	rc.paid = claim.newPaidBaseCumulative
	updateCheckpointMask(p, m.runId, m.depth, claim.newMask, claim.newPaidBaseCumulative)
	return true, claim
end

HANDLERS.GrantToken = function(p, m)
	local rc = roomLedger(p, m.runId, m.depth)
	local ok, claim = Rewards.planToken(m.runId, m.depth, m.tokenIndex, bit32.bor(m.mask or 0, rc.mask))
	if not ok then
		return false, claim
	end
	p.coins += claim.coins
	rc.mask = claim.newMask
	updateCheckpointMask(p, m.runId, m.depth, claim.newMask, rc.paid)
	return true, claim
end

HANDLERS.GrantTutorial = function(p, m)
	local amount = Rewards.tutorialReward(m.rewardId)
	if amount == nil then
		return false, "unknown_reward"
	end
	if p.tutorialFlags[m.rewardId] then
		return false, "already_claimed"
	end
	p.tutorialFlags[m.rewardId] = true
	p.coins += amount
	return true, { coins = amount, rewardId = m.rewardId }
end

HANDLERS.GrantOnce = function(p, m)
	-- secondary rewards keyed per account (family discovery, contracts, weekly challenge)
	local sec = Config.Economy.secondary_rewards
	local amount
	if m.kind == "family_discovery" then
		amount = sec.first_room_family_discovery.coins
	elseif m.kind == "practice_contract" then
		amount = sec.practice_contract.coins
	elseif m.kind == "weekly_challenge" then
		amount = sec.weekly_challenge.coins
	else
		return false, "unknown_kind"
	end
	local key = m.kind .. ":" .. tostring(m.key)
	if p.tutorialFlags[key] then
		return false, "already_claimed"
	end
	p.tutorialFlags[key] = true
	p.coins += amount
	return true, { coins = amount, key = key }
end

HANDLERS.CoinPurchase = function(p, m)
	-- the plan is recomputed from the profile being mutated, never taken from the caller
	local ok, plan = Economy.planCoinPurchase(p, m.skuId)
	if not ok then
		return false, plan
	end
	if p.coins < plan.price then
		return false, "insufficient_coins"
	end
	p.coins -= plan.price
	if plan.kind == "tool" then
		p.ownedTools[plan.itemId] = true
		p.toolRanks[plan.itemId] = 1
	elseif plan.kind == "upgrade" then
		p.toolRanks[plan.itemId] = plan.newRank
	else
		p.ownedCosmetics[plan.itemId] = true
	end
	return true, plan
end

HANDLERS.Equip = function(p, m)
	local ok, plan = Economy.planEquip(p, m.itemId, m.slot)
	if not ok then
		return false, plan
	end
	p.equippedLoadout[m.slot] = plan.itemId
	return true, plan
end

HANDLERS.RoomCompleted = function(p, m)
	p.roomMastery.totalCompleted += 1
	p.roomMastery.families[m.familyId] = (p.roomMastery.families[m.familyId] or 0) + 1
	p.bestDepth = math.max(p.bestDepth, m.depth)
	if Rebirth.familiesCompleted(p) >= Config.Economy.rebirth.first_rebirth_required_completed_room_families then
		p.roomMastery.firstRebirthQualified = true -- qualification persists
	end
	return true, nil
end

HANDLERS.SetCheckpoint = function(p, m)
	p.checkpoint = deepCopy(m.checkpoint)
	return true, nil
end

HANDLERS.ClearCheckpoint = function(p)
	p.checkpoint = nil
	return true, nil
end

-- Room exit in ONE durable write: exit reward (+ any unpaid milestones), mastery, first-family
-- discovery bonus and the checkpoint of the next room. Avoids 3-4 sequential writes at the exit.
HANDLERS.CompleteRoom = function(p, m, ctx)
	local first = (p.roomMastery.families[m.familyId] or 0) == 0
	local ok, claim = HANDLERS.GrantProgress(p, {
		runId = m.runId,
		depth = m.depth,
		index = 4,
		mask = m.mask,
		rateBp = m.rateBp,
		paidBaseCumulative = m.paidBaseCumulative,
	}, ctx)
	if not ok then
		return false, claim
	end
	HANDLERS.RoomCompleted(p, { familyId = m.familyId, depth = m.depth }, ctx)
	local discovery = 0
	if first then
		local okD, d = HANDLERS.GrantOnce(p, { kind = "family_discovery", key = m.familyId }, ctx)
		if okD then
			discovery = d.coins
		end
	end
	if m.nextCheckpoint then
		p.checkpoint = deepCopy(m.nextCheckpoint)
	end
	return true, { claim = claim, familyDiscovery = discovery }
end

-- Persist the current room's tool charges (resume never refills them for the same room).
HANDLERS.UpdateCharges = function(p, m)
	local cp = p.checkpoint
	if not (cp and cp.runId == m.runId and cp.depth == m.depth) then
		return false, "no_room_checkpoint"
	end
	local snap = {}
	for toolId, c in m.charges do
		if Economy.tool(toolId) and type(c) == "number" and c >= 0 and c % 1 == 0 then
			snap[toolId] = c
		end
	end
	cp.chargesSnapshot = snap
	return true, nil
end

HANDLERS.Rebirth = function(p, m, ctx)
	local ok, preview = Rebirth.confirm(p, ctx.userKey, m, ctx.secret, m.inSas == true)
	if not ok then
		return false, preview
	end
	p.permits -= preview.cost
	p.rebirthCount += preview.quantity
	p.checkpoint = nil -- depth restarts at 1; coins, tools, ranks, cosmetics, entitlements untouched
	return true, preview
end

HANDLERS.GrantReceipt = function(p, m)
	local ledger = p.purchaseLedger
	if ledger.receipts[m.receiptId] then
		return false, "already_granted"
	end
	if m.coins then
		p.coins += m.coins
	end
	for _, ent in m.entitlements or {} do
		ledger.entitlements[ent] = true
	end
	ledger.receipts[m.receiptId] = true
	table.insert(ledger.receiptOrder, m.receiptId)
	-- bounded ledger: very old consumable receipts are forgotten (Roblox stops retrying them)
	while #ledger.receiptOrder > Mut.MAX_RECEIPTS_KEPT do
		local old = table.remove(ledger.receiptOrder, 1)
		ledger.receipts[old] = nil
	end
	return true, { coins = m.coins or 0 }
end

HANDLERS.Settings = function(p, m)
	if type(m.reducedEffects) == "boolean" then
		p.settings.reducedEffects = m.reducedEffects
	end
	if m.language == "fr" or m.language == "en" then
		p.settings.language = m.language
	end
	if type(m.ghostHints) == "boolean" then
		p.settings.ghostHints = m.ghostHints
	end
	return true, nil
end

Mut.TYPES = {}
for k in HANDLERS do
	table.insert(Mut.TYPES, k)
end
table.sort(Mut.TYPES)

-- apply(profile, mutation, ctx?) -> (true, newProfile, info) | (false, reason)
function Mut.apply(profile: any, mutation: any, ctx: any?): (boolean, any, any)
	local handler = HANDLERS[mutation.type]
	if not handler then
		return false, "unknown_mutation", nil
	end
	local p = deepCopy(profile)
	local ok, info = handler(p, mutation, ctx or {})
	if not ok then
		return false, info, nil
	end
	p.revision += 1
	local valid, why = Mut.validate(p)
	if not valid then
		return false, "invalid_result:" .. tostring(why), nil
	end
	return true, p, info
end

return Mut
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Rebirth</string>
            <string name="Source"><![CDATA[--!strict
-- Voluntary rebirth arithmetic (docs/03 §7). Permits are never purchasable; only the required
-- permits are consumed; several ranks can be converted in one transaction.

local Config = require(script.Parent.Parent.GeneratedConfig)
local Rng = require(script.Parent.Parent.Util.Rng)

local R = Config.Economy.rebirth

local Rebirth = {}

function Rebirth.costForRank(rank: number): number
	assert(rank >= 1 and rank % 1 == 0, "rank must be a positive integer")
	return math.min(R.base_cost + R.increment * (rank - 1), R.cost_cap)
end

-- Total permits to go from currentRank to currentRank + quantity.
function Rebirth.cumulativeCost(currentRank: number, quantity: number): number
	local total = 0
	for r = currentRank + 1, currentRank + quantity do
		total += Rebirth.costForRank(r)
	end
	return total
end

function Rebirth.maxAffordable(currentRank: number, permits: number): number
	local q, spent = 0, 0
	while true do
		local c = Rebirth.costForRank(currentRank + q + 1)
		if spent + c > permits then
			return q
		end
		spent += c
		q += 1
	end
end

function Rebirth.bonusFraction(rank: number): number
	return math.min(R.coin_bonus_per_rank * rank, R.coin_bonus_cap)
end

function Rebirth.familiesCompleted(profile): number
	local n = 0
	for _, count in profile.roomMastery.families do
		if count > 0 then
			n += 1
		end
	end
	return n
end

function Rebirth.qualifies(profile): (boolean, string?)
	if profile.rebirthCount == 0 and not profile.roomMastery.firstRebirthQualified then
		if Rebirth.familiesCompleted(profile) < R.first_rebirth_required_completed_room_families then
			return false, "families_required"
		end
	end
	return true, nil
end

export type Preview = {
	quantity: number,
	cost: number,
	ranksAfter: number,
	permitsAfter: number,
	bonusAfter: number,
	revision: number,
	token: string,
}

-- Token bound to player, quantity and revision. `secret` is a per-server random salt.
function Rebirth.token(userKey: string, quantity: number, revision: number, secret: string): string
	local h1 = Rng.hash(string.format("%s|%d|%d|%s", userKey, quantity, revision, secret))
	local h2 = Rng.hash(string.format("%s#%d#%d#%s", secret, revision, quantity, userKey))
	return string.format("rb%08x%08x", h1, h2)
end

function Rebirth.preview(profile, userKey: string, quantity: number, secret: string): (boolean, any)
	local ok, why = Rebirth.qualifies(profile)
	if not ok then
		return false, why
	end
	if quantity < 1 or quantity % 1 ~= 0 then
		return false, "bad_quantity"
	end
	local cost = Rebirth.cumulativeCost(profile.rebirthCount, quantity)
	if cost > profile.permits then
		return false, "insufficient_permits"
	end
	return true,
		{
			quantity = quantity,
			cost = cost,
			ranksAfter = profile.rebirthCount + quantity,
			permitsAfter = profile.permits - cost,
			bonusAfter = Rebirth.bonusFraction(profile.rebirthCount + quantity),
			revision = profile.revision,
			token = Rebirth.token(userKey, quantity, profile.revision, secret),
		} :: Preview
end

-- Server-side confirmation check. The cost is RECOMPUTED here; nothing from the client is used
-- except quantity/revision/token which must all match a fresh server computation.
function Rebirth.confirm(
	profile,
	userKey: string,
	req: { quantity: number, expectedRevision: number, previewToken: string },
	secret: string,
	inSas: boolean
): (boolean, any)
	if not inSas then
		return false, "not_in_sas"
	end
	if req.expectedRevision ~= profile.revision then
		return false, "stale_revision"
	end
	if req.previewToken ~= Rebirth.token(userKey, req.quantity, profile.revision, secret) then
		return false, "bad_preview_token"
	end
	return Rebirth.preview(profile, userKey, req.quantity, secret)
end

return Rebirth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Reward arithmetic (docs/03 §5, economy.json reward_bands / reward_rules / optional_tokens).
-- All amounts are integers. The rebirth bonus uses integer basis points and CUMULATIVE
-- half-up rounding: each base grant pays round(mult * cumulativeBase) - alreadyPaid.

local Config = require(script.Parent.Parent.GeneratedConfig)

local Econ = Config.Economy
local Rules = Econ.reward_rules
local Rounding = Rules.rounding
local XP = Config.Runtime.account_xp

local Rewards = {}

-- Room reward mask bits: milestones 1..3 -> bits 0..2, exit -> bit 3, tokens 1..6 -> bits 4..9
Rewards.MILESTONE_COUNT = 3
Rewards.EXIT_BIT = 3
Rewards.TOKEN_BIT0 = 4

local function bit(i: number): number
	return bit32.lshift(1, i)
end

function Rewards.hasBit(mask: number, i: number): boolean
	return bit32.band(mask, bit(i)) ~= 0
end

function Rewards.setBit(mask: number, i: number): number
	return bit32.bor(mask, bit(i))
end

function Rewards.bandForDepth(depth: number)
	assert(type(depth) == "number" and depth >= 1 and depth % 1 == 0, "depth must be a positive integer")
	for _, band in Econ.reward_bands do
		if depth >= band.min_depth and (band.max_depth == nil or depth <= band.max_depth) then
			return band
		end
	end
	error("no reward band for depth " .. depth)
end

function Rewards.rebirthBasisPoints(rebirthRank: number): number
	return math.min(Rounding.rebirth_bonus_basis_points_per_rank * math.max(0, rebirthRank), Rounding.rebirth_bonus_basis_points_cap)
end

-- floor((cum * (D + bp) + D/2) / D): exact half-up integer rounding
function Rewards.roundedCumulative(cumulativeBase: number, bp: number): number
	local d = Rounding.basis_point_denominator
	return math.floor((cumulativeBase * (d + bp) + d / 2) / d)
end

-- Ordered base grants of a room: { milestone1, milestone2, milestone3, exit }
function Rewards.baseSchedule(depth: number): { number }
	local band = Rewards.bandForDepth(depth)
	local list = table.clone(band.milestones)
	table.insert(list, band.exit_reward)
	return list
end

-- Index (1..4) -> bit in the room mask
local function gradeBit(index: number): number
	return if index <= Rewards.MILESTONE_COUNT then index - 1 else Rewards.EXIT_BIT
end

export type GrantLine = { rewardId: string, kind: string, amount: number, bit: number }

export type Claim = {
	lines: { GrantLine },
	coins: number,
	permits: number,
	xp: number,
	newMask: number,
	newPaidBaseCumulative: number,
}

-- Plan the grants produced when the player validly reaches milestone `index` (1..3) or the
-- exit (index 4). Reaching a higher zone implies the lower ones (zones are progressive heights,
-- a shortcut may skip landing on them). Already-claimed bits pay nothing.
-- `rateBp` is the rebirth bonus frozen at room start. `paidBaseCumulative` is what the room has
-- already paid from base grants (including bonus) so totals always match.
function Rewards.planProgress(params: {
	runId: string,
	depth: number,
	index: number,
	mask: number,
	rateBp: number,
	paidBaseCumulative: number,
}): Claim
	assert(params.index >= 1 and params.index <= 4 and params.index % 1 == 0, "bad milestone index")
	local schedule = Rewards.baseSchedule(params.depth)
	local band = Rewards.bandForDepth(params.depth)
	local mask = params.mask
	local lines = {}
	local cumulativeBase = 0
	-- cumulative base of grants already claimed (claims are always prefix-ordered)
	for i = 1, 4 do
		if Rewards.hasBit(mask, gradeBit(i)) then
			cumulativeBase += schedule[i]
		end
	end
	local paid = params.paidBaseCumulative
	local coins, permits, xp = 0, 0, 0
	for i = 1, params.index do
		local b = gradeBit(i)
		if not Rewards.hasBit(mask, b) then
			cumulativeBase += schedule[i]
			local target = Rewards.roundedCumulative(cumulativeBase, params.rateBp)
			local amount = target - paid
			paid = target
			mask = Rewards.setBit(mask, b)
			local kind = if i == 4 then "exit" else "milestone"
			table.insert(lines, {
				rewardId = string.format("%s:%d:%s", params.runId, params.depth, if i == 4 then "exit" else "m" .. i),
				kind = kind,
				amount = amount,
				bit = b,
			})
			coins += amount
			if i == 4 then
				permits += band.permits
				xp += Rewards.exitXp(params.depth)
			end
		end
	end
	return { lines = lines, coins = coins, permits = permits, xp = xp, newMask = mask, newPaidBaseCumulative = paid }
end

-- Optional tokens: 6 per room, 5 Coins each, never multiplied, never respawned.
function Rewards.planToken(runId: string, depth: number, tokenIndex: number, mask: number): (boolean, any)
	local tok = Econ.optional_tokens
	if type(tokenIndex) ~= "number" or tokenIndex % 1 ~= 0 or tokenIndex < 1 or tokenIndex > tok.tokens_per_room then
		return false, "bad_token"
	end
	local b = Rewards.TOKEN_BIT0 + tokenIndex - 1
	if Rewards.hasBit(mask, b) then
		return false, "already_claimed"
	end
	return true,
		{
			lines = {
				{ rewardId = string.format("%s:%d:t%d", runId, depth, tokenIndex), kind = "token", amount = tok.coins_per_token, bit = b },
			},
			coins = tok.coins_per_token,
			newMask = Rewards.setBit(mask, b),
		}
end

function Rewards.exitXp(depth: number): number
	local band = math.floor((depth - 1) / XP.depth_band_width)
	return XP.exit_base + XP.exit_increment_per_depth_band * math.min(band, XP.exit_increment_cap)
end

function Rewards.nextLevelCost(level: number): number
	return XP.next_level_base + XP.next_level_increment * math.min(level - 1, XP.next_level_increment_cap)
end

-- XP -> (level, xpIntoLevel). No final level.
function Rewards.levelForXp(xp: number): (number, number)
	local level = 1
	local remaining = xp
	while remaining >= Rewards.nextLevelCost(level) do
		remaining -= Rewards.nextLevelCost(level)
		level += 1
		if level > 1e6 then
			break
		end
	end
	return level, remaining
end

-- Tutorial rewards: ids and amounts from config, once per account.
function Rewards.tutorialReward(rewardId: string): number?
	for i, id in Econ.tutorial.reward_ids do
		if id == rewardId then
			return Econ.tutorial.rewards[i]
		end
	end
	return nil
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">RoomPlan</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic room planning (docs/04 §4-§13, docs/05 §6).
--   selectSpec(depth, runSeed, history, profile) -> family/format/exit for that depth
--   generate(spec, depth, seed)                  -> RoomDefinition (route graph FIRST, then dressing)
--   build(spec, depth, seed)                     -> validated room, or certified fallback + diagnostic
-- A room = an architecture shell, a protected exit ledge with its 8x8x10 clearance, a backward-
-- built chain of supports (structural pedestal + 1-2 stable props), optional mechanism props,
-- wave mouths placed outside protected corridors, 3 milestone heights and 6 optional tokens.
-- Same (spec, depth, seed) => same room on every machine (Rng is bit32-based).

local Config = require(script.Parent.Parent.GeneratedConfig)
local Box = require(script.Parent.Parent.Util.Box)
local Rng = require(script.Parent.Parent.Util.Rng)
local Jump = require(script.Parent.JumpModel)
local Difficulty = require(script.Parent.Difficulty)
local Validator = require(script.Parent.RouteValidator)

local Rooms = Config.Rooms
local Rules = Rooms.validation_rules

local Plan = {}

local FAMILIES: { [string]: any } = {}
for _, f in Rooms.families do
	FAMILIES[f.id] = f
end
Plan.FAMILIES = FAMILIES

local PROPS: { [string]: any } = {}
for _, f in Rooms.families do
	for _, p in f.props do
		PROPS[p.id] = p
	end
end
Plan.PROPS = PROPS

local EXIT_SILL_RATIO = { door = 0.35, window = 0.55, duct = 0.35, roof = nil, tailgate = 0, floor_hatch = 0 }
local LEVER_RATIO = 0.45
local CLEAR = Rules.exit_approach_clearance_studs
local MOUTH_SIZE = 8
local WALL_MARGIN = 0.5
local MAX_NODES = 48

Plan.MAX_ATTEMPTS = 12

------------------------------------------------------------------------------------------------
-- Spec selection
------------------------------------------------------------------------------------------------
function Plan.releaseProfile(name: string?)
	return Rooms.release_profiles[name or "mvp"]
end

local function inList(list: { string }, v: string): boolean
	return table.find(list, v) ~= nil
end

-- Certified combinations (filled by tools/certify_rooms.luau output when present).
local certified: { [string]: boolean }? = nil
function Plan.setCertified(map: { [string]: boolean }?)
	certified = map
end
function Plan.comboKey(family: string, format: string, exit: string): string
	return family .. "/" .. format .. "/" .. exit
end

function Plan.candidateCombos(depth: number, profileName: string?): { { family: string, format: string, exit: string } }
	local prof = Plan.releaseProfile(profileName)
	local out = {}
	for _, famId in prof.families do
		local fam = FAMILIES[famId]
		if fam.minimum_depth <= depth then
			for _, fmt in prof.formats do
				for _, ex in prof.exits do
					if inList(fam.exits, ex) then
						local key = Plan.comboKey(famId, fmt, ex)
						if certified == nil or (certified :: any)[key] then
							table.insert(out, { family = famId, format = fmt, exit = ex })
						end
					end
				end
			end
		end
	end
	return out
end

-- history: list of previous specs (most recent last)
function Plan.selectSpec(depth: number, runSeed: number, history: { any }, profileName: string?): any
	local prof = Plan.releaseProfile(profileName)
	local first = Rooms.first_rooms[depth]
	if first then
		local spec = {
			family = first.family,
			format = first.format,
			exit = first.exit,
			guestProps = first.guest_props,
			allowedBehaviors = first.allowed_behaviors,
			propVariant = nil,
			scripted = true,
		}
		if not inList(prof.families, first.family) and prof.use_first_room_substitutions and first.mvp_substitution then
			local sub = first.mvp_substitution
			spec.family, spec.format, spec.exit = sub.family, sub.format, sub.exit
			spec.propVariant = sub.prop_behavior_variant
		end
		return spec
	end
	local rng = Rng.new(Rng.derive(runSeed, "spec:" .. depth))
	local combos = Plan.candidateCombos(depth, profileName)
	assert(#combos > 0, "no certified combination available")
	local n = #history
	local last, prev = history[n], history[n - 1]
	local maxSame = Rules.maximum_identical_family_format_exit_in_a_row
	local filtered = {}
	for _, c in combos do
		local same = 0
		for k = n, math.max(1, n - maxSame + 1), -1 do
			local hk = history[k]
			if hk and hk.family == c.family and hk.format == c.format and hk.exit == c.exit then
				same += 1
			else
				break
			end
		end
		-- avoid >2 identical in a row; also avoid same family three times in a row (variety)
		local famRun = last and prev and last.family == c.family and prev.family == c.family
		if same < maxSame and not famRun then
			table.insert(filtered, c)
		end
	end
	if #filtered == 0 then
		filtered = combos
	end
	local c = rng:pick(filtered)
	local band = Difficulty.bandForDepth(depth)
	return {
		family = c.family,
		format = c.format,
		exit = c.exit,
		guestProps = nil,
		allowedBehaviors = { "stable", "bounce", "moving", "temporary" },
		propVariant = nil,
		scripted = false,
		bandId = band.id,
	}
end

------------------------------------------------------------------------------------------------
-- Geometry helpers
------------------------------------------------------------------------------------------------
local function stableProps(fam, depth: number, minTop: number?): { any }
	local out = {}
	for _, p in fam.props do
		if p.behavior == "stable" and (p.stage or 1) <= depth then
			local wt = p.collider.walkable_top
			if minTop == nil or math.min(wt[1], wt[2]) >= minTop then
				table.insert(out, p)
			end
		end
	end
	return out
end

local function sillHeight(exit: string, h: number): number
	if exit == "roof" then
		return h - 6
	end
	local ratio = EXIT_SILL_RATIO[exit] or 0.35
	if ratio == 0 then
		return 0
	end
	return math.clamp(math.floor(ratio * h + 0.5), 6, h - CLEAR[3])
end

-- Column = structural pedestal (navy architecture block) + optional lower prop + top prop.
-- Returns stack list (bottom->top) of { propId?, box, kind } and actual top, or nil.
local function buildColumn(rng, fam, depth: number, cx: number, cz: number, rotate: boolean, targetTop: number, forcedTopProp: string?)
	local tops = stableProps(fam, depth, Validator.MIN_LANDING)
	if forcedTopProp then
		tops = { PROPS[forcedTopProp] }
	end
	if #tops == 0 then
		return nil
	end
	for _ = 1, 8 do
		local top = rng:pick(tops)
		local tw, td, th = top.collider.size_studs[1], top.collider.size_studs[2], top.collider.size_studs[3]
		if rotate then
			tw, td = td, tw
		end
		local stack = {}
		local height = th
		local lower = nil
		if rng:nextNumber() < 0.45 then
			-- a lower prop whose top fully supports the upper collider footprint
			local cands = {}
			for _, p in stableProps(fam, depth, nil) do
				local lw, ld = p.collider.walkable_top[1], p.collider.walkable_top[2]
				if rotate then
					lw, ld = ld, lw
				end
				if lw >= tw and ld >= td and p.id ~= top.id then
					table.insert(cands, p)
				end
			end
			if #cands > 0 then
				lower = rng:pick(cands)
				height += lower.collider.size_studs[3]
			end
		end
		local pedestal = targetTop - height
		if pedestal < -1e-9 then
			if lower then
				lower = nil
				height = th
				pedestal = targetTop - height
			end
			if pedestal < -1e-9 then
				continue
			end
		end
		local y = 0
		local baseW, baseD = tw, td
		if lower then
			baseW, baseD = lower.collider.size_studs[1], lower.collider.size_studs[2]
			if rotate then
				baseW, baseD = baseD, baseW
			end
		end
		if pedestal > 0.05 then
			table.insert(stack, { propId = nil, kind = "pedestal", box = Box.onFloor(cx, 0, cz, baseW, pedestal, baseD) })
			y = pedestal
		else
			pedestal = 0
		end
		if lower then
			local lh = lower.collider.size_studs[3]
			table.insert(stack, { propId = lower.id, kind = "prop", box = Box.onFloor(cx, y, cz, baseW, lh, baseD) })
			y += lh
		end
		table.insert(stack, { propId = top.id, kind = "prop", box = Box.onFloor(cx, y, cz, tw, th, td) })
		y += th
		local wt = top.collider.walkable_top
		local ww, wd = wt[1], wt[2]
		if rotate then
			ww, wd = wd, ww
		end
		return {
			stack = stack,
			topY = y,
			footprint = { w = math.max(baseW, tw), d = math.max(baseD, td) },
			walkable = { w = ww, d = wd },
			topProp = top.id,
		}
	end
	return nil
end

local function footprintBox(cx: number, cz: number, w: number, d: number, top: number): any
	return Box.onFloor(cx, 0, cz, w, math.max(top, 0.01), d)
end

------------------------------------------------------------------------------------------------
-- Generation
------------------------------------------------------------------------------------------------
function Plan.generate(spec, depth: number, seed: number, attempt: number?): any
	local fam = FAMILIES[spec.family]
	assert(fam, "unknown family " .. tostring(spec.family))
	local dims = fam.formats[spec.format]
	local w, d, h = dims[1], dims[2], dims[3]
	local band = Difficulty.bandForDepth(depth)
	local ratio = band.maximum_required_gap_ratio
	local rng = Rng.new(Rng.derive(seed, string.format("layout:%s:%d", spec.family, attempt or 0)))
	local diagnostics = {}
	local nodes, edges, solids = {}, {}, {}

	local floor = {
		id = "floor",
		kind = "floor",
		box = Box.new(0, -0.5, 0, w, 1, d),
		topY = 0,
		walkable = { w = w, d = d },
		stack = {},
		arrival = "present",
		behavior = "stable",
		protected = false,
	}
	table.insert(nodes, floor)

	-- spawn: protected sas mouth on the -Z wall
	local spawn = Box.onFloor(0, 0, -d / 2 + 3.5, 8, 6, 7)

	-- exit ledge (protected pillar) + clearance + opening
	local exit = spec.exit
	local sill = sillHeight(exit, h)
	local lever = nil
	local ledgeX, ledgeZ
	local opening
	local roofCanopy = nil
	if exit == "door" or exit == "duct" then
		local wallZ = if exit == "door" then d / 2 else -d / 2
		ledgeX = rng:nextRange(-w / 2 + 6, w / 2 - 6)
		if exit == "duct" then
			ledgeX = if rng:nextNumber() < 0.5 then -w / 2 + 6 else w / 2 - 6
		end
		ledgeZ = wallZ - math.sign(wallZ) * CLEAR[2] / 2
		opening = Box.new(ledgeX, sill + CLEAR[3] / 2, wallZ, CLEAR[1], CLEAR[3], 1)
	elseif exit == "window" then
		ledgeX = w / 2 - CLEAR[1] / 2
		ledgeZ = rng:nextRange(-d / 2 + 12, d / 2 - 6)
		opening = Box.new(w / 2, sill + CLEAR[3] / 2, ledgeZ, 1, CLEAR[3], CLEAR[2])
	elseif exit == "roof" then
		ledgeX = (if rng:nextNumber() < 0.5 then -1 else 1) * (w / 2 - CLEAR[1] / 2)
		ledgeZ = d / 2 - CLEAR[2] / 2
		opening = Box.new(ledgeX, h, ledgeZ, CLEAR[1], 1, CLEAR[2])
		-- raised canopy ("auvent") over the hatch and its approach: protects jump arcs and camera
		roofCanopy = Box.new(ledgeX - math.sign(ledgeX) * 6, h, ledgeZ - 6, 20, 1, 20)
	else -- tailgate / floor_hatch: low exit opened by a high lever
		ledgeX = rng:nextRange(-w / 2 + 6, w / 2 - 6)
		ledgeZ = d / 2 - CLEAR[2] / 2
		opening = if exit == "tailgate"
			then Box.new(ledgeX, CLEAR[3] / 2, d / 2, CLEAR[1], CLEAR[3], 1)
			else Box.new(ledgeX, 0, ledgeZ, CLEAR[1], 1, CLEAR[2])
	end

	local ledge = {
		id = "exit_ledge",
		kind = "exit_ledge",
		box = footprintBox(ledgeX, ledgeZ, CLEAR[1], CLEAR[2], sill),
		topY = sill,
		walkable = { w = CLEAR[1], d = CLEAR[2] },
		stack = {},
		arrival = "present",
		behavior = "stable",
		protected = true,
	}
	table.insert(nodes, ledge)
	if sill > 0 then
		table.insert(solids, { nodeId = "exit_ledge", kind = "architecture", box = ledge.box })
	end
	local clearance = Box.onFloor(ledgeX, sill, ledgeZ, CLEAR[1], CLEAR[3], CLEAR[2])

	local exitTargetId = "exit_ledge"
	local climbTarget = ledge
	if exit == "tailgate" or exit == "floor_hatch" then
		-- lever pillar placed on the opposite half; the climb goes to the lever, then a gate edge
		local lt = math.clamp(math.floor(LEVER_RATIO * h + 0.5), 8, h - 10)
		local lx = -ledgeX
		local lz = -d / 2 + 14
		lever = {
			id = "lever",
			kind = "exit_ledge",
			box = footprintBox(lx, lz, 8, 8, lt),
			topY = lt,
			walkable = { w = 8, d = 8 },
			stack = {},
			arrival = "present",
			behavior = "stable",
			protected = true,
		}
		table.insert(nodes, lever)
		table.insert(solids, { nodeId = "lever", kind = "architecture", box = lever.box })
		climbTarget = lever
		table.insert(edges, { from = "lever", to = "exit_ledge", gap = 0, rise = -lt, kind = "gate" })
	end

	-- backward chain from the climb target down to the floor
	local maxRise = Jump.maxRequiredRise()
	local current = climbTarget
	local guestQueue = {}
	for _, g in spec.guestProps or {} do
		table.insert(guestQueue, g)
	end
	local idx = 0
	local spawnBlock = Box.expand(spawn, 2, 0, 2)
	local clearanceBlock = Box.expand(clearance, 1, 0.5, 1)
	local HEADROOM = Jump.AVATAR.height + 1.5
	local headrooms = {
		{
			nodeId = climbTarget.id,
			box = Box.onFloor(
				climbTarget.box.cx,
				climbTarget.topY,
				climbTarget.box.cz,
				climbTarget.walkable.w,
				HEADROOM,
				climbTarget.walkable.d
			),
		},
	}
	-- 3D occupancy test for a candidate support (all its solids + its own headroom)
	local function free(parts, cx: number, cz: number, topY: number, walk, isColumn: boolean): boolean
		local head = Box.onFloor(cx, topY, cz, walk.w, HEADROOM, walk.d)
		if topY + Jump.AVATAR.height + 0.5 > h and exit ~= "roof" then
			return false
		end
		for _, part in parts do
			local b = part
			if not Box.insideRoom(Box.expand(b, WALL_MARGIN, 0, WALL_MARGIN), w, d, h) then
				return false
			end
			if (isColumn and Box.overlapsXZ(b, spawnBlock)) or Box.intersects(b, Box.expand(spawn, 1, 1, 1)) then
				return false
			end
			if Box.intersects(b, clearanceBlock) then
				return false
			end
			local grown = Box.expand(b, 0.5, 0, 0.5)
			for _, s2 in solids do
				if Box.intersects(grown, s2.box) then
					return false
				end
			end
			for _, hr in headrooms do
				if Box.intersects(b, hr.box) then
					return false
				end
			end
		end
		if Box.intersects(head, clearanceBlock) then
			return false
		end
		for _, s2 in solids do
			if Box.intersects(head, s2.box) then
				return false
			end
		end
		return true
	end
	local arcBodies = {}
	local roomStub = { exitType = exit, exitOpening = opening, ceilingOpenings = if roofCanopy then { roofCanopy } else {} }
	-- incremental arc test for the hop newNode -> current (and new solids vs earlier arcs)
	local function arcOk(newNode, target, newParts): (boolean, { any }?)
		if newNode.kind == "floor" then
			return true, {}
		end
		local bodies = Validator.arcBodies(newNode, target)
		for _, body in bodies do
			if Box.top(body) > h and not Validator.underCeilingOpening(roomStub, body.cx, body.cz) then
				return false, nil
			end
			for _, s2 in solids do
				if s2.nodeId ~= target.id and Box.intersects(body, s2.box, 0.02) then
					return false, nil
				end
			end
		end
		for _, part in newParts do
			for _, ab in arcBodies do
				if ab.owner ~= target.id and Box.intersects(part, ab.box, 0.02) then
					return false, nil
				end
			end
		end
		return true, bodies
	end
	local function freeFootprint(fp): boolean
		-- optional floor props: 2D test against everything already on the floor plan
		if not Box.insideRoom(Box.expand(fp, WALL_MARGIN, 0, WALL_MARGIN), w, d, h + 100) then
			return false
		end
		if Box.overlapsXZ(fp, spawnBlock) or Box.overlapsXZ(fp, clearanceBlock) then
			return false
		end
		for _, s2 in solids do
			if Box.overlapsXZ(Box.expand(fp, 0.5, 0, 0.5), s2.box) then
				return false
			end
		end
		return true
	end
	local function shelfAt(top, targetTop: number, rotate: boolean)
		-- suspended structural shelf (1-stud slab, hung by non-colliding chains) carrying one prop
		local tw, td, th = top.collider.size_studs[1], top.collider.size_studs[2], top.collider.size_studs[3]
		if rotate then
			tw, td = td, tw
		end
		local slabTop = targetTop - th
		if slabTop < 3 then
			return nil
		end
		local wt = top.collider.walkable_top
		local ww, wd = wt[1], wt[2]
		if rotate then
			ww, wd = wd, ww
		end
		return {
			stack = {
				{ propId = nil, kind = "shelf", box = Box.onFloor(0, slabTop - 1, 0, tw + 1, 1, td + 1) },
				{ propId = top.id, kind = "prop", box = Box.onFloor(0, slabTop, 0, tw, th, td) },
			},
			topY = targetTop,
			footprint = { w = tw + 1, d = td + 1 },
			walkable = { w = ww, d = wd },
			topProp = top.id,
		}
	end
	while current.topY > maxRise + 1e-9 do
		idx += 1
		if idx > MAX_NODES then
			table.insert(diagnostics, "too_many_nodes")
			return nil, diagnostics
		end
		local placed = false
		local guest = guestQueue[1]
		for _ = 1, 40 do
			local rise = rng:nextRange(2.0, maxRise)
			local targetTop = math.max(current.topY - rise, 0)
			local rotate = rng:nextNumber() < 0.5
			local col
			local isColumn = true
			if guest == nil and targetTop > 9 and (targetTop > 12 or rng:nextNumber() < 0.65) then
				local tops = stableProps(fam, depth, Validator.MIN_LANDING)
				if #tops > 0 then
					col = shelfAt(rng:pick(tops), targetTop, rotate)
					isColumn = false
				end
			end
			if col == nil then
				isColumn = true
				col = buildColumn(rng, fam, depth, 0, 0, rotate, targetTop, guest and guest.prop_id or nil)
			end
			if col == nil then
				continue
			end
			local actualRise = current.topY - col.topY
			if actualRise > maxRise + 1e-9 or actualRise < 0.5 then
				continue
			end
			local maxGap = ratio * Jump.reach(actualRise) * 0.92
			local gap = rng:nextRange(math.min(1.0, maxGap), maxGap)
			-- try directions, preferring toward the room centre and the spawn side
			local dirs = rng:shuffle({
				{ 1, 0 },
				{ -1, 0 },
				{ 0, 1 },
				{ 0, -1 },
				{ 0.7071, 0.7071 },
				{ -0.7071, 0.7071 },
				{ 0.7071, -0.7071 },
				{ -0.7071, -0.7071 },
			})
			for _, dv in dirs do
				local cw, cd = col.walkable.w, col.walkable.d
				local curTop = Box.new(current.box.cx, current.topY, current.box.cz, current.walkable.w, 0.01, current.walkable.d)
				-- distance between centres so that the edge gap along dv equals `gap`
				local cx, cz = curTop.cx, curTop.cz
				local step = 0
				local candidate
				for _ = 1, 40 do
					step += 0.5
					cx = curTop.cx + dv[1] * step
					cz = curTop.cz + dv[2] * step
					local tb = Box.new(cx, col.topY, cz, cw, 0.01, cd)
					local gg = Box.gapXZ(tb, curTop)
					if gg >= gap then
						candidate = { cx = cx, cz = cz, gap = gg }
						break
					end
				end
				if candidate and candidate.gap <= maxGap + 1e-9 then
					local fp = footprintBox(candidate.cx, candidate.cz, col.footprint.w, col.footprint.d, col.topY)
					local parts = {}
					for _, part in col.stack do
						local b = part.box
						table.insert(parts, Box.new(b.cx + candidate.cx, b.cy, b.cz + candidate.cz, b.sx, b.sy, b.sz))
					end
					if not isColumn then
						local bottom = Box.bottom(parts[1])
						fp = Box.new(
							candidate.cx,
							(bottom + col.topY) / 2,
							candidate.cz,
							col.footprint.w,
							col.topY - bottom,
							col.footprint.d
						)
					end
					local probe = {
						id = "probe",
						kind = "column",
						box = Box.new(candidate.cx, col.topY, candidate.cz, col.walkable.w, 0.01, col.walkable.d),
						topY = col.topY,
						walkable = col.walkable,
					}
					local okArc, bodies = false, nil
					if free(parts, candidate.cx, candidate.cz, col.topY, col.walkable, isColumn) then
						okArc, bodies = arcOk(probe, current, parts)
					end
					if okArc then
						for _, b in bodies :: { any } do
							table.insert(arcBodies, { owner = current.id, box = b })
						end
						local id = string.format("n%02d", idx)
						local stack = {}
						for _, part in col.stack do
							local b = part.box
							local moved = Box.new(b.cx + candidate.cx, b.cy, b.cz + candidate.cz, b.sx, b.sy, b.sz)
							table.insert(stack, { propId = part.propId, kind = part.kind, box = moved })
							table.insert(solids, { nodeId = id, kind = part.kind, propId = part.propId, box = moved })
						end
						table.insert(headrooms, {
							nodeId = id,
							box = Box.onFloor(candidate.cx, col.topY, candidate.cz, col.walkable.w, HEADROOM, col.walkable.d),
						})
						local node = {
							id = id,
							kind = if isColumn then "column" else "shelf",
							box = fp,
							topY = col.topY,
							walkable = col.walkable,
							stack = stack,
							arrival = if guest then "wave1" else "present",
							behavior = "stable",
							protected = (current == climbTarget),
							topProp = col.topProp,
						}
						table.insert(nodes, node)
						table.insert(edges, 1, { from = id, to = current.id, gap = candidate.gap, rise = actualRise, kind = "jump" })
						current = node
						placed = true
						if guest then
							table.remove(guestQueue, 1)
						end
						break
					end
				end
			end
			if placed then
				break
			end
		end
		if not placed then
			table.insert(diagnostics, "placement_failed_at_node_" .. idx)
			return nil, diagnostics
		end
	end
	table.insert(edges, 1, { from = "floor", to = current.id, gap = 0, rise = current.topY, kind = "jump" })

	-- optional mechanism props on the floor (never on the required path)
	local allowed = spec.allowedBehaviors or { "stable" }
	local optionalCount = 0
	for _, beh in { "bounce", "moving", "temporary" } do
		if inList(allowed, beh) then
			local cands = {}
			for _, p in fam.props do
				if p.behavior == beh and (p.stage or 1) <= depth then
					table.insert(cands, p)
				end
			end
			if #cands > 0 then
				local p = rng:pick(cands)
				local sw, sd = p.collider.size_studs[1], p.collider.size_studs[2]
				local params = p.behavior_params or {}
				local sweepW, sweepD = sw, sd
				if beh == "moving" and params.axis == "width" then
					sweepW += params.travel_studs or 0
				elseif beh == "moving" and params.axis == "depth" then
					sweepD += params.travel_studs or 0
				end
				for _ = 1, 25 do
					local cx = rng:nextRange(-w / 2 + sweepW / 2 + 1, w / 2 - sweepW / 2 - 1)
					local cz = rng:nextRange(-d / 2 + sweepD / 2 + 1, d / 2 - sweepD / 2 - 1)
					local sweep = footprintBox(cx, cz, sweepW, sweepD, p.collider.size_studs[3])
					if freeFootprint(Box.expand(sweep, 1.5, 0, 1.5)) then
						optionalCount += 1
						local id = "opt" .. optionalCount
						local box = Box.onFloor(cx, 0, cz, sw, p.collider.size_studs[3], sd)
						table.insert(nodes, {
							id = id,
							kind = "column",
							box = box,
							topY = Box.top(box),
							walkable = { w = p.collider.walkable_top[1], d = p.collider.walkable_top[2] },
							stack = { { propId = p.id, kind = "prop", box = box } },
							arrival = "present",
							behavior = beh,
							protected = false,
							optional = true,
							sweep = sweep,
							behaviorParams = params,
						})
						table.insert(solids, { nodeId = id, kind = "optional", propId = p.id, box = sweep })
						break
					end
				end
			end
		end
	end

	-- wave mouths (ceiling chutes): outside exit clearance, protected supports and spawn
	local mouths = {}
	local protectedNodes = {}
	for _, n in nodes do
		if n.protected then
			table.insert(protectedNodes, n)
		end
	end
	for _ = 1, band.mouths do
		local ok = false
		for _ = 1, 200 do
			local mx = rng:nextRange(-w / 2 + MOUTH_SIZE / 2 + 1, w / 2 - MOUTH_SIZE / 2 - 1)
			local mz = rng:nextRange(-d / 2 + MOUTH_SIZE / 2 + 1, d / 2 - MOUTH_SIZE / 2 - 1)
			local m = Box.new(mx, h - 0.5, mz, MOUTH_SIZE, 1, MOUTH_SIZE)
			local corridor = Box.expand(m, 1, 0, 1)
			local bad = Box.overlapsXZ(corridor, clearance) or Box.overlapsXZ(Box.expand(corridor, 2, 0, 2), spawn)
			for _, n in protectedNodes do
				bad = bad or Box.overlapsXZ(corridor, n.box)
			end
			for _, other in mouths do
				bad = bad or Box.overlapsXZ(Box.expand(corridor, 2, 0, 2), other)
			end
			if not bad then
				table.insert(mouths, m)
				ok = true
				break
			end
		end
		if not ok then
			table.insert(diagnostics, "mouth_placement_failed")
			return nil, diagnostics
		end
	end

	-- milestones: progressive zones between floor and climb target
	local milestoneHeights = { climbTarget.topY * 0.25, climbTarget.topY * 0.5, climbTarget.topY * 0.75 }

	-- optional tokens (6): above route node tops, then on the floor near the route
	local tokens = {}
	local tokenCount = Config.Economy.optional_tokens.tokens_per_room
	local routeNodes = {}
	for _, n in nodes do
		if (n.kind == "column" or n.kind == "shelf") and not n.optional then
			table.insert(routeNodes, n)
		end
	end
	for i = 1, tokenCount do
		local n = routeNodes[((i - 1) % math.max(1, #routeNodes)) + 1]
		if n and i <= #routeNodes then
			table.insert(
				tokens,
				{ id = i, x = n.box.cx + rng:nextRange(-1.5, 1.5), y = n.topY + 2.5, z = n.box.cz + rng:nextRange(-1.5, 1.5) }
			)
		else
			local x = rng:nextRange(-w / 2 + 3, w / 2 - 3)
			local z = rng:nextRange(-d / 2 + 10, d / 2 - 3)
			table.insert(tokens, { id = i, x = x, y = 2.5, z = z })
		end
	end

	local templateId = string.format("%s_%s_%s", spec.family, spec.format, exit)
	return {
		templateId = templateId,
		familyId = spec.family,
		formatId = spec.format,
		exitType = exit,
		seed = seed,
		depth = depth,
		size = { w = w, d = d, h = h },
		routeGraph = { nodes = nodes, edges = edges },
		solids = solids,
		spawnZones = { spawn },
		safeZones = { spawn, clearance },
		exitClearance = clearance,
		exitOpening = opening,
		exitTargetId = exitTargetId,
		leverId = lever and lever.id or nil,
		waveMouths = mouths,
		ceilingOpenings = if roofCanopy then { roofCanopy } else {},
		collisionBudget = {
			dynamic = Config.Runtime.streaming.max_dynamic_objects,
			static = Rules.maximum_static_colliders_active_room,
			decor = Rules.maximum_decorative_blocks_active_room,
		},
		themeManifestId = "theme_" .. spec.family,
		tokens = tokens,
		milestoneHeights = milestoneHeights,
		fallback = false,
		diagnostics = diagnostics,
		bandId = band.id,
		gapRatio = ratio,
		propVariant = spec.propVariant,
	},
		diagnostics
end

-- Certified fallback: a straight staircase of structural shelves along the -X wall toward the
-- exit, built so every hop is a 4-stud rise with a 1-stud gap. Used when random layouts fail.
function Plan.fallback(spec, depth: number, seed: number): any
	local fbSpec = table.clone(spec)
	fbSpec.guestProps = nil
	fbSpec.allowedBehaviors = { "stable" }
	-- deterministic attempt index far from normal attempts; layout with smaller rises/gaps
	for attempt = 100, 140 do
		local room = Plan.generate(fbSpec, depth, seed, attempt)
		if room then
			local ok = Validator.validate(room, { gapRatio = room.gapRatio })
			if ok then
				room.fallback = true
				return room
			end
		end
	end
	return nil
end

-- Validated room or certified fallback, with diagnostics. Never returns an unvalidated room.
function Plan.build(spec, depth: number, seed: number): (any, { string })
	local diags = {}
	for attempt = 0, Plan.MAX_ATTEMPTS - 1 do
		local room, d = Plan.generate(spec, depth, seed, attempt)
		if room then
			local ok, report = Validator.validate(room, { gapRatio = room.gapRatio })
			if ok then
				room.attempt = attempt
				return room, diags
			end
			table.insert(diags, string.format("attempt %d rejected: %s", attempt, table.concat(report.errors, ",")))
		else
			table.insert(diags, string.format("attempt %d failed: %s", attempt, table.concat(d or {}, ",")))
		end
	end
	local fb = Plan.fallback(spec, depth, seed)
	table.insert(diags, "fallback_used")
	return fb, diags
end

------------------------------------------------------------------------------------------------
-- Tutorial cell (24 x 24 x 16): falling carton then a step to an exit at 8 studs.
------------------------------------------------------------------------------------------------
function Plan.tutorialCell(): any
	local w, d, h = 24, 24, 16
	local carton = PROPS.reception_carton
	local cs = carton.collider.size_studs
	local nodes, solids = {}, {}
	table.insert(nodes, {
		id = "floor",
		kind = "floor",
		box = Box.new(0, -0.5, 0, w, 1, d),
		topY = 0,
		walkable = { w = w, d = d },
		stack = {},
		arrival = "present",
		behavior = "stable",
		protected = false,
	})
	-- carton 10 x 8 x 4 centred at z = 0: 1 stud clear of the spawn sas (z <= -5), touching the
	-- 8-stud exit ledge (z >= 4) so the second step is a plain 4-stud rise
	local cbox = Box.onFloor(0, 0, 0, cs[1], cs[3], cs[2])
	table.insert(nodes, {
		id = "carton",
		kind = "column",
		box = cbox,
		topY = Box.top(cbox),
		walkable = { w = cs[1], d = cs[2] },
		stack = { { propId = carton.id, kind = "prop", box = cbox } },
		arrival = "wave1",
		behavior = "stable",
		protected = true,
		topProp = carton.id,
	})
	table.insert(solids, { nodeId = "carton", kind = "prop", propId = carton.id, box = cbox })
	local lz = d / 2 - CLEAR[2] / 2
	local ledgeBox = Box.onFloor(0, 0, lz, CLEAR[1], 8, CLEAR[2])
	table.insert(nodes, {
		id = "exit_ledge",
		kind = "exit_ledge",
		box = ledgeBox,
		topY = 8,
		walkable = { w = CLEAR[1], d = CLEAR[2] },
		stack = {},
		arrival = "present",
		behavior = "stable",
		protected = true,
	})
	table.insert(solids, { nodeId = "exit_ledge", kind = "architecture", box = ledgeBox })
	-- clearance above the 8-stud sill would exceed a 16-stud ceiling: the tutorial door opening
	-- is cut through the wall and the ceiling above the ledge is open (skylight), see decision 0006.
	local clearance = Box.onFloor(0, 8, lz, CLEAR[1], CLEAR[3], CLEAR[2])
	return {
		templateId = "tutorial_cell",
		familyId = "reception",
		formatId = "T",
		exitType = "door",
		seed = 0,
		depth = 0,
		size = { w = w, d = d, h = h },
		routeGraph = {
			nodes = nodes,
			edges = {
				{ from = "floor", to = "carton", gap = 0, rise = 4, kind = "jump" },
				{ from = "carton", to = "exit_ledge", gap = Box.gapXZ(cbox, ledgeBox), rise = 4, kind = "jump" },
			},
		},
		solids = solids,
		spawnZones = { Box.onFloor(0, 0, -d / 2 + 3.5, 8, 6, 7) },
		safeZones = {},
		exitClearance = clearance,
		exitOpening = Box.new(0, 13, d / 2, CLEAR[1], CLEAR[3], 1),
		exitTargetId = "exit_ledge",
		-- no fill waves in the tutorial cell: the carton is a scripted structural drop (0-3 s)
		waveMouths = {},
		structuralDrops = { { nodeId = "carton", propId = carton.id, atSeconds = 0.5 } },
		collisionBudget = { dynamic = 40, static = 120, decor = 80 },
		themeManifestId = "theme_reception",
		tokens = {},
		milestoneHeights = { 2, 4, 6 },
		fallback = false,
		diagnostics = {},
		gapRatio = 0.65,
		-- skylight over the carton and the exit ledge: a full jump never bumps the 16-stud ceiling
		ceilingOpenings = { Box.new(0, h, 3, 12, 1, 18) },
	}
end

return Plan
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">RoomResidency</string>
            <string name="Source"><![CDATA[--!strict
-- Resident room modules bookkeeping (docs/05 §10): at most 3 modules (active room, preloaded
-- next room, transition sas). Only the active room simulates waves. The previous room is released
-- as soon as the transition is committed. Coordinates are recycled from fixed local cells.

local Config = require(script.Parent.Parent.GeneratedConfig)

local MAX = Config.Runtime.streaming.max_resident_room_modules

local R = {}

export type Residency = {
	sas: string?,
	active: string?,
	next: string?,
	simulating: string?,
	released: { string },
	peak: number,
	cells: { [string]: number },
}

function R.new(): Residency
	return { sas = nil, active = nil, next = nil, simulating = nil, released = {}, peak = 0, cells = {} }
end

local function count(r: Residency): number
	local n = 0
	for _, v in { r.sas, r.active, r.next } do
		if v then
			n += 1
		end
	end
	return n
end
R.count = count

local function bump(r: Residency)
	r.peak = math.max(r.peak, count(r))
	assert(count(r) <= MAX, "resident module budget exceeded")
end

-- Two fixed cells alternate for rooms; the sas has its own cell.
local function freeCell(r: Residency): number
	local used = {}
	for _, cell in r.cells do
		used[cell] = true
	end
	return if used[1] then 2 else 1
end

function R.activate(r: Residency, roomId: string)
	assert(r.active == nil, "a room is already active")
	r.active = roomId
	r.cells[roomId] = r.cells[roomId] or freeCell(r)
	r.simulating = roomId
	bump(r)
end

function R.preloadNext(r: Residency, roomId: string): boolean
	if r.next ~= nil then
		return false
	end
	r.next = roomId
	r.cells[roomId] = freeCell(r)
	bump(r)
	return true
end

-- Player reached the exit: waves of the old room stop, the player stands in the sas.
function R.enterSas(r: Residency, sasId: string)
	r.sas = sasId
	r.simulating = nil
	bump(r)
end

-- Commit: release the previous active room, the preloaded room becomes active, sas released
-- once the player stepped in. Returns the released room id.
function R.commit(r: Residency): string?
	assert(r.next ~= nil, "next room not ready: player stays in the safe sas")
	local old = r.active
	if old then
		table.insert(r.released, old)
		r.cells[old] = nil
		if #r.released > 8 then
			table.remove(r.released, 1)
		end
	end
	r.active = r.next
	r.next = nil
	r.sas = nil
	r.simulating = r.active
	return old
end

return R
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">RouteValidator</string>
            <string name="Source"><![CDATA[--!strict
-- Route validator (docs/05 §6, rooms.json validation_rules). Validates a RoomDefinition produced
-- by RoomPlan BEFORE it can be shown to a player:
--   connection entry -> exit, landing size, head clearance, jump arcs free of solids, ceiling,
--   exit clearance 8x8x10 free of solids and of every wave drop corridor, protected last support,
--   spawn never targeted by a mouth, collider budget, solids inside the room.
-- Purely geometric: it certifies the guaranteed route at structural arrival, not invulnerability.

local Config = require(script.Parent.Parent.GeneratedConfig)
local Box = require(script.Parent.Parent.Util.Box)
local Jump = require(script.Parent.JumpModel)

local Rules = Config.Rooms.validation_rules

local V = {}

V.MIN_LANDING = Rules.minimum_required_landing_short_side_studs
V.MAX_STATIC = Rules.maximum_static_colliders_active_room
V.CLEARANCE = Rules.exit_approach_clearance_studs -- {w, d, h}

local function nodeById(room): { [string]: any }
	local map = {}
	for _, n in room.routeGraph.nodes do
		map[n.id] = n
	end
	return map
end

local function topBox(n): any
	return Box.new(n.box.cx, n.topY, n.box.cz, n.walkable.w, 0.01, n.walkable.d)
end

-- point on `a` footprint closest to `b` center (take-off / landing points)
local function closestPoint(a, b): (number, number)
	local hx, hz = a.sx / 2, a.sz / 2
	local x = math.clamp(b.cx, a.cx - hx, a.cx + hx)
	local z = math.clamp(b.cz, a.cz - hz, a.cz + hz)
	return x, z
end

local function isOwn(solid, n1, n2): boolean
	return solid.nodeId ~= nil and (solid.nodeId == n1.id or solid.nodeId == n2.id)
end

-- Ceiling checks are waived only below explicit openings (roof hatch, skylights).
local function underHatch(room, x: number, z: number): boolean
	for _, o in room.ceilingOpenings or {} do
		if math.abs(x - o.cx) * 2 <= o.sx and math.abs(z - o.cz) * 2 <= o.sz then
			return true
		end
	end
	if room.exitType ~= "roof" then
		return false
	end
	local o = room.exitOpening
	return math.abs(x - o.cx) * 2 <= o.sx and math.abs(z - o.cz) * 2 <= o.sz
end

-- Avatar body boxes sampled along the hop a -> b (feet on the arc), excluding take-off sample.
function V.arcBodies(a, b): { any }
	local ta = topBox(a)
	local tb = topBox(b)
	local x0, z0 = closestPoint(ta, tb)
	local x1, z1 = closestPoint(tb, ta)
	local dx, dz = tb.cx - x1, tb.cz - z1
	local len = math.sqrt(dx * dx + dz * dz)
	if len > 1e-6 then
		x1 += dx / len * math.min(1, len)
		z1 += dz / len * math.min(1, len)
	end
	local bodies = {}
	for i, pt in Jump.arc(x0, a.topY, z0, x1, b.topY, z1, 20) do
		if i > 1 then
			table.insert(bodies, Box.onFloor(pt[1], pt[2] + 0.05, pt[3], Jump.AVATAR.width, Jump.AVATAR.height, Jump.AVATAR.depth))
		end
	end
	return bodies
end

function V.underCeilingOpening(room, x: number, z: number): boolean
	return underHatch(room, x, z)
end

function V.validate(room, opts: { gapRatio: number }): (boolean, { errors: { string }, checks: { [string]: number } })
	local errors: { string } = {}
	local checks: { [string]: number } = {}
	local function fail(msg: string)
		table.insert(errors, msg)
	end
	local function count(k: string)
		checks[k] = (checks[k] or 0) + 1
	end
	local w, d, h = room.size.w, room.size.d, room.size.h
	local nodes = nodeById(room)
	local solids = room.solids

	-- 1. solids inside the room, no interpenetration between different nodes
	for i, s in solids do
		if not Box.insideRoom(s.box, w, d, h, 1e-6) then
			fail("solid_outside_room:" .. tostring(s.nodeId or i))
		end
		-- the player must never appear inside (or under) a support or a structural drop
		for _, sz in room.spawnZones do
			if Box.intersects(s.box, sz, 0.01) then
				fail("spawn_obstructed:" .. tostring(s.nodeId or i))
			end
		end
		for j = i + 1, #solids do
			local o = solids[j]
			if Box.intersects(s.box, o.box, 0.01) then
				fail(string.format("solids_overlap:%s/%s", tostring(s.nodeId or i), tostring(o.nodeId or j)))
			end
		end
		count("solids")
	end
	if #solids + 6 > V.MAX_STATIC then
		fail("static_collider_budget")
	end

	-- 2. connectivity along required edges from floor to the exit target
	local adj: { [string]: { any } } = {}
	for _, e in room.routeGraph.edges do
		adj[e.from] = adj[e.from] or {}
		table.insert(adj[e.from], e)
	end
	local target = room.exitTargetId
	local seen = { floor = true }
	local queue = { "floor" }
	local reachedLever = room.leverId == nil
	while #queue > 0 do
		local id = table.remove(queue, 1)
		for _, e in adj[id] or {} do
			if not seen[e.to] then
				seen[e.to] = true
				table.insert(queue, e.to)
			end
		end
	end
	if not seen[target] then
		fail("exit_unreachable")
	end
	if room.leverId and not seen[room.leverId] then
		fail("lever_unreachable")
	end
	if room.leverId then
		reachedLever = seen[room.leverId] == true
	end
	checks.leverReached = reachedLever and 1 or 0

	-- 3. each required edge: hop feasibility, landing size, head clearance, arc
	for _, e in room.routeGraph.edges do
		local a, b = nodes[e.from], nodes[e.to]
		if not a or not b then
			fail("edge_unknown_node:" .. e.from .. "->" .. e.to)
			continue
		end
		local rise = b.topY - a.topY
		local gap = if a.kind == "floor" then 0 else Box.gapXZ(topBox(a), topBox(b))
		if e.kind == "jump" then
			if not Jump.requiredHopOk(gap, rise, opts.gapRatio) then
				fail(string.format("hop_infeasible:%s->%s gap=%.2f rise=%.2f", a.id, b.id, gap, rise))
			end
			count("hops")
		elseif e.kind == "gate" then
			-- lever opens a low exit; walking/dropping down to it must be safe and short
			if rise > 0.5 then
				fail("gate_requires_climb:" .. b.id)
			end
		end
		if b.kind ~= "floor" and math.min(b.walkable.w, b.walkable.d) < V.MIN_LANDING - 1e-9 then
			fail("landing_too_small:" .. b.id)
		end
		-- head clearance above landing centre (avatar + margin)
		local head = Box.onFloor(b.box.cx, b.topY + 0.02, b.box.cz, Jump.AVATAR.width + 1, Jump.AVATAR.height + 0.5, Jump.AVATAR.width + 1)
		for _, s in solids do
			if s.nodeId ~= b.id and Box.intersects(head, s.box, 0.01) then
				fail("head_clearance:" .. b.id)
				break
			end
		end
		if b.topY + Jump.AVATAR.height + 0.5 > h and not underHatch(room, b.box.cx, b.box.cz) then
			fail("ceiling_over_landing:" .. b.id)
		end
		-- arc obstruction (jump edges only)
		if e.kind == "jump" and a.kind ~= "floor" then
			local blocked = false
			for _, body in V.arcBodies(a, b) do
				for _, s in solids do
					if not isOwn(s, a, b) and Box.intersects(body, s.box, 0.02) then
						fail(string.format("arc_blocked:%s->%s by %s", a.id, b.id, tostring(s.nodeId)))
						blocked = true
						break
					end
				end
				if Box.top(body) > h and not underHatch(room, body.cx, body.cz) then
					fail(string.format("arc_hits_ceiling:%s->%s", a.id, b.id))
					blocked = true
				end
				if blocked then
					break
				end
			end
			count("arcs")
		end
	end

	-- 4. exit clearance volume: free of solids and of drop corridors
	local clr = room.exitClearance
	if math.abs(clr.sx - V.CLEARANCE[1]) > 1e-6 or math.abs(clr.sz - V.CLEARANCE[2]) > 1e-6 or math.abs(clr.sy - V.CLEARANCE[3]) > 1e-6 then
		fail("exit_clearance_size")
	end
	for _, s in solids do
		if Box.intersects(clr, s.box, 0.01) then
			fail("exit_clearance_obstructed:" .. tostring(s.nodeId))
		end
	end
	local protectedBoxes = {}
	for _, n in room.routeGraph.nodes do
		if n.protected then
			table.insert(protectedBoxes, n)
		end
	end
	for mi, m in room.waveMouths do
		local corridor = Box.new(m.cx, h / 2, m.cz, m.sx + 2, h * 2, m.sz + 2)
		if Box.overlapsXZ(corridor, clr) then
			fail("mouth_over_exit_clearance:" .. mi)
		end
		for _, n in protectedBoxes do
			if Box.overlapsXZ(corridor, n.box) then
				fail(string.format("mouth_over_protected:%d/%s", mi, n.id))
			end
		end
		for _, sz in room.spawnZones do
			if Box.overlapsXZ(Box.expand(corridor, 2, 0, 2), sz) then
				fail("mouth_over_spawn:" .. mi)
			end
		end
		count("mouths")
	end

	-- 5. last support before the exit target must be protected
	for _, e in room.routeGraph.edges do
		if e.to == target then
			local last = nodes[e.from]
			if last and last.kind ~= "floor" and not last.protected then
				fail("last_support_not_protected:" .. last.id)
			end
		end
	end
	if not (nodes[target] and nodes[target].protected) then
		fail("exit_target_not_protected")
	end

	return #errors == 0, { errors = errors, checks = checks }
end

return V
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">ToolRules</string>
            <string name="Source"><![CDATA[--!strict
-- Server-side tool validation (docs/03 §4, docs/05 §5). The client only sends an intent; every
-- check below uses server-known state: possession, equipment slot, charges, cooldown measured in
-- active simulation seconds, range, target eligibility and room state. A refused use never
-- consumes a charge. Charges refill for free when a NEW room instance starts; reloading the same
-- room instance (reconnect) keeps the charge snapshot.

local Config = require(script.Parent.Parent.GeneratedConfig)
local Economy = require(script.Parent.Economy)

local Tools = {}

export type ToolState = {
	roomInstanceId: string,
	charges: { [string]: number },
	cooldownUntil: { [string]: number },
	activeUntil: { [string]: number },
	balise: { x: number, y: number, z: number }?,
	baliseUsed: boolean,
}

function Tools.newState(): ToolState
	return { roomInstanceId = "", charges = {}, cooldownUntil = {}, activeUntil = {}, balise = nil, baliseUsed = false }
end

-- Refill for a new room instance; same instance (reconnect) => unchanged.
function Tools.enterRoom(state: ToolState, profile, roomInstanceId: string, snapshot: { [string]: number }?): ToolState
	if state.roomInstanceId == roomInstanceId then
		return state
	end
	local s = Tools.newState()
	s.roomInstanceId = roomInstanceId
	for toolId in profile.ownedTools do
		local stats = Economy.toolStats(toolId, profile.toolRanks[toolId] or 1)
		s.charges[toolId] = stats.charges_per_room
	end
	if snapshot then
		for toolId, c in snapshot do
			if s.charges[toolId] ~= nil then
				s.charges[toolId] = math.min(s.charges[toolId], c)
			end
		end
	end
	return s
end

export type UseContext = {
	profile: any,
	roomState: string, -- ExpeditionStateMachine phase
	inSas: boolean,
	now: number, -- active simulation seconds
	player: { x: number, y: number, z: number, vy: number, grounded: boolean },
	target: any?, -- server-resolved target or nil
}

local function dist(a, b): number
	local dx, dy, dz = a.x - b.x, a.y - b.y, a.z - b.z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- Returns (true, effect) or (false, reason). Does not mutate state; call Tools.commit on success.
function Tools.check(state: ToolState, toolId: string, ctx: UseContext): (boolean, any)
	local tool = Economy.tool(toolId)
	if not tool then
		return false, "unknown_tool"
	end
	local p = ctx.profile
	if not p.ownedTools[toolId] then
		return false, "not_owned"
	end
	if tool.slot ~= "active" then
		return false, "passive_tool"
	end
	if p.equippedLoadout.active ~= toolId then
		return false, "not_equipped"
	end
	if ctx.roomState ~= "Active" or ctx.inSas then
		return false, "not_in_active_room"
	end
	if not Economy.IMPLEMENTED_TOOLS[toolId] then
		return false, "unavailable"
	end
	local rank = p.toolRanks[toolId] or 1
	local stats = Economy.toolStats(toolId, rank)
	if (state.charges[toolId] or 0) <= 0 then
		return false, "no_charges"
	end
	if ctx.now < (state.cooldownUntil[toolId] or -math.huge) then
		return false, "cooldown"
	end
	local effect = { toolId = toolId, rank = rank, duration = stats.duration_seconds, stats = stats }
	if toolId == "radar_pop" then
		effect.kind = "highlight"
	elseif toolId == "ventouse_chantier" then
		local t = ctx.target
		if not t then
			return false, "no_target"
		end
		if not t.stabilizable or t.structural or t.isExit or t.protectedRoute then
			return false, "invalid_target"
		end
		if (t.sizeClass or 99) > stats.max_target_size_class then
			return false, "target_too_large"
		end
		if t.buried then
			return false, "target_covered"
		end
		if dist(ctx.player, t) > stats.range_studs then
			return false, "out_of_range"
		end
		effect.kind = "stabilize"
		effect.targetId = t.id
	elseif toolId == "parapluie_bonbon" then
		if ctx.player.grounded or ctx.player.vy >= -1 then
			return false, "not_descending"
		end
		effect.kind = "glide"
		effect.descentMultiplier = stats.descent_speed_multiplier
	else
		return false, "unavailable"
	end
	return true, effect
end

function Tools.commit(state: ToolState, effect, now: number): ToolState
	local s = table.clone(state)
	s.charges = table.clone(state.charges)
	s.cooldownUntil = table.clone(state.cooldownUntil)
	s.activeUntil = table.clone(state.activeUntil)
	s.charges[effect.toolId] -= 1
	s.cooldownUntil[effect.toolId] = now + effect.stats.cooldown_seconds
	s.activeUntil[effect.toolId] = now + effect.duration
	return s
end

-- Radar: up to max_targets usable surfaces within range, nearest first. Usable = settled,
-- anchored, head clearance free, not buried. Information only: it never moves the avatar.
function Tools.radarTargets(player, candidates: { any }, stats): { any }
	local list = {}
	for _, c in candidates do
		if c.usable and not c.buried then
			local dd = dist(player, c)
			if dd <= stats.range_studs then
				table.insert(list, { id = c.id, d = dd })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.d < b.d or (a.d == b.d and a.id < b.id)
	end)
	local out = {}
	for i = 1, math.min(stats.max_targets, #list) do
		table.insert(out, list[i].id)
	end
	return out
end

-- Magnet (passive): tokens within range that exist and are unclaimed. It never creates tokens.
function Tools.magnetPull(profile, player, tokens: { any }, claimedMask: number, tokenBit0: number): { number }
	if profile.equippedLoadout.passive ~= "aimant_poche" or not profile.ownedTools.aimant_poche then
		return {}
	end
	local stats = Economy.toolStats("aimant_poche", profile.toolRanks.aimant_poche or 1)
	local out = {}
	for _, t in tokens do
		local claimed = bit32.band(claimedMask, bit32.lshift(1, tokenBit0 + t.id - 1)) ~= 0
		if not claimed and dist(player, t) <= stats.range_studs and #out < stats.max_tokens_per_room then
			table.insert(out, t.id)
		end
	end
	return out
end

-- Equipment limits from config: 1 active + 1 passive + 1 companion (cosmetic, no power).
function Tools.loadoutPowers(profile): number
	local n = 0
	for _, slot in { "active", "passive" } do
		if profile.equippedLoadout[slot] then
			n += 1
		end
	end
	return n
end
Tools.MAX_POWERS = Config.Economy.equipment_limits.active + Config.Economy.equipment_limits.passive

return Tools
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--!strict
-- First-session flow (docs/01 "Les trente premières secondes", economy.tutorial).
-- Event driven: there is NO deadline. Times are only recorded (from "controllable") to measure the
-- 10 s comprehension / 30 s first-acquisition UX targets. Rewards are granted once per account
-- through ProfileMutations.GrantTutorial; this module only decides WHICH reward an event earns.

local Config = require(script.Parent.Parent.GeneratedConfig)

local T = Config.Economy.tutorial

local Tutorial = {}

Tutorial.REWARD_IDS = T.reward_ids -- { discovery, first_landing, exit }
Tutorial.FIRST_TOOL = T.first_tool_id
Tutorial.GHOST_HINT_AFTER_IDLE = 5
Tutorial.KIOSK_BUTTONS = { "buy", "continue" } -- no timer, no Robux

export type Session = {
	controllableAt: number?,
	events: { { name: string, t: number } },
	lastInputAt: number,
	hintShown: boolean,
}

function Tutorial.newSession(): Session
	return { controllableAt = nil, events = {}, lastInputAt = 0, hintShown = false }
end

local EVENT_REWARD = {
	carton_settled = T.reward_ids[1],
	landed_on_support = T.reward_ids[2],
	exit_reached = T.reward_ids[3],
}

-- Returns the reward id earned by `event` given the account flags, or nil.
function Tutorial.rewardFor(event: string, flags: { [string]: boolean }): string?
	local id = EVENT_REWARD[event]
	if id and not flags[id] then
		return id
	end
	return nil
end

function Tutorial.isComplete(flags: { [string]: boolean }): boolean
	return flags[T.reward_ids[3]] == true
end

function Tutorial.record(s: Session, name: string, now: number)
	if name == "controllable" and s.controllableAt == nil then
		s.controllableAt = now
	end
	if name == "input" then
		-- called every frame while the player moves: only the timestamp is kept (bounded memory)
		s.lastInputAt = now
		return
	end
	table.insert(s.events, { name = name, t = now })
end

-- Ghost trajectory hint after 5 s of inaction: shows a path, never moves the avatar.
function Tutorial.shouldShowGhostHint(s: Session, now: number, flags): boolean
	if s.controllableAt == nil or Tutorial.isComplete(flags) or s.hintShown then
		return false
	end
	local idleSince = math.max(s.lastInputAt, s.controllableAt :: number)
	return now - idleSince >= Tutorial.GHOST_HINT_AFTER_IDLE
end

-- UX measurement relative to controllable time (nil when the milestone did not happen).
function Tutorial.metrics(s: Session): { [string]: number }
	local out = {}
	if s.controllableAt == nil then
		return out
	end
	for _, e in s.events do
		if out[e.name] == nil then
			out[e.name] = e.t - (s.controllableAt :: number)
		end
	end
	return out
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">WaveSchedule</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic, time-driven wave schedule (docs/05 §7, rooms.json difficulty_bands).
-- Waves keep coming while the player is in the room. Their timing is a function of SIMULATION
-- seconds (never of rendered frames) and of the wave index; nothing here can decide a KO.

local Config = require(script.Parent.Parent.GeneratedConfig)
local Rng = require(script.Parent.Parent.Util.Rng)
local Difficulty = require(script.Parent.Difficulty)

local Wave = {}

local SPAWN_GRACE = Config.Runtime.safety.spawn_invulnerability_seconds

local function fillProps(family, depth: number): { any }
	local out = {}
	for _, p in family.props do
		if (p.behavior == "stable" or p.behavior == "bounce") and (p.stage or 1) <= depth then
			table.insert(out, p)
		end
	end
	return out
end

export type Drop = { propId: string, x: number, z: number, yaw: number, structural: boolean, nodeId: string? }
export type WaveInfo = { index: number, warningTime: number, impactTime: number, mouthIndex: number, drops: { Drop } }

export type Schedule = {
	room: any,
	band: any,
	seed: number,
	firstImpact: number,
	props: { any },
	structural: { any },
}

function Wave.new(room, family, depth: number): Schedule
	local band = Difficulty.bandForDepth(math.max(depth, 1))
	local structural = {}
	for _, n in room.routeGraph.nodes do
		if n.arrival == "wave1" then
			table.insert(structural, n)
		end
	end
	return {
		room = room,
		band = band,
		seed = Rng.derive(room.seed, "waves:" .. room.templateId),
		-- the first impact never lands before the spawn grace and its own warning
		firstImpact = math.max(SPAWN_GRACE + band.warning_seconds, band.wave_interval_seconds * 0.5),
		props = fillProps(family, math.max(depth, 1)),
		structural = structural,
	}
end

function Wave.impactTime(s: Schedule, index: number): number
	return s.firstImpact + (index - 1) * s.band.wave_interval_seconds
end

function Wave.at(s: Schedule, index: number): WaveInfo
	assert(index >= 1 and index % 1 == 0, "wave index must be a positive integer")
	local band = s.band
	local mouths = s.room.waveMouths
	local mouthIndex = if #mouths > 0 then ((index - 1) % math.min(band.mouths, #mouths)) + 1 else 0
	local impact = Wave.impactTime(s, index)
	local rng = Rng.new(Rng.derive(s.seed, "wave:" .. index))
	local drops: { Drop } = {}
	local count = band.physical_objects_per_wave
	if index == 1 then
		for _, n in s.structural do
			-- guest / structural support replaces a standard drop and counts toward the budget
			table.insert(drops, { propId = n.topProp, x = n.box.cx, z = n.box.cz, yaw = 0, structural = true, nodeId = n.id })
			count -= 1
		end
	end
	if mouthIndex > 0 and #s.props > 0 then
		local m = mouths[mouthIndex]
		for _ = 1, math.max(0, count) do
			local p = rng:pick(s.props)
			local half = math.max(0, (m.sx - math.max(p.collider.size_studs[1], p.collider.size_studs[2])) / 2)
			table.insert(drops, {
				propId = p.id,
				x = m.cx + rng:nextRange(-half, half),
				z = m.cz + rng:nextRange(-half, half),
				yaw = rng:nextInt(0, 3) * 90,
				structural = false,
			})
		end
	end
	return { index = index, warningTime = impact - band.warning_seconds, impactTime = impact, mouthIndex = mouthIndex, drops = drops }
end

-- Number of waves whose impact time is <= simSeconds (since room activation).
function Wave.countUntil(s: Schedule, simSeconds: number): number
	if simSeconds < s.firstImpact then
		return 0
	end
	return 1 + math.floor((simSeconds - s.firstImpact) / s.band.wave_interval_seconds + 1e-9)
end

return Wave
]]></string>
          </Properties>
        </Item>
      </Item>
