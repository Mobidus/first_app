        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">ObjectPool</string>
            <string name="Source"><![CDATA[--!strict
-- Reusable object pool. Engine-agnostic: the factory and the reset routine are injected
-- (Roblox: clone a template Model; tests: plain tables). Release ALWAYS runs the full reset:
-- connections, velocities, network owner, effects, reward identifiers, tags, anchoring.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.GeneratedConfig)

local Pool = {}
Pool.__index = Pool

export type Pool = typeof(setmetatable(
	{} :: {
		factory: (kind: string) -> any,
		reset: (obj: any) -> (),
		free: { [string]: { any } },
		inUse: { [any]: string },
		created: number,
		acquired: number,
		released: number,
		maxFreePerKind: number,
		maxFreeTotal: number,
		freeTotal: number,
		destroy: ((obj: any) -> ())?,
	},
	Pool
))

function Pool.new(
	opts: {
		factory: (kind: string) -> any,
		reset: (obj: any) -> (),
		destroy: ((obj: any) -> ())?,
		maxFreePerKind: number?,
		maxFreeTotal: number?, -- default: runtime.streaming.max_fill_colliders_active_room
	}
): Pool
	return setmetatable({
		factory = opts.factory,
		reset = opts.reset,
		destroy = opts.destroy,
		free = {},
		inUse = {},
		created = 0,
		acquired = 0,
		released = 0,
		maxFreePerKind = opts.maxFreePerKind or math.huge,
		maxFreeTotal = opts.maxFreeTotal or Config.Runtime.streaming.max_fill_colliders_active_room,
		freeTotal = 0,
	}, Pool)
end

function Pool.acquire(self: Pool, kind: string): any
	local list = self.free[kind]
	local obj
	if list and #list > 0 then
		obj = table.remove(list)
		self.freeTotal -= 1
	else
		obj = self.factory(kind)
		self.created += 1
	end
	self.inUse[obj] = kind
	self.acquired += 1
	return obj
end

function Pool.release(self: Pool, obj: any)
	local kind = self.inUse[obj]
	assert(kind, "releasing an object that is not in use")
	self.inUse[obj] = nil
	self.reset(obj)
	self.released += 1
	local list = self.free[kind]
	if not list then
		list = {}
		self.free[kind] = list
	end
	if #list < self.maxFreePerKind and self.freeTotal < self.maxFreeTotal then
		table.insert(list, obj)
		self.freeTotal += 1
	elseif self.destroy then
		self.destroy(obj)
	end
end

function Pool.inUseCount(self: Pool): number
	local n = 0
	for _ in self.inUse do
		n += 1
	end
	return n
end

function Pool.freeCount(self: Pool): number
	local n = 0
	for _, list in self.free do
		n += #list
	end
	return n
end

-- Release everything still in use (room teardown).
function Pool.releaseAll(self: Pool)
	local all = {}
	for obj in self.inUse do
		table.insert(all, obj)
	end
	for _, obj in all do
		self:release(obj)
	end
end

return Pool
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">PlayerProfileRepository</string>
            <string name="Source"><![CDATA[--!strict
-- Profile repository: load + session lock + migrations + SERIALIZED atomic mutations.
-- Storage is injected (DataStoreAdapter in Roblox, MemoryStore in offline tests) so the logic is
-- testable without the engine. A mutation is committed in memory only after the durable write
-- succeeded; a failed write is reported as failure ("save_failed") and never as "Sauvegardé".
--
-- Store contract:  store.update(key, transform: (old: any?) -> any?) -> (ok: boolean, result: any)
--   transform returns the new value, or nil to cancel (result is then the old value).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Mut = require(Shared.Domain.ProfileMutations)

local Repository = {}
Repository.__index = Repository

export type Store = { update: (self: any, key: string, transform: (any?) -> any?) -> (boolean, any) }

type Session = {
	userKey: string,
	profile: any,
	queue: { { mutation: any, ctx: any?, done: (boolean, any, any) -> () } },
	busy: boolean,
	released: boolean,
	failures: number,
}

function Repository.new(opts: { store: any, jobId: string, now: () -> number, lockTimeoutSeconds: number? })
	local self = setmetatable({}, Repository)
	self.store = opts.store
	self.jobId = opts.jobId
	self.now = opts.now
	self.lockTimeout = opts.lockTimeoutSeconds or 1800
	self.sessions = {} :: { [string]: Session }
	return self
end

local function keyFor(userKey: string): string
	return "profile_" .. userKey
end

-- Returns (true, profile, notes) or (false, reason). Refuses a profile locked by another live
-- session (no simultaneous ownership of the same profile).
function Repository.load(self, userKey: string): (boolean, any, any)
	if self.sessions[userKey] then
		return false, "already_loaded", nil
	end
	local notes = {}
	local lockedBy: string? = nil
	local ok, result = self.store:update(keyFor(userKey), function(old)
		local doc = old or { profile = nil, lock = nil }
		if doc.lock and doc.lock.jobId ~= self.jobId and (self.now() - doc.lock.time) < self.lockTimeout then
			lockedBy = doc.lock.jobId
			return nil
		end
		local migrated, migrationNotes = Mut.migrate(doc.profile)
		notes = migrationNotes
		return { profile = migrated, lock = { jobId = self.jobId, time = self.now() } }
	end)
	if not ok then
		return false, "store_unavailable", nil
	end
	if lockedBy then
		return false, "session_locked", nil
	end
	local valid, why = Mut.validate(result.profile)
	if not valid then
		return false, "corrupt_profile:" .. tostring(why), nil
	end
	self.sessions[userKey] = {
		userKey = userKey,
		profile = result.profile,
		queue = {},
		busy = false,
		released = false,
		failures = 0,
	}
	return true, Mut.deepCopy(result.profile), notes
end

-- Read-only snapshot (copy) of the committed profile.
function Repository.get(self, userKey: string): any?
	local s = self.sessions[userKey]
	return s and Mut.deepCopy(s.profile)
end

function Repository._commit(self, s: Session, mutation: any, ctx: any?): (boolean, any, any)
	if s.released then
		return false, "session_released", nil
	end
	local ok, newProfile, info = Mut.apply(s.profile, mutation, ctx)
	if not ok then
		return false, newProfile, nil -- domain refusal: nothing written
	end
	local expectedRevision = s.profile.revision
	local conflict = false
	local wrote, result = self.store:update(keyFor(s.userKey), function(old)
		if old == nil or old.lock == nil or old.lock.jobId ~= self.jobId or old.profile.revision ~= expectedRevision then
			conflict = true
			return nil
		end
		return { profile = newProfile, lock = { jobId = self.jobId, time = self.now() } }
	end)
	if not wrote then
		s.failures += 1
		return false, "save_failed", nil
	end
	if conflict then
		s.failures += 1
		return false, "session_conflict", nil
	end
	s.failures = 0
	s.profile = result.profile
	return true, Mut.deepCopy(result.profile), info
end

-- Serialized per profile: concurrent callers are queued FIFO. With a yielding store (Roblox
-- UpdateAsync) the first caller drains the queue and later callers receive their own result.
function Repository.mutate(self, userKey: string, mutation: any, ctx: any?): (boolean, any, any)
	local s = self.sessions[userKey]
	if not s then
		return false, "not_loaded", nil
	end
	local resultOk, resultValue, resultInfo
	local finished = false
	local waiting: thread? = nil
	table.insert(s.queue, {
		mutation = mutation,
		ctx = ctx,
		done = function(a, b, c)
			resultOk, resultValue, resultInfo = a, b, c
			finished = true
			if waiting and coroutine.status(waiting) == "suspended" then
				task.spawn(waiting)
			end
		end,
	})
	if not s.busy then
		s.busy = true
		while #s.queue > 0 do
			local job = table.remove(s.queue, 1)
			local ok, v, info = self:_commit(s, job.mutation, job.ctx)
			job.done(ok, v, info)
		end
		s.busy = false
	end
	if not finished then
		waiting = coroutine.running()
		coroutine.yield()
	end
	return resultOk, resultValue, resultInfo
end

-- Final durable write releasing the lock. Returns false when the write failed.
function Repository.release(self, userKey: string): boolean
	local s = self.sessions[userKey]
	if not s then
		return true
	end
	s.released = true
	local ok = self.store:update(keyFor(userKey), function(old)
		if old == nil or old.lock == nil or old.lock.jobId ~= self.jobId then
			return nil
		end
		return { profile = s.profile, lock = nil }
	end)
	self.sessions[userKey] = nil
	return ok
end

------------------------------------------------------------------------------------------------
-- In-memory store (offline tests / Studio without API access). Supports failure injection.
------------------------------------------------------------------------------------------------
local MemoryStore = {}
MemoryStore.__index = MemoryStore

function MemoryStore.new()
	return setmetatable({ data = {}, failNext = 0, failAll = false, writes = 0 }, MemoryStore)
end

function MemoryStore.update(self, key: string, transform: (any?) -> any?): (boolean, any)
	if self.failAll or self.failNext > 0 then
		self.failNext = math.max(0, self.failNext - 1)
		return false, "injected_failure"
	end
	local old = self.data[key] and Mut.deepCopy(self.data[key]) or nil
	local new = transform(old)
	if new == nil then
		return true, old
	end
	self.data[key] = Mut.deepCopy(new)
	self.writes += 1
	return true, Mut.deepCopy(new)
end

Repository.MemoryStore = MemoryStore

------------------------------------------------------------------------------------------------
-- Roblox DataStore adapter (engine only; NOT exercised offline).
------------------------------------------------------------------------------------------------
function Repository.dataStoreAdapter(dataStoreName: string)
	local DataStoreService = game:GetService("DataStoreService")
	local ds = DataStoreService:GetDataStore(dataStoreName)
	return {
		update = function(_, key: string, transform: (any?) -> any?): (boolean, any)
			local result
			local ok, err = pcall(function()
				result = ds:UpdateAsync(key, function(old)
					return transform(old)
				end)
			end)
			if not ok then
				warn("[PlayerProfileRepository] UpdateAsync failed:", err)
				return false, err
			end
			return true, result
		end,
	}
end

return Repository
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">PropFactory</string>
            <string name="Source"><![CDATA[--!strict
-- Builds a prop as: one SIMPLE server collider (invisible Part, the only collision) + visual parts
-- (no collision, no query) + a top marker (function colour AND icon). Uses the T03 parametric
-- generators when present (ServerStorage.AssetGenerators), otherwise a clearly identified proxy.
-- Plush props get a visual "PlushVisual" model the client deforms; the collider never deforms.
local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.GeneratedConfig)
local Template = require(script.Parent.Parent.RoomTemplates.Template)

local PropFactory = {}

local PROPS: { [string]: any } = {}
for _, f in Config.Rooms.families do
	for _, p in f.props do
		PROPS[p.id] = p
	end
end
PropFactory.PROPS = PROPS

local generators = ServerStorage:FindFirstChild("AssetGenerators")

local function v3(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

local function addMarker(model: Model, behavior: string, w: number, d: number, topY: number)
	local marker = Instance.new("Part")
	marker.Name = "TopMarker"
	marker.Anchored = false
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.Massless = true
	marker.Size = Vector3.new(math.min(3, w * 0.4), 0.06, math.min(3, d * 0.4))
	marker.Color = Template.markerColor(behavior)
	marker.Material = Enum.Material.Neon
	marker.Transparency = 0.15
	marker:SetAttribute("Icon", Template.markerIcon(behavior)) -- footprint / spring / arrows / hourglass
	marker:SetAttribute("LocalY", topY + 0.03)
	CollectionService:AddTag(marker, "DecorOnly")
	local decal = Instance.new("Decal")
	decal.Face = Enum.NormalId.Top
	decal.Texture = "" -- icon texture id: null until assets are imported (manifest)
	decal.Parent = marker
	marker.Parent = model
end

-- Returns Model whose PrimaryPart is the collider ("Collider"). Pivot = bottom centre.
function PropFactory.create(propId: string, template: any?): Model
	local p = PROPS[propId]
	assert(p, "unknown prop " .. propId)
	local size = p.collider.size_studs -- width, depth, height
	local w, d, h = size[1], size[2], size[3]
	local model = Instance.new("Model")
	model.Name = propId
	model:SetAttribute("PropId", propId)
	model:SetAttribute("Behavior", p.behavior)

	local collider = Instance.new("Part")
	collider.Name = "Collider"
	collider.Size = Vector3.new(w, h, d)
	collider.Transparency = 1
	collider.CanCollide = true
	collider.CanQuery = true
	collider.TopSurface = Enum.SurfaceType.Smooth
	collider.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.8, 0.05, 1, 1)
	collider:SetAttribute("WalkableW", p.collider.walkable_top[1])
	collider:SetAttribute("WalkableD", p.collider.walkable_top[2])
	CollectionService:AddTag(collider, "FillCollider")
	collider.Parent = model
	model.PrimaryPart = collider

	local gen = generators and generators:FindFirstChild(propId)
	local visualRoot = Instance.new("Model")
	visualRoot.Name = if p.deformation_profile == "plush_soft" then "PlushVisual" else "Visual"
	if gen and gen:IsA("ModuleScript") then
		local desc = (require(gen) :: any).build({ size = p.size_studs })
		for _, spec in desc.parts do
			local part = Instance.new("Part")
			part.Name = spec.name
			part.Size = v3(spec.size)
			part.Color = Color3.fromHex(spec.color)
			local okMat = pcall(function()
				part.Material = (Enum.Material :: any)[spec.material]
			end)
			if not okMat then
				part.Material = Enum.Material.SmoothPlastic
			end
			part.Shape = (Enum.PartType :: any)[spec.shape == "Cylinder" and "Cylinder" or spec.shape == "Ball" and "Ball" or "Block"]
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
			part:SetAttribute("LocalOffset", v3(spec.offset) - Vector3.new(0, h / 2, 0))
			-- generator rotation hints (Roblox cylinders run along X): per part, per name, or for all cylinders
			local rot = spec.rotationDeg
				or (desc.chevronRotationDeg and desc.chevronRotationDeg[spec.name])
				or (spec.shape == "Cylinder" and (desc.edgeCylinderRotationDeg or desc.stampRotationDeg))
			if rot then
				part:SetAttribute("LocalRotationDeg", v3(rot))
			end
			part.Parent = visualRoot
		end
	else
		-- PROXY (diagnostic only, not the final art): coloured block with rounded silhouette hints
		local body = Instance.new("Part")
		body.Name = "ProxyBody"
		body.Size = Vector3.new(p.size_studs[1], h, p.size_studs[2])
		body.Color = (template and template.propColors[propId]) or Color3.fromRGB(240, 230, 210)
		body.Material = if template then template.propMaterial else Enum.Material.SmoothPlastic
		body.CanCollide = false
		body.CanQuery = false
		body.CanTouch = false
		body.Massless = true
		body:SetAttribute("LocalOffset", Vector3.zero)
		body:SetAttribute("Proxy", true)
		body.Parent = visualRoot
		model:SetAttribute("VisualStatus", "proxy_not_final_art")
	end
	visualRoot.Parent = model
	if p.deformation_profile == "plush_soft" then
		CollectionService:AddTag(model, "Plush")
	end
	addMarker(model, p.behavior, p.collider.walkable_top[1], p.collider.walkable_top[2], h / 2)
	-- weld visual parts to the collider (unanchored, massless: they follow the physical root)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= collider then
			local off = part:GetAttribute("LocalOffset") or Vector3.new(0, (part:GetAttribute("LocalY") :: number?) or 0, 0)
			local rot = part:GetAttribute("LocalRotationDeg") :: Vector3?
			part.CFrame = collider.CFrame
				* CFrame.new(off :: Vector3)
				* (if rot then CFrame.Angles(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z)) else CFrame.identity)
			if visualRoot.Name ~= "PlushVisual" or part.Name == "TopMarker" then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = collider
				weld.Part1 = part
				weld.Parent = part
			else
				-- plush visual: NOT welded to the falling root; anchored template that each client
				-- re-poses locally every frame from the collider CFrame (PlushDeformationController)
				part.Anchored = true
			end
		end
	end
	return model
end

-- Pool reset routine: clears everything a previous life could leave behind.
function PropFactory.reset(model: Model)
	local collider = model.PrimaryPart :: BasePart
	collider.Anchored = true
	collider.AssemblyLinearVelocity = Vector3.zero
	collider.AssemblyAngularVelocity = Vector3.zero
	for _, attr in { "ObjectInstanceId", "RewardTag", "SettledFor", "Occupied", "Stabilized", "Structural", "RouteNode" } do
		model:SetAttribute(attr, nil)
	end
	for _, tag in { "FillAggregate", "Stabilizable", "RouteSupport" } do
		CollectionService:RemoveTag(collider, tag)
	end
	for _, d in model:GetDescendants() do
		if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Highlight") then
			d:Destroy()
		end
	end
	model.Parent = nil
end

return PropFactory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--!strict
-- Robux purchases (docs/03 §9, docs/05 §9, sources S6-S9).
-- * Real purchases are impossible while economy.monetization.robux_shop_enabled == false or while
--   a SKU's product_id / gamepass_id is null: no prompt is ever opened, no fake success is shown.
-- * ProcessReceipt grants coins ONCE per PurchaseId, and returns PurchaseGranted only after the
--   durable profile write succeeded (otherwise NotProcessedYet => Roblox retries later).
-- * Closing the purchase dialog is never treated as a proof of payment.
-- Engine wiring (MarketplaceService) is isolated in `bind`; the decision logic is offline-testable.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.GeneratedConfig)

local Econ = Config.Economy

local Purchase = {}
Purchase.__index = Purchase

Purchase.GRANTED = "PurchaseGranted"
Purchase.NOT_YET = "NotProcessedYet"

local function packsByProduct(): { [number]: any }
	local map = {}
	for _, p in Econ.coin_packs do
		if p.product_id ~= nil then
			map[p.product_id] = p
		end
	end
	return map
end

function Purchase.new(opts: { repository: any, userKeyFor: (playerId: number) -> string?, log: ((string) -> ())? })
	local self = setmetatable({}, Purchase)
	self.repo = opts.repository
	self.userKeyFor = opts.userKeyFor
	self.log = opts.log or function() end
	self.products = packsByProduct()
	return self
end

-- Can the UI open a real purchase prompt for this SKU? (always false in this delivery)
function Purchase.canPrompt(skuId: string): (boolean, string)
	if Econ.monetization.robux_shop_enabled ~= true then
		return false, "shop_disabled"
	end
	for _, p in Econ.coin_packs do
		if p.sku_id == skuId then
			return p.product_id ~= nil, if p.product_id then "ok" else "product_id_missing"
		end
	end
	for _, p in Econ.premium_cosmetics do
		if p.sku_id == skuId then
			return p.gamepass_id ~= nil, if p.gamepass_id then "ok" else "gamepass_id_missing"
		end
	end
	return false, "unknown_sku"
end

-- receipt: { PurchaseId: string, ProductId: number, PlayerId: number }
function Purchase.processReceipt(self, receipt: any): string
	local pack = self.products[receipt.ProductId]
	if pack == nil then
		self.log("receipt for unknown product " .. tostring(receipt.ProductId) .. " left unprocessed")
		return Purchase.NOT_YET
	end
	local userKey = self.userKeyFor(receipt.PlayerId)
	if userKey == nil then
		return Purchase.NOT_YET -- player offline / profile not loaded on this server: retry later
	end
	local profile = self.repo:get(userKey)
	if profile and profile.purchaseLedger.receipts[receipt.PurchaseId] then
		return Purchase.GRANTED -- already durably granted: idempotent acknowledgement
	end
	local ok, why = self.repo:mutate(userKey, { type = "GrantReceipt", receiptId = tostring(receipt.PurchaseId), coins = pack.coins })
	if ok then
		return Purchase.GRANTED
	end
	if why == "already_granted" then
		return Purchase.GRANTED
	end
	self.log("receipt " .. tostring(receipt.PurchaseId) .. " not granted yet: " .. tostring(why))
	return Purchase.NOT_YET
end

-- Engine binding (Studio / live only).
function Purchase.bind(self)
	local MarketplaceService = game:GetService("MarketplaceService")
	MarketplaceService.ProcessReceipt = function(receiptInfo)
		return Enum.ProductPurchaseDecision[self:processReceipt(receiptInfo)]
	end
end

return Purchase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--!strict
-- Voluntary rebirth in the sas: server-issued preview token bound to player, quantity and profile
-- revision; confirmation recomputes the cumulative cost and commits ONE mutation.
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rebirth = require(Shared.Domain.Rebirth)

local RebirthService = {}
RebirthService.__index = RebirthService

function RebirthService.new(repo: any, telemetry: any)
	return setmetatable(
		{ repo = repo, telemetry = telemetry, secret = HttpService:GenerateGUID(false), busy = {} :: { [string]: boolean } },
		RebirthService
	)
end

function RebirthService.preview(self, userKey: string, quantity: number, inSas: boolean): any
	if not inSas then
		return { ok = false, error = "not_in_sas" }
	end
	local profile = self.repo:get(userKey)
	local ok, res = Rebirth.preview(profile, userKey, quantity, self.secret)
	if not ok then
		return { ok = false, error = res, maxAffordable = Rebirth.maxAffordable(profile.rebirthCount, profile.permits) }
	end
	return { ok = true, preview = res }
end

function RebirthService.confirm(self, userKey: string, req: any, inSas: boolean): any
	if self.busy[userKey] then
		return { ok = false, error = "transaction_in_progress" }
	end
	self.busy[userKey] = true
	local ok, res, info = self.repo:mutate(userKey, {
		type = "Rebirth",
		quantity = req.quantity,
		expectedRevision = req.expectedRevision,
		previewToken = req.previewToken,
		inSas = inSas,
	}, { userKey = userKey, secret = self.secret })
	self.busy[userKey] = nil
	self.telemetry:event(userKey, ok and "rebirth" or "rebirth_refused", { quantity = req.quantity, reason = (not ok) and res or nil })
	if not ok then
		return { ok = false, error = res }
	end
	return { ok = true, profile = res, result = info }
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Network surface. Clients send bounded INTENTS through one RemoteFunction; the server pushes
-- authoritative state through RemoteEvents. Every intent is schema-validated and rate limited.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Intent = require(Shared.Domain.IntentValidation)

local Remotes = {}

local folder: Folder
local handlers: { [string]: (player: Player, args: any) -> any } = {}
local limiter = Intent.newLimiter(6, 3) -- per player+intent: burst 6, 3/s sustained

Remotes.EVENTS = { "State", "Hud", "WaveWarning", "PlushImpact", "RadarHighlight", "BurialWarning", "ToolEffect", "Transition" }

function Remotes.init()
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in Remotes.EVENTS do
		local ev = Instance.new("RemoteEvent")
		ev.Name = name
		ev.Parent = folder
	end
	local rf = Instance.new("RemoteFunction")
	rf.Name = "Intent"
	rf.Parent = folder
	rf.OnServerInvoke = function(player: Player, name: any, args: any)
		if type(name) ~= "string" or type(args) ~= "table" then
			return { ok = false, error = "bad_request" }
		end
		if not Intent.allow(limiter, tostring(player.UserId) .. ":" .. name, os.clock()) then
			return { ok = false, error = "rate_limited" }
		end
		local ok, parsed = Intent.validate(name, args)
		if not ok then
			return { ok = false, error = parsed }
		end
		local handler = handlers[name]
		if not handler then
			return { ok = false, error = "not_handled" }
		end
		local success, result = pcall(handler, player, parsed)
		if not success then
			warn("[Remotes] handler error", name, result)
			return { ok = false, error = "server_error" }
		end
		return result
	end
	folder.Parent = ReplicatedStorage
end

function Remotes.on(name: string, handler: (player: Player, args: any) -> any)
	handlers[name] = handler
end

function Remotes.fire(player: Player, event: string, payload: any)
	(folder:FindFirstChild(event) :: RemoteEvent):FireClient(player, payload)
end

function Remotes.forget(player: Player)
	Intent.forget(limiter, tostring(player.UserId) .. ":")
end

return Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!strict
-- Grants progression rewards through the profile repository. The rebirth rate is frozen at room
-- start; milestone/exit/token identities derive from runId + depth + milestone. All amounts come
-- from config via the pure Rewards module; the client never supplies an amount.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rewards = require(Shared.Domain.Rewards)

local RewardService = {}
RewardService.__index = RewardService

function RewardService.new(repo: any, telemetry: any)
	return setmetatable({ repo = repo, telemetry = telemetry }, RewardService)
end

-- room: { runId, depth, mask, rateBp, paidBaseCumulative } (mutated on success)
function RewardService.progress(self, userKey: string, room: any, index: number): (boolean, any)
	local ok, profileOrErr, claim = self.repo:mutate(userKey, {
		type = "GrantProgress",
		runId = room.runId,
		depth = room.depth,
		index = index,
		mask = room.mask,
		rateBp = room.rateBp,
		paidBaseCumulative = room.paidBaseCumulative,
	})
	if ok then
		room.mask = claim.newMask
		room.paidBaseCumulative = claim.newPaidBaseCumulative
		for _, line in claim.lines do
			self.telemetry:event(userKey, "reward", { rewardId = line.rewardId, amount = line.amount, kind = line.kind })
		end
		return true, { profile = profileOrErr, claim = claim }
	end
	return false, profileOrErr
end

function RewardService.token(self, userKey: string, room: any, tokenIndex: number): (boolean, any)
	local ok, profileOrErr, claim = self.repo:mutate(userKey, {
		type = "GrantToken",
		runId = room.runId,
		depth = room.depth,
		tokenIndex = tokenIndex,
		mask = room.mask,
		paidBaseCumulative = room.paidBaseCumulative,
	})
	if ok then
		room.mask = claim.newMask
		return true, { profile = profileOrErr, claim = claim }
	end
	return false, profileOrErr
end

function RewardService.rateForProfile(profile: any): number
	return Rewards.rebirthBasisPoints(profile.rebirthCount)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">RoomGenerator</string>
            <string name="Source"><![CDATA[--!strict
-- Turns a validated RoomDefinition (shared/Domain/RoomPlan) into Instances inside a fixed local
-- cell. Never builds a room that RouteValidator rejected: RoomPlan.build returns validated rooms
-- or a certified fallback (with a diagnostic event).
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local RoomPlan = require(Shared.Domain.RoomPlan)
local Templates = script.Parent.Parent.RoomTemplates
local PropFactory = require(script.Parent.PropFactory)

local RoomGenerator = {}

local TEMPLATE_BY_FAMILY = {
	reception = "Reception",
	toy = "Toys",
	bureau = "Office",
	kitchen = "Kitchen",
	garage = "Garage",
	bin = "GiantBin",
}

-- Each session owns a slot: two room cells + one sas cell, reused forever (no drifting chain).
-- Slots are 4000 studs apart so that rooms, fill colliders, burial probes and "standing on"
-- checks of different players can never interact (solo expeditions, docs/01).
RoomGenerator.SLOT_SPACING = 4000

function RoomGenerator.cellsFor(slot: number): { [any]: CFrame }
	local base = CFrame.new(slot * RoomGenerator.SLOT_SPACING, 0, 0)
	return {
		[1] = base,
		[2] = base * CFrame.new(400, 0, 0),
		sas = base * CFrame.new(200, 0, 300),
	}
end

-- Backwards-compatible default (slot 0), used by Studio test scenes.
RoomGenerator.CELLS = RoomGenerator.cellsFor(0)

function RoomGenerator.template(familyId: string)
	return require(Templates:WaitForChild(TEMPLATE_BY_FAMILY[familyId]) :: ModuleScript)
end

local function block(
	parent: Instance,
	name: string,
	origin: CFrame,
	box: any,
	color: Color3,
	material: Enum.Material,
	tag: string?,
	transparency: number?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = Vector3.new(box.sx, box.sy, box.sz)
	p.CFrame = origin * CFrame.new(box.cx, box.cy, box.cz)
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if tag then
		CollectionService:AddTag(p, tag)
	end
	p.Parent = parent
	return p
end

local function shell(model: Model, origin: CFrame, room: any, tpl: any)
	local w, d, h = room.size.w, room.size.d, room.size.h
	local pal = tpl.palette
	block(
		model,
		"Floor",
		origin,
		{ cx = 0, cy = -0.5, cz = 0, sx = w, sy = 1, sz = d },
		Color3.fromHex("#FFF5DF"),
		tpl.floorMaterial,
		"Architecture"
	)
	local t = 1
	-- walls; the exit wall gets an opening cut as 4 blocks around room.exitOpening when needed
	local walls = {
		{ name = "WallN", cx = 0, cz = d / 2 + t / 2, sx = w + 2 * t, sz = t, axis = "z", sign = 1 },
		{ name = "WallS", cx = 0, cz = -d / 2 - t / 2, sx = w + 2 * t, sz = t, axis = "z", sign = -1 },
		{ name = "WallE", cx = w / 2 + t / 2, cz = 0, sx = t, sz = d, axis = "x", sign = 1 },
		{ name = "WallW", cx = -w / 2 - t / 2, cz = 0, sx = t, sz = d, axis = "x", sign = -1 },
	}
	local o = room.exitOpening
	for _, wall in walls do
		local cutsThis = (room.exitType ~= "roof" and room.exitType ~= "floor_hatch")
			and (
				(wall.axis == "z" and math.abs(o.cz - wall.sign * d / 2) < 1)
				or (wall.axis == "x" and math.abs(o.cx - wall.sign * w / 2) < 1)
			)
		if not cutsThis then
			block(
				model,
				wall.name,
				origin,
				{ cx = wall.cx, cy = h / 2, cz = wall.cz, sx = wall.sx, sy = h, sz = wall.sz },
				pal.background,
				tpl.wallMaterial,
				"Architecture"
			)
		else
			local along = if wall.axis == "z" then o.cx else o.cz
			local len = if wall.axis == "z" then wall.sx else wall.sz
			local half = (if wall.axis == "z" then o.sx else o.sz) / 2
			local lo, hi = along - half, along + half
			local segs = {
				{ a = -len / 2, b = lo, y0 = 0, y1 = h },
				{ a = hi, b = len / 2, y0 = 0, y1 = h },
				{ a = lo, b = hi, y0 = 0, y1 = o.cy - o.sy / 2 },
				{ a = lo, b = hi, y0 = o.cy + o.sy / 2, y1 = h },
			}
			for i, s in segs do
				if s.b - s.a > 0.05 and s.y1 - s.y0 > 0.05 then
					local mid, size = (s.a + s.b) / 2, s.b - s.a
					local box = if wall.axis == "z"
						then { cx = mid, cy = (s.y0 + s.y1) / 2, cz = wall.cz, sx = size, sy = s.y1 - s.y0, sz = t }
						else { cx = wall.cx, cy = (s.y0 + s.y1) / 2, cz = mid, sx = t, sy = s.y1 - s.y0, sz = size }
					block(model, wall.name .. "_" .. i, origin, box, pal.background, tpl.wallMaterial, "Architecture")
				end
			end
		end
	end
	-- ceiling (decorative architecture: excluded from burial probes) with openings left open
	local openings = table.clone(room.ceilingOpenings or {})
	if room.exitType == "roof" then
		table.insert(openings, room.exitOpening)
	end
	if #openings == 0 then
		block(
			model,
			"Ceiling",
			origin,
			{ cx = 0, cy = h + 0.5, cz = 0, sx = w, sy = 1, sz = d },
			pal.structure,
			Enum.Material.SmoothPlastic,
			"Architecture",
			0.2
		)
	else
		-- coarse grid of ceiling tiles skipping openings
		local tile = 4
		for x = -w / 2, w / 2 - tile, tile do
			for z = -d / 2, d / 2 - tile, tile do
				local cx, cz = x + tile / 2, z + tile / 2
				local open = false
				for _, op in openings do
					if math.abs(cx - op.cx) * 2 < op.sx + tile and math.abs(cz - op.cz) * 2 < op.sz + tile then
						open = true
					end
				end
				if not open then
					block(
						model,
						"CeilingTile",
						origin,
						{ cx = cx, cy = h + 0.5, cz = cz, sx = tile, sy = 1, sz = tile },
						pal.structure,
						Enum.Material.SmoothPlastic,
						"Architecture",
						0.2
					)
				end
			end
		end
	end
end

-- Build the room. Returns model + lookup tables used by the services.
function RoomGenerator.build(room: any, cell: CFrame, parent: Instance): (Model, any)
	local tpl = RoomGenerator.template(room.familyId)
	local model = Instance.new("Model")
	model.Name = string.format("Room_%s_d%d", room.templateId, room.depth)
	model:SetAttribute("TemplateId", room.templateId)
	model:SetAttribute("Depth", room.depth)
	model:SetAttribute("Seed", room.seed)
	model:SetAttribute("Fallback", room.fallback == true)
	shell(model, cell, room, tpl)
	local index = {
		supports = {},
		structuralSlots = {},
		optional = {},
		tokens = {},
		mouths = {},
		exitZone = nil :: BasePart?,
		clearance = nil :: BasePart?,
	}

	-- supports: pedestals/shelves are Architecture, props are FillCollider pre-settled & anchored
	for _, n in room.routeGraph.nodes do
		if n.kind == "column" or n.kind == "shelf" then
			for i, part in n.stack do
				if part.kind == "pedestal" or part.kind == "shelf" then
					block(
						model,
						n.id .. "_" .. part.kind,
						cell,
						part.box,
						tpl.palette.structure,
						Enum.Material.SmoothPlastic,
						"Architecture"
					)
				elseif part.propId then
					if n.arrival == "wave1" and i == #n.stack then
						-- structural guest (e.g. Mallow): delivered by WaveDirector at wave 1
						index.structuralSlots[n.id] =
							{ propId = part.propId, cframe = cell * CFrame.new(part.box.cx, part.box.cy, part.box.cz), nodeId = n.id }
					else
						local prop = PropFactory.create(part.propId, tpl)
						prop:PivotTo(cell * CFrame.new(part.box.cx, part.box.cy, part.box.cz))
						local col = prop.PrimaryPart :: BasePart
						col.Anchored = true
						prop:SetAttribute("RouteNode", n.id)
						CollectionService:AddTag(col, "RouteSupport")
						if n.optional then
							prop:SetAttribute("Optional", true)
							table.insert(index.optional, { model = prop, node = n })
						end
						prop.Parent = model
						table.insert(index.supports, { model = prop, node = n })
					end
				end
			end
		elseif n.kind == "exit_ledge" and n.topY > 0 then
			local p = block(model, n.id, cell, n.box, tpl.palette.structure, Enum.Material.SmoothPlastic, "Architecture")
			-- mint arch + vertical chevron on the opening (colour + shape + motion)
			p:SetAttribute("ExitLedge", true)
		end
	end

	-- exit clearance (protected volume, not collidable) and exit trigger
	local c = room.exitClearance
	local clr = block(model, "ExitClearance", cell, c, Color3.fromHex("#39E68B"), Enum.Material.ForceField, "ExitClearance", 0.92)
	clr.CanCollide = false
	clr.CanQuery = true
	clr.CanTouch = false
	index.clearance = clr
	local o = room.exitOpening
	local trig = block(
		model,
		"ExitTrigger",
		cell,
		{ cx = o.cx, cy = o.cy, cz = o.cz, sx = math.max(o.sx, 2), sy = math.max(o.sy, 2), sz = math.max(o.sz, 2) },
		Color3.fromHex("#39E68B"),
		Enum.Material.Neon,
		"ExitTrigger",
		0.6
	)
	trig.CanCollide = false
	trig.CanQuery = false
	trig.CanTouch = false
	index.exitZone = trig
	if room.leverId then
		for _, n in room.routeGraph.nodes do
			if n.id == room.leverId then
				local lever = block(
					model,
					"Lever",
					cell,
					{ cx = n.box.cx, cy = n.topY + 1.5, cz = n.box.cz, sx = 1, sy = 3, sz = 1 },
					Color3.fromHex("#FFE14D"),
					Enum.Material.SmoothPlastic,
					"Lever"
				)
				lever.CanCollide = false
				index.lever = lever
			end
		end
	end

	-- wave mouths (ceiling chutes, decor) with coral danger triangles drawn by the client
	for i, m in room.waveMouths do
		local mouth = block(
			model,
			"Mouth" .. i,
			cell,
			{ cx = m.cx, cy = room.size.h - 0.25, cz = m.cz, sx = m.sx, sy = 0.5, sz = m.sz },
			Color3.fromHex("#FF684B"),
			Enum.Material.SmoothPlastic,
			"DecorOnly",
			0.3
		)
		mouth.CanCollide = false
		mouth.CanQuery = false
		index.mouths[i] = mouth
	end

	-- optional tokens (violet star, bonus only)
	for _, tk in room.tokens do
		local p = Instance.new("Part")
		p.Name = "Token" .. tk.id
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(1.4, 1.4, 1.4)
		p.Color = Color3.fromHex("#8855FF")
		p.Material = Enum.Material.Neon
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CFrame = cell * CFrame.new(tk.x, tk.y, tk.z)
		p:SetAttribute("TokenIndex", tk.id)
		CollectionService:AddTag(p, "OptionalToken")
		p.Parent = model
		index.tokens[tk.id] = p
	end

	model:SetAttribute("Cell", tostring(cell.Position))
	model.Parent = parent
	return model, index
end

-- Plan + validate + build for a depth. Diagnostics of rejected attempts are returned.
function RoomGenerator.plan(depth: number, runSeed: number, history: { any }, profileName: string?)
	local spec = RoomPlan.selectSpec(depth, runSeed, history, profileName)
	local seed = bit32.bxor(runSeed, depth * 2654435761 % 4294967296)
	local room, diags = RoomPlan.build(spec, depth, seed)
	return room, spec, diags
end

return RoomGenerator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">TelemetryService</string>
            <string name="Source"><![CDATA[--!strict
-- Telemetry: structured events and counters for first-session UX, KO, exits, resumes and
-- rebirths. It never touches the economy and never invents retention statistics.
local TelemetryService = {}
TelemetryService.__index = TelemetryService

TelemetryService.MAX_BUFFER = 2000

function TelemetryService.new(sink: ((any) -> ())?)
	return setmetatable({ buffer = {}, counters = {}, sink = sink }, TelemetryService)
end

function TelemetryService.event(self, userKey: string, name: string, data: any?)
	local e = { t = os.time(), clock = os.clock(), user = userKey, name = name, data = data }
	table.insert(self.buffer, e)
	if #self.buffer > TelemetryService.MAX_BUFFER then
		table.remove(self.buffer, 1)
	end
	self.counters[name] = (self.counters[name] or 0) + 1
	if self.sink then
		self.sink(e)
	end
end

function TelemetryService.snapshot(self): any
	return { counters = table.clone(self.counters), buffered = #self.buffer }
end

return TelemetryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[--!strict
-- Tutorial rewards/kiosk rules shared by ExpeditionService.startTutorial (the cell flow) and the
-- sas kiosk. Kept separate for the T12 contract: rewards are granted once per account through
-- PlayerProfileRepository; the kiosk sells exactly the configured first tool at its config price.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.GeneratedConfig)
local Tutorial = require(Shared.Domain.Tutorial)

local TutorialService = {}

TutorialService.FIRST_TOOL = Config.Economy.tutorial.first_tool_id

function TutorialService.grant(repo: any, userKey: string, event: string): (boolean, string?)
	local p = repo:get(userKey)
	local reward = Tutorial.rewardFor(event, p.tutorialFlags)
	if not reward then
		return false, nil
	end
	local ok = repo:mutate(userKey, { type = "GrantTutorial", rewardId = reward })
	return ok, reward
end

-- Kiosk offer as displayed (never authoritative): price from config, two actions, no timer.
function TutorialService.kioskOffer(profile: any): any
	local tool = Config.Economy.tools[1]
	assert(tool.id == TutorialService.FIRST_TOOL, "first catalogue tool must be the tutorial tool")
	return {
		skuId = tool.id,
		name = tool.name,
		price = tool.coins,
		balance = profile.coins,
		after = profile.coins - tool.coins,
		owned = profile.ownedTools[tool.id] == true,
		actions = Tutorial.KIOSK_BUTTONS,
		countdown = nil,
		robuxOffer = nil,
	}
end

return TutorialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">WaveDirector</string>
            <string name="Source"><![CDATA[--!strict
-- Drives the waves of the ONE active room (docs/05 §7). Time = active simulation seconds
-- accumulated from Heartbeat dt (a slow client cannot accelerate waves). The director announces,
-- drops, consolidates and recycles; it never decides a KO.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.GeneratedConfig)
local Wave = require(Shared.Domain.WaveSchedule)
local Consolidation = require(Shared.Domain.Consolidation)
local RoomPlan = require(Shared.Domain.RoomPlan)
local Maid = require(Shared.Util.Maid)
local Pool = require(script.Parent.ObjectPool)
local PropFactory = require(script.Parent.PropFactory)

local WaveDirector = {}
WaveDirector.__index = WaveDirector

local DROP_HEIGHT_BELOW_CEILING = 2
local CONSOLIDATE_EVERY = 0.5
local SETTLE_SPEED = 0.6

local sharedPool = Pool.new({
	factory = function(kind: string)
		return PropFactory.create(kind)
	end,
	reset = PropFactory.reset,
	destroy = function(m)
		m:Destroy()
	end,
	-- keep up to one full active-room fill budget in reserve (no churn between rooms)
	maxFreeTotal = Config.Runtime.streaming.max_fill_colliders_active_room,
})
WaveDirector.pool = sharedPool

export type Hooks = {
	warn: (info: any) -> (),
	plushImpact: (event: any) -> (),
	diagnostic: (name: string, data: any) -> (),
}

function WaveDirector.new(room: any, index: any, cell: CFrame, roomModel: Model, depth: number, hooks: Hooks)
	local self = setmetatable({}, WaveDirector)
	self.room = room
	self.index = index
	self.cell = cell
	self.model = roomModel
	self.hooks = hooks
	self.schedule = Wave.new(room, RoomPlan.FAMILIES[room.familyId], math.max(depth, 1))
	self.simTime = 0
	self.nextWave = 1
	self.warned = {}
	self.objects = {} :: { [Model]: any }
	self.deferred = {} :: { any }
	self.maid = Maid.new()
	self.running = false
	self.lastConsolidate = 0
	self.serial = 0
	return self
end

function WaveDirector.start(self)
	if self.running then
		return
	end
	self.running = true
	self.maid:give(RunService.Heartbeat:Connect(function(dt)
		self:step(dt)
	end))
end

local function playersStandingOn(model: Model): boolean
	local collider = model.PrimaryPart
	if not collider then
		return false
	end
	for _, plr in game:GetService("Players"):GetPlayers() do
		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if char and hum and hum.FloorMaterial ~= Enum.Material.Air then
			local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local rel = collider.CFrame:PointToObjectSpace(root.Position)
				local s = collider.Size
				if math.abs(rel.X) <= s.X / 2 + 1 and math.abs(rel.Z) <= s.Z / 2 + 1 and rel.Y > 0 and rel.Y < s.Y / 2 + 4 then
					return true
				end
			end
		end
	end
	return false
end

function WaveDirector.spawnDrop(self, drop: any, _impactTime: number)
	local m = sharedPool:acquire(drop.propId)
	self.serial += 1
	local id = string.format("%s:%d", self.room.templateId, self.serial)
	m:SetAttribute("ObjectInstanceId", id)
	local col = m.PrimaryPart :: BasePart
	local y = self.room.size.h - DROP_HEIGHT_BELOW_CEILING - col.Size.Y / 2
	local cf = self.cell * CFrame.new(drop.x, y, drop.z) * CFrame.Angles(0, math.rad(drop.yaw), 0)
	if drop.structural then
		-- structural support: guided descent onto its validated slot, then anchored
		local slot = self.index.structuralSlots[drop.nodeId]
		m:PivotTo(slot.cframe + Vector3.new(0, self.room.size.h * 0.6, 0))
		col.Anchored = true
		m:SetAttribute("Structural", true)
		CollectionService:AddTag(col, "RouteSupport")
		m.Parent = self.model
		local TweenService = game:GetService("TweenService")
		local tween =
			TweenService:Create(col, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = slot.cframe })
		tween.Completed:Once(function()
			self.hooks.plushImpact({
				objectInstanceId = id,
				serverTime = Workspace:GetServerTimeNow(),
				impactNormal = { x = 0, y = 1, z = 0 },
				impactStrength = 1,
				settleState = "impact",
				model = m,
			})
		end)
		tween:Play()
		self.objects[m] = { id = id, dynamic = false, settledFor = 99, age = 0, structural = true }
		return
	end
	m:PivotTo(cf)
	col.Anchored = false
	m.Parent = self.model
	pcall(function()
		col:SetNetworkOwner(nil) -- server-authoritative fill physics
	end)
	local entry = { id = id, dynamic = true, settledFor = 0, age = 0, impacted = false }
	self.objects[m] = entry
	if m:HasTag("Plush") then
		self.maid:give(col.Touched:Connect(function(other)
			if entry.impacted or other:IsDescendantOf(m) then
				return
			end
			entry.impacted = true
			local speed = col.AssemblyLinearVelocity.Magnitude
			self.hooks.plushImpact({
				objectInstanceId = id,
				serverTime = Workspace:GetServerTimeNow(),
				impactNormal = { x = 0, y = 1, z = 0 },
				impactStrength = math.clamp(speed / 50, 0, 1),
				settleState = "impact",
				model = m,
			})
		end))
	end
end

local function coveredOnAllSides(col: BasePart, params: OverlapParams): boolean
	local s = col.Size
	local probes = {
		{ CFrame.new(0, s.Y / 2 + 1, 0), Vector3.new(s.X * 0.8, 1.5, s.Z * 0.8) },
		{ CFrame.new(s.X / 2 + 1, 0, 0), Vector3.new(1.5, s.Y * 0.8, s.Z * 0.8) },
		{ CFrame.new(-s.X / 2 - 1, 0, 0), Vector3.new(1.5, s.Y * 0.8, s.Z * 0.8) },
		{ CFrame.new(0, 0, s.Z / 2 + 1), Vector3.new(s.X * 0.8, s.Y * 0.8, 1.5) },
		{ CFrame.new(0, 0, -s.Z / 2 - 1), Vector3.new(s.X * 0.8, s.Y * 0.8, 1.5) },
	}
	for _, pr in probes do
		local hits = Workspace:GetPartBoundsInBox(col.CFrame * pr[1], pr[2], params)
		local other = false
		for _, h in hits do
			if not h:IsDescendantOf(col.Parent :: Instance) then
				other = true
				break
			end
		end
		if not other then
			return false
		end
	end
	return true
end

function WaveDirector.consolidate(self)
	local fillParams = OverlapParams.new()
	fillParams.FilterType = Enum.RaycastFilterType.Include
	local fill = {}
	for _, tag in { "FillCollider", "FillAggregate" } do
		for _, inst in CollectionService:GetTagged(tag) do
			table.insert(fill, inst)
		end
	end
	fillParams.FilterDescendantsInstances = fill
	local list = {}
	local byId = {}
	local dynCount = 0
	for m, e in self.objects do
		local col = m.PrimaryPart
		if col == nil then
			continue
		end
		local occupied = playersStandingOn(m)
		local buried = false
		if not col.Anchored then
			dynCount += 1
		elseif not occupied then
			-- buried = top AND all four sides covered by other FILL colliders (architecture, shelves,
			-- ceiling and the exit clearance never count): only then is it unreachable
			buried = e.age > 20 and coveredOnAllSides(col, fillParams)
		end
		table.insert(list, {
			id = e.id,
			dynamic = not col.Anchored,
			settledFor = e.settledFor,
			occupied = occupied,
			routeSupport = col:HasTag("RouteSupport"),
			buried = buried,
			age = e.age,
		})
		byId[e.id] = m
	end
	local plan = Consolidation.plan(list)
	for _, id in plan.anchor do
		local m = byId[id]
		if m and m.PrimaryPart then
			m.PrimaryPart.Anchored = true
			CollectionService:AddTag(m.PrimaryPart, "Stabilizable")
		end
	end
	for _, id in plan.merge do
		local m = byId[id]
		if m and m.PrimaryPart then
			CollectionService:AddTag(m.PrimaryPart, "FillAggregate")
		end
	end
	for _, id in plan.recycle do
		local m = byId[id]
		if m then
			self.objects[m] = nil
			sharedPool:release(m)
		end
	end
	self.allowance = plan.spawnAllowance
end

-- Objects that rolled into the protected exit clearance are recycled (never obstruct the exit).
function WaveDirector.sweepClearance(self)
	local clr = self.index.clearance :: BasePart?
	if not clr then
		return
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { self.model }
	for _, part in Workspace:GetPartsInPart(clr, params) do
		if part.Name == "Collider" and part.Parent and part.Parent:IsA("Model") and not part:HasTag("RouteSupport") then
			local m = part.Parent :: Model
			if self.objects[m] then
				self.objects[m] = nil
				sharedPool:release(m)
				self.hooks.diagnostic("clearance_swept", { id = m:GetAttribute("ObjectInstanceId") })
			end
		end
	end
end

function WaveDirector.step(self, dt: number)
	if not self.running then
		return
	end
	self.simTime += dt
	-- settle tracking
	for m, e in self.objects do
		e.age += dt
		local col = m.PrimaryPart
		if col and not col.Anchored then
			if col.AssemblyLinearVelocity.Magnitude < SETTLE_SPEED then
				e.settledFor += dt
			else
				e.settledFor = 0
			end
		end
	end
	-- announcements, always before impact
	local upcoming = Wave.at(self.schedule, self.nextWave)
	if not self.warned[upcoming.index] and self.simTime >= upcoming.warningTime then
		self.warned[upcoming.index] = true
		self.hooks.warn({
			index = upcoming.index,
			mouthIndex = upcoming.mouthIndex,
			impactIn = upcoming.impactTime - self.simTime,
			drops = upcoming.drops,
		})
	end
	if self.simTime >= upcoming.impactTime then
		for _, drop in upcoming.drops do
			table.insert(self.deferred, drop)
		end
		self.warned[upcoming.index] = nil
		self.nextWave += 1
	end
	if self.simTime - self.lastConsolidate >= CONSOLIDATE_EVERY then
		self.lastConsolidate = self.simTime
		self:consolidate()
		self:sweepClearance()
	end
	local allowance = self.allowance or 40
	while #self.deferred > 0 and (allowance > 0 or self.deferred[1].structural) do
		local drop = table.remove(self.deferred, 1)
		self:spawnDrop(drop, self.simTime)
		allowance -= 1
	end
	self.allowance = allowance
end

function WaveDirector.dynamicCount(self): number
	local n = 0
	for m in self.objects do
		if m.PrimaryPart and not m.PrimaryPart.Anchored then
			n += 1
		end
	end
	return n
end

function WaveDirector.stop(self)
	self.running = false
	self.maid:clean()
end

-- Release everything (room teardown after a committed transition).
function WaveDirector.destroy(self)
	self:stop()
	for m in self.objects do
		sharedPool:release(m)
	end
	table.clear(self.objects)
	table.clear(self.deferred)
end

return WaveDirector
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="60">
        <Properties>
          <string name="Name">Tools</string>
        </Properties>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">StarterRadar</string>
            <string name="Source"><![CDATA[--!strict
-- Radar POP (first tool, T12 vertical slice). Server picks up to 3 usable surfaces in range from
-- the CURRENT room supports (anchored, not buried, head clearance free) and tells the client which
-- ones to highlight for the configured duration. It never moves the avatar.
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tools = require(Shared.Domain.ToolRules)

local StarterRadar = {}

StarterRadar.ID = "radar_pop"

local function clearAbove(col: BasePart): boolean
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { col.Parent :: Instance }
	local box = col.CFrame * CFrame.new(0, col.Size.Y / 2 + 3, 0)
	return #Workspace:GetPartBoundsInBox(box, Vector3.new(3, 5.5, 3), params) == 0
end

-- candidates from the room model: every prop collider currently anchored
function StarterRadar.candidates(roomModel: Model): { any }
	local out = {}
	for _, m in roomModel:GetChildren() do
		if m:IsA("Model") and m.PrimaryPart and m:GetAttribute("PropId") then
			local col = m.PrimaryPart :: BasePart
			local top = col.Position + Vector3.new(0, col.Size.Y / 2, 0)
			table.insert(out, {
				id = m:GetAttribute("ObjectInstanceId") or m:GetFullName(),
				x = top.X,
				y = top.Y,
				z = top.Z,
				usable = col.Anchored and clearAbove(col),
				buried = col:HasTag("FillAggregate"),
				model = m,
			})
		end
	end
	return out
end

function StarterRadar.resolve(effect: any, rootPos: Vector3, roomModel: Model): { Model }
	local cands = StarterRadar.candidates(roomModel)
	local ids = Tools.radarTargets({ x = rootPos.X, y = rootPos.Y, z = rootPos.Z }, cands, effect.stats)
	local models = {}
	for _, id in ids do
		for _, c in cands do
			if c.id == id then
				table.insert(models, c.model)
			end
		end
	end
	return models
end

return StarterRadar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">ToolService</string>
            <string name="Source"><![CDATA[--!strict
-- Generalises the StarterRadar protocol to the other MVP tools (catalogue order): intent ->
-- ToolRules.check (ownership, slot, charges, cooldown, range, target, room state) -> commit ->
-- effect. Refusals never consume a charge. V1 tools stay "unavailable" until implemented.
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tools = require(Shared.Domain.ToolRules)
local StarterRadar = require(script.Parent.StarterRadar)

local ToolService = {}
ToolService.__index = ToolService

function ToolService.new(telemetry: any)
	return setmetatable({ telemetry = telemetry, states = {} :: { [Player]: any } }, ToolService)
end

function ToolService.enterRoom(self, player: Player, profile: any, roomInstanceId: string, snapshot: { [string]: number }?)
	self.states[player] = Tools.enterRoom(self.states[player] or Tools.newState(), profile, roomInstanceId, snapshot)
end

function ToolService.charges(self, player: Player): { [string]: number }
	local s = self.states[player]
	return s and table.clone(s.charges) or {}
end

local function resolveTarget(roomModel: Model?, targetId: string): any?
	if not roomModel or targetId == "" then
		return nil
	end
	for _, m in roomModel:GetChildren() do
		if m:IsA("Model") and m:GetAttribute("ObjectInstanceId") == targetId and m.PrimaryPart then
			local col = m.PrimaryPart :: BasePart
			local size = col.Size
			local volume = size.X * size.Y * size.Z
			return {
				id = targetId,
				model = m,
				x = col.Position.X,
				y = col.Position.Y,
				z = col.Position.Z,
				stabilizable = col:HasTag("Stabilizable") or not col.Anchored,
				structural = col:HasTag("Architecture") or m:GetAttribute("Structural") == true,
				protectedRoute = col:HasTag("RouteSupport"),
				isExit = col:HasTag("ExitTrigger") or col:HasTag("ExitClearance"),
				sizeClass = if volume <= 150 then 1 elseif volume <= 400 then 2 else 3,
				buried = col:HasTag("FillAggregate"),
			}
		end
	end
	return nil
end

-- ctx: { profile, roomState, inSas, now, roomModel }
function ToolService.use(self, player: Player, toolId: string, targetId: string, ctx: any): any
	local state = self.states[player] or Tools.newState()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return { ok = false, error = "no_character" }
	end
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local useCtx = {
		profile = ctx.profile,
		roomState = ctx.roomState,
		inSas = ctx.inSas,
		now = ctx.now,
		player = {
			x = root.Position.X,
			y = root.Position.Y,
			z = root.Position.Z,
			vy = root.AssemblyLinearVelocity.Y,
			grounded = hum ~= nil and hum.FloorMaterial ~= Enum.Material.Air,
		},
		target = resolveTarget(ctx.roomModel, targetId),
	}
	local ok, effect = Tools.check(state, toolId, useCtx)
	if not ok then
		return { ok = false, error = effect }
	end
	self.states[player] = Tools.commit(state, effect, ctx.now)
	local payload: any =
		{ ok = true, toolId = toolId, kind = effect.kind, duration = effect.duration, charges = self.states[player].charges[toolId] }
	if effect.kind == "highlight" then
		payload.targets = StarterRadar.resolve(effect, root.Position, ctx.roomModel)
	elseif effect.kind == "stabilize" then
		local target = useCtx.target
		local col = target.model.PrimaryPart :: BasePart
		local wasAnchored = col.Anchored
		col.Anchored = true
		task.delay(effect.duration, function()
			if col.Parent and not wasAnchored and not col:HasTag("RouteSupport") then
				col.Anchored = false
			end
		end)
		payload.targetId = target.id
	elseif effect.kind == "glide" then
		payload.descentMultiplier = effect.descentMultiplier
	end
	self.telemetry:event(tostring(player.UserId), "tool_use", { toolId = toolId, kind = effect.kind })
	return payload
end

function ToolService.forget(self, player: Player)
	self.states[player] = nil
end

-- tokens attracted by the passive magnet (server decides; claim goes through RewardService)
function ToolService.magnetTokens(profile: any, rootPos: Vector3, tokens: { any }, mask: number, bit0: number): { number }
	return Tools.magnetPull(profile, { x = rootPos.X, y = rootPos.Y, z = rootPos.Z }, tokens, mask, bit0)
end

ToolService.CollectionService = CollectionService
return ToolService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="63">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="64">
      <Properties>
        <string name="Name">AssetGenerators</string>
      </Properties>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">exit_door</string>
          <string name="Source"><![CDATA[--!strict
-- exit_door — Sortie « Porte » (MVP). Générateur paramétrique T03.
-- Repère : origine = centre bas de l'ouverture, dans le plan du mur ; la salle est du côté -Z (avant).
-- Collision : périmètre seulement, centre ouvert. Balise : arche menthe + chevron vertical (forme + couleur).
-- Volume protégé : params.clearance = approach_clearance_studs de config/rooms.json (largeur, profondeur, hauteur).
local ID = "exit_door"
local FRAME = "#203055"
local MINT = "#39E68B"
local WALL_T = 1 -- épaisseur de mur du kit (géométrie d'architecture, pas une règle de jeu)

local function part(
	name: string,
	size: { number },
	offset: { number },
	color: string,
	material: string,
	canCollide: boolean,
	tags: { string },
	shape: string?
)
	return {
		name = name,
		size = size,
		offset = offset,
		color = color,
		material = material,
		materialFallback = "SmoothPlastic",
		canCollide = canCollide,
		tags = tags,
		shape = shape or "Block",
	}
end

local function readClearance(params: any): (number, number, number)
	assert(type(params) == "table" and type(params.clearance) == "table", ID .. " : params.clearance (config/rooms.json exit_types) requis")
	local w, d, h = params.clearance[1], params.clearance[2], params.clearance[3]
	assert(
		type(w) == "number" and w >= 8 and type(d) == "number" and d >= 8 and type(h) == "number" and h >= 10,
		ID .. " : dégagement minimal 8x8x10"
	)
	return w, d, h
end

return {
	id = ID,
	build = function(params: any)
		local cw, cd, ch = readClearance(params)
		local ow, oh = cw - 2, ch - 2 -- ouverture franchissable 6 x 8 pour un dégagement 8 x 10
		local parts = {
			part("JambL", { 1, oh + 1, WALL_T }, { -ow / 2 - 0.5, (oh + 1) / 2, 0 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			part("JambR", { 1, oh + 1, WALL_T }, { ow / 2 + 0.5, (oh + 1) / 2, 0 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			part("Lintel", { ow + 2, 1, WALL_T }, { 0, oh + 0.5, 0 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			-- seuil affleurant (sol de passage)
			part("Threshold", { ow, 0.2, WALL_T + 2 }, { 0, 0.1, 1 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			-- balisage : arche menthe (lumineuse) + chevron vertical au-dessus
			part(
				"MintArchL",
				{ 0.3, oh, 0.2 },
				{ -ow / 2 - 0.15, oh / 2, -WALL_T / 2 - 0.1 },
				MINT,
				"Neon",
				false,
				{ "DecorOnly", "ExitMarker" }
			),
			part(
				"MintArchR",
				{ 0.3, oh, 0.2 },
				{ ow / 2 + 0.15, oh / 2, -WALL_T / 2 - 0.1 },
				MINT,
				"Neon",
				false,
				{ "DecorOnly", "ExitMarker" }
			),
			part(
				"MintArchTop",
				{ ow + 0.6, 0.3, 0.2 },
				{ 0, oh + 0.15, -WALL_T / 2 - 0.1 },
				MINT,
				"Neon",
				false,
				{ "DecorOnly", "ExitMarker" }
			),
			part(
				"ChevronL",
				{ 0.35, 1.4, 0.2 },
				{ -0.45, oh + 1.6, -WALL_T / 2 - 0.1 },
				MINT,
				"Neon",
				false,
				{ "DecorOnly", "ExitMarker" }
			),
			part("ChevronR", { 0.35, 1.4, 0.2 }, { 0.45, oh + 1.6, -WALL_T / 2 - 0.1 }, MINT, "Neon", false, { "DecorOnly", "ExitMarker" }),
		}
		return {
			id = ID,
			exitType = "door",
			parts = parts,
			chevronRotationDeg = { ChevronL = { 0, 0, -35 }, ChevronR = { 0, 0, 35 } },
			opening = { width = ow, height = oh },
			volumes = {
				-- approche protégée côté salle : aucun spawn, trajectoire de chute ni décor solide
				{
					name = "ExitClearance",
					size = { cw, ch, cd },
					offset = { 0, ch / 2, -WALL_T / 2 - cd / 2 },
					tags = { "ExitClearance" },
					canCollide = false,
				},
				-- déclencheur de sortie dans l'épaisseur du passage (validé côté serveur)
				{
					name = "ExitTrigger",
					size = { ow, oh, WALL_T + 2 },
					offset = { 0, oh / 2, 1 },
					tags = { "ExitTrigger" },
					canCollide = false,
				},
			},
		}
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">exit_roof</string>
          <string name="Source"><![CDATA[--!strict
-- exit_roof — Sortie « Toit » (MVP). Générateur paramétrique T03.
-- Repère : origine = centre de la trappe, dans le plan du plafond (y = 0) ; la salle est sous la trappe (y < 0).
-- Franchissement : reach_platform_then_step_through_hatch. camera_headroom_required : puits dégagé au-dessus.
local ID = "exit_roof"
local FRAME = "#203055"
local MINT = "#39E68B"
local DECK = "#FFF5DF"

local function part(
	name: string,
	size: { number },
	offset: { number },
	color: string,
	material: string,
	canCollide: boolean,
	tags: { string },
	shape: string?
)
	return {
		name = name,
		size = size,
		offset = offset,
		color = color,
		material = material,
		materialFallback = "SmoothPlastic",
		canCollide = canCollide,
		tags = tags,
		shape = shape or "Block",
	}
end

local function readClearance(params: any): (number, number, number)
	assert(type(params) == "table" and type(params.clearance) == "table", ID .. " : params.clearance (config/rooms.json exit_types) requis")
	local w, d, h = params.clearance[1], params.clearance[2], params.clearance[3]
	assert(
		type(w) == "number" and w >= 8 and type(d) == "number" and d >= 8 and type(h) == "number" and h >= 10,
		ID .. " : dégagement minimal 8x8x10"
	)
	return w, d, h
end

return {
	id = ID,
	build = function(params: any)
		local cw, cd, ch = readClearance(params)
		local ow, od = cw - 2, cd - 2 -- trappe 6 x 6
		local t = 1
		local parts = {
			-- cadre de trappe (collision) dans le plafond
			part("RimL", { 1, t, od + 2 }, { -ow / 2 - 0.5, t / 2, 0 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			part("RimR", { 1, t, od + 2 }, { ow / 2 + 0.5, t / 2, 0 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			part("RimF", { ow, t, 1 }, { 0, t / 2, -od / 2 - 0.5 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			part("RimB", { ow, t, 1 }, { 0, t / 2, od / 2 + 0.5 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			-- pont de sortie au-dessus : on prend pied à côté de la trappe
			part(
				"RoofDeck",
				{ cw + 4, 0.5, cd + 4 },
				{ 0, t + 0.25, cd / 2 + 2 + od / 2 },
				DECK,
				"SmoothPlastic",
				true,
				{ "Architecture" }
			),
			-- balisage : anneau menthe autour de la trappe + chevron vertical pointant vers le haut
			part("MintRingF", { ow + 0.6, 0.2, 0.3 }, { 0, -0.1, -od / 2 - 0.15 }, MINT, "Neon", false, { "DecorOnly", "ExitMarker" }),
			part("MintRingB", { ow + 0.6, 0.2, 0.3 }, { 0, -0.1, od / 2 + 0.15 }, MINT, "Neon", false, { "DecorOnly", "ExitMarker" }),
			part("MintRingL", { 0.3, 0.2, od }, { -ow / 2 - 0.15, -0.1, 0 }, MINT, "Neon", false, { "DecorOnly", "ExitMarker" }),
			part("MintRingR", { 0.3, 0.2, od }, { ow / 2 + 0.15, -0.1, 0 }, MINT, "Neon", false, { "DecorOnly", "ExitMarker" }),
		}
		return {
			id = ID,
			exitType = "roof",
			parts = parts,
			opening = { width = ow, depth = od },
			volumes = {
				-- dégagement sous la trappe (approche par le dernier appui)
				{
					name = "ExitClearance",
					size = { cw, ch, cd },
					offset = { 0, -ch / 2, 0 },
					tags = { "ExitClearance" },
					canCollide = false,
				},
				-- espace de tête et de caméra au-dessus de la trappe
				{ name = "CameraHeadroom", size = { ow, 8, od }, offset = { 0, t + 4, 0 }, tags = { "ExitClearance" }, canCollide = false },
				{ name = "ExitTrigger", size = { ow, 3, od }, offset = { 0, t + 1.5, 0 }, tags = { "ExitTrigger" }, canCollide = false },
			},
		}
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">exit_window</string>
          <string name="Source"><![CDATA[--!strict
-- exit_window — Sortie « Fenêtre » (MVP). Générateur paramétrique T03.
-- Repère : origine = centre de l'appui (rebord) visible, dans le plan du mur ; la salle est côté -Z.
-- Franchissement : step_through_visible_sill. Le rebord dépasse dans la salle et sert de dernier appui protégé.
local ID = "exit_window"
local FRAME = "#203055"
local SILL = "#FFF5DF"
local MINT = "#39E68B"
local GLASS = "#DFF7FF"
local WALL_T = 1

local function part(
	name: string,
	size: { number },
	offset: { number },
	color: string,
	material: string,
	canCollide: boolean,
	tags: { string },
	shape: string?
)
	return {
		name = name,
		size = size,
		offset = offset,
		color = color,
		material = material,
		materialFallback = "SmoothPlastic",
		canCollide = canCollide,
		tags = tags,
		shape = shape or "Block",
	}
end

local function readClearance(params: any): (number, number, number)
	assert(type(params) == "table" and type(params.clearance) == "table", ID .. " : params.clearance (config/rooms.json exit_types) requis")
	local w, d, h = params.clearance[1], params.clearance[2], params.clearance[3]
	assert(
		type(w) == "number" and w >= 8 and type(d) == "number" and d >= 8 and type(h) == "number" and h >= 10,
		ID .. " : dégagement minimal 8x8x10"
	)
	return w, d, h
end

return {
	id = ID,
	build = function(params: any)
		local cw, cd, ch = readClearance(params)
		local ow, oh = cw - 2, ch - 2
		local sillDepth = 2.5
		local parts = {
			part("FrameL", { 1, oh + 1, WALL_T }, { -ow / 2 - 0.5, (oh + 1) / 2, 0 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			part("FrameR", { 1, oh + 1, WALL_T }, { ow / 2 + 0.5, (oh + 1) / 2, 0 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			part("FrameTop", { ow + 2, 1, WALL_T }, { 0, oh + 0.5, 0 }, FRAME, "SmoothPlastic", true, { "Architecture" }),
			-- rebord large, crème, plat : réception visible (balise stable posée par le jeu)
			part(
				"Sill",
				{ ow + 2, 0.5, WALL_T + sillDepth },
				{ 0, -0.25, -sillDepth / 2 },
				SILL,
				"SmoothPlastic",
				true,
				{ "Architecture" }
			),
			-- vitre ouverte : battant relevé, sans collision dans l'ouverture
			part("OpenSash", { ow, 0.2, 2 }, { 0, oh - 0.1, 1.2 }, GLASS, "Glass", false, { "DecorOnly" }),
			part("MintSillEdge", { ow + 2, 0.12, 0.3 }, { 0, 0.06, -sillDepth - 0.05 }, MINT, "Neon", false, { "DecorOnly", "ExitMarker" }),
			part(
				"MintArchTop",
				{ ow + 0.6, 0.3, 0.2 },
				{ 0, oh + 0.15, -WALL_T / 2 - 0.1 },
				MINT,
				"Neon",
				false,
				{ "DecorOnly", "ExitMarker" }
			),
			part(
				"ChevronL",
				{ 0.35, 1.4, 0.2 },
				{ -0.45, oh + 1.6, -WALL_T / 2 - 0.1 },
				MINT,
				"Neon",
				false,
				{ "DecorOnly", "ExitMarker" }
			),
			part("ChevronR", { 0.35, 1.4, 0.2 }, { 0.45, oh + 1.6, -WALL_T / 2 - 0.1 }, MINT, "Neon", false, { "DecorOnly", "ExitMarker" }),
		}
		return {
			id = ID,
			exitType = "window",
			parts = parts,
			chevronRotationDeg = { ChevronL = { 0, 0, -35 }, ChevronR = { 0, 0, 35 } },
			opening = { width = ow, height = oh },
			walkableTop = {
				size = { ow + 2, sillDepth + WALL_T },
				height = 0,
				center = { 0, 0, -sillDepth / 2 },
				marker = "stable",
				protected = true,
			},
			volumes = {
				{
					name = "ExitClearance",
					size = { cw, ch, cd },
					offset = { 0, ch / 2, -WALL_T / 2 - cd / 2 },
					tags = { "ExitClearance" },
					canCollide = false,
				},
				{
					name = "ExitTrigger",
					size = { ow, oh, WALL_T + 2 },
					offset = { 0, oh / 2, 1 },
					tags = { "ExitTrigger" },
					canCollide = false,
				},
			},
		}
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">machine_reception_stamp</string>
          <string name="Source"><![CDATA[--!strict
-- machine_reception_stamp — « Le Tamponneur », machine signature de Réception. Générateur T03 (PROXY).
-- Le manifeste prévoit un mesh Blender (3 000 à 8 000 triangles) : cette version primitives est un
-- proxy de prototype clairement identifié ; elle ne clôt pas la livraison artistique.
-- Brief : presse corail à deux yeux mécaniques, pied arrondi, gros tampon jaune ; chaîne cyan derrière une vitre.
-- Collision : proxy d'architecture séparé (hors parcours, non sondé par l'ensevelissement).
local ID = "machine_reception_stamp"
local CORAL = "#FF8C78" -- corail doux (le corail danger #FF684B est réservé aux balises de danger)
local YELLOW = "#FFE14D"
local CYAN = "#16D9FF"
local NAVY = "#203055"
local WHITE = "#FFF5DF"
local GLASS = "#DFF7FF"

local function part(
	name: string,
	size: { number },
	offset: { number },
	color: string,
	material: string,
	canCollide: boolean,
	tags: { string },
	shape: string?
)
	return {
		name = name,
		size = size,
		offset = offset,
		color = color,
		material = material,
		materialFallback = "SmoothPlastic",
		canCollide = canCollide,
		tags = tags,
		shape = shape or "Block",
	}
end

local function readSize(params: any): (number, number, number)
	assert(type(params) == "table" and type(params.size) == "table", ID .. " : params.size (config/rooms.json machine.size_studs) requis")
	local w, d, h = params.size[1], params.size[2], params.size[3]
	assert(type(w) == "number" and w > 0 and type(d) == "number" and d > 0 and type(h) == "number" and h > 0, ID .. " : size invalide")
	return w, d, h
end

return {
	id = ID,
	isPrototypeProxy = true,
	build = function(params: any)
		local w, d, h = readSize(params)
		local footH = h * 0.12
		local bodyH = h * 0.45
		local bodyY = footH + bodyH / 2
		local parts = {
			part("Foot", { footH, w * 0.7, w * 0.7 }, { 0, footH / 2, 0 }, CORAL, "SmoothPlastic", false, { "DecorOnly" }, "Cylinder"),
			part("Body", { w * 0.8, bodyH, d * 0.7 }, { 0, bodyY, 0 }, CORAL, "SmoothPlastic", false, { "DecorOnly" }),
			part(
				"EyeL",
				{ 2.4, 2.4, 2.4 },
				{ -w * 0.18, bodyY + bodyH * 0.2, -d * 0.35 },
				WHITE,
				"SmoothPlastic",
				false,
				{ "DecorOnly" },
				"Ball"
			),
			part(
				"EyeR",
				{ 2.4, 2.4, 2.4 },
				{ w * 0.18, bodyY + bodyH * 0.2, -d * 0.35 },
				WHITE,
				"SmoothPlastic",
				false,
				{ "DecorOnly" },
				"Ball"
			),
			part(
				"PupilL",
				{ 1.0, 1.0, 1.0 },
				{ -w * 0.18, bodyY + bodyH * 0.2, -d * 0.35 - 1.0 },
				NAVY,
				"SmoothPlastic",
				false,
				{ "DecorOnly" },
				"Ball"
			),
			part(
				"PupilR",
				{ 1.0, 1.0, 1.0 },
				{ w * 0.18, bodyY + bodyH * 0.2, -d * 0.35 - 1.0 },
				NAVY,
				"SmoothPlastic",
				false,
				{ "DecorOnly" },
				"Ball"
			),
			-- bras de presse et gros tampon jaune au-dessus
			part("Arm", { w * 0.15, h * 0.2, d * 0.15 }, { 0, footH + bodyH + h * 0.1, 0 }, NAVY, "Metal", false, { "DecorOnly" }),
			part(
				"Stamp",
				{ h * 0.12, w * 0.45, w * 0.45 },
				{ 0, h - h * 0.06 - h * 0.1, 0 },
				YELLOW,
				"SmoothPlastic",
				false,
				{ "DecorOnly" },
				"Cylinder"
			),
			part("StampPad", { w * 0.5, h * 0.05, d * 0.5 }, { 0, h - h * 0.025, 0 }, NAVY, "Fabric", false, { "DecorOnly" }),
			-- vitre arrière et chaîne cyan visible derrière
			part("Glass", { w * 0.8, h * 0.5, 0.2 }, { 0, footH + h * 0.25, d * 0.42 }, GLASS, "Glass", false, { "DecorOnly" }),
		}
		parts[#parts].transparency = 0.6
		for i = 0, 5 do
			table.insert(
				parts,
				part(
					"ChainLink" .. i,
					{ 0.8, 1.2, 0.3 },
					{ -w * 0.3 + i * w * 0.12, footH + h * 0.3, d * 0.46 },
					CYAN,
					"SmoothPlastic",
					false,
					{ "DecorOnly" }
				)
			)
		end
		return {
			id = ID,
			isPrototypeProxy = true,
			parts = parts,
			stampRotationDeg = { 0, 0, 90 },
			collider = {
				shape = "box",
				size = { w, h, d },
				offset = { 0, h / 2, 0 },
				tags = { "Architecture" },
				canCollide = true,
				walkable = false,
			},
		}
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">reception_carton</string>
          <string name="Source"><![CDATA[--!strict
-- reception_carton — Carton standard (stable). Générateur paramétrique T03 (primitives Roblox).
-- Brief : carton jaune, ruban cyan, coins arrondis, plateau supérieur plat. Taille : config/rooms.json.
local ID = "reception_carton"
local CARTON = "#F2C94C"
local CARTON_EDGE = "#E0B43C"
local TAPE = "#16D9FF"

local function part(
	name: string,
	size: { number },
	offset: { number },
	color: string,
	material: string,
	canCollide: boolean,
	tags: { string },
	shape: string?
)
	return {
		name = name,
		size = size,
		offset = offset,
		color = color,
		material = material,
		materialFallback = "SmoothPlastic",
		canCollide = canCollide,
		tags = tags,
		shape = shape or "Block",
	}
end

local function readSize(params: any): (number, number, number)
	assert(type(params) == "table" and type(params.size) == "table", ID .. " : params.size (config/rooms.json) requis")
	local w, d, h = params.size[1], params.size[2], params.size[3]
	assert(type(w) == "number" and w > 0 and type(d) == "number" and d > 0 and type(h) == "number" and h > 0, ID .. " : size invalide")
	return w, d, h
end

return {
	id = ID,
	build = function(params: any)
		local w, d, h = readSize(params)
		local r = math.min(0.35, w * 0.05, d * 0.05) -- rayon des arêtes verticales arrondies
		local parts = {
			-- corps en croix (deux blocs) + 4 cylindres d'arête = coins arrondis, dessus plat à h
			part("BodyX", { w, h, d - 2 * r }, { 0, h / 2, 0 }, CARTON, "Cardboard", false, { "DecorOnly" }),
			part("BodyZ", { w - 2 * r, h, d }, { 0, h / 2, 0 }, CARTON, "Cardboard", false, { "DecorOnly" }),
		}
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				table.insert(
					parts,
					part(
						"Edge",
						{ h, 2 * r, 2 * r },
						{ sx * (w / 2 - r), h / 2, sz * (d / 2 - r) },
						CARTON_EDGE,
						"Cardboard",
						false,
						{ "DecorOnly" },
						"Cylinder"
					)
				)
			end
		end
		-- ruban cyan affleurant (épaisseur 0.04 : écart visuel/collision << 0.25 stud)
		table.insert(parts, part("TapeTop", { w, 0.04, 1.2 }, { 0, h + 0.02, 0 }, TAPE, "SmoothPlastic", false, { "DecorOnly" }))
		table.insert(parts, part("TapeFront", { 1.2, h, 0.04 }, { 0, h / 2, -d / 2 - 0.02 }, TAPE, "SmoothPlastic", false, { "DecorOnly" }))
		table.insert(parts, part("TapeBack", { 1.2, h, 0.04 }, { 0, h / 2, d / 2 + 0.02 }, TAPE, "SmoothPlastic", false, { "DecorOnly" }))
		return {
			id = ID,
			parts = parts,
			-- les cylindres d'arête ont l'axe X dans Roblox : rotation à appliquer par l'instanciateur
			edgeCylinderRotationDeg = { 0, 0, 90 },
			collider = { shape = "box", size = { w, h, d }, offset = { 0, h / 2, 0 }, tags = { "FillCollider" }, canCollide = true },
			walkableTop = { size = { w, d }, height = h, center = { 0, h, 0 }, marker = "stable" },
		}
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">reception_foam_crate</string>
          <string name="Source"><![CDATA[--!strict
-- reception_foam_crate — Caisse mousse (stable, large réception). Générateur paramétrique T03.
-- Brief : caisse orange souple, poignée creuse purement décorative, dessus large.
local ID = "reception_foam_crate"
local FOAM = "#FF9B47"
local FOAM_DARK = "#E9803A"
local HANDLE = "#203055"

local function part(
	name: string,
	size: { number },
	offset: { number },
	color: string,
	material: string,
	canCollide: boolean,
	tags: { string },
	shape: string?
)
	return {
		name = name,
		size = size,
		offset = offset,
		color = color,
		material = material,
		materialFallback = "SmoothPlastic",
		canCollide = canCollide,
		tags = tags,
		shape = shape or "Block",
	}
end

local function readSize(params: any): (number, number, number)
	assert(type(params) == "table" and type(params.size) == "table", ID .. " : params.size (config/rooms.json) requis")
	local w, d, h = params.size[1], params.size[2], params.size[3]
	assert(type(w) == "number" and w > 0 and type(d) == "number" and d > 0 and type(h) == "number" and h > 0, ID .. " : size invalide")
	return w, d, h
end

return {
	id = ID,
	build = function(params: any)
		local w, d, h = readSize(params)
		local band = math.min(0.5, h * 0.15)
		local parts = {
			part("Body", { w, h - 2 * band, d }, { 0, h / 2, 0 }, FOAM, "Fabric", false, { "DecorOnly" }),
			-- bourrelets haut et bas légèrement rentrés (aspect mousse), dessus plat à h
			part("RimTop", { w - 0.2, band, d - 0.2 }, { 0, h - band / 2, 0 }, FOAM_DARK, "Fabric", false, { "DecorOnly" }),
			part("RimBottom", { w - 0.2, band, d - 0.2 }, { 0, band / 2, 0 }, FOAM_DARK, "Fabric", false, { "DecorOnly" }),
			-- poignées creuses (visuel seulement, aucune prise de collision)
			part(
				"HandleFront",
				{ w * 0.35, h * 0.18, 0.06 },
				{ 0, h * 0.62, -d / 2 - 0.03 },
				HANDLE,
				"SmoothPlastic",
				false,
				{ "DecorOnly" }
			),
			part(
				"HandleBack",
				{ w * 0.35, h * 0.18, 0.06 },
				{ 0, h * 0.62, d / 2 + 0.03 },
				HANDLE,
				"SmoothPlastic",
				false,
				{ "DecorOnly" }
			),
		}
		return {
			id = ID,
			parts = parts,
			collider = { shape = "box", size = { w, h, d }, offset = { 0, h / 2, 0 }, tags = { "FillCollider" }, canCollide = true },
			walkableTop = { size = { w, d }, height = h, center = { 0, h, 0 }, marker = "stable" },
		}
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">reception_pallet</string>
          <string name="Source"><![CDATA[--!strict
-- reception_pallet — Palette turquoise (stable, palier de repos). Générateur paramétrique T03.
-- Brief : palette plastique turquoise, plateau FERMÉ sans fentes piégeuses.
local ID = "reception_pallet"
local DECK = "#2ACBC7"
local RUNNER = "#1FA7A4"

local function part(
	name: string,
	size: { number },
	offset: { number },
	color: string,
	material: string,
	canCollide: boolean,
	tags: { string },
	shape: string?
)
	return {
		name = name,
		size = size,
		offset = offset,
		color = color,
		material = material,
		materialFallback = "SmoothPlastic",
		canCollide = canCollide,
		tags = tags,
		shape = shape or "Block",
	}
end

local function readSize(params: any): (number, number, number)
	assert(type(params) == "table" and type(params.size) == "table", ID .. " : params.size (config/rooms.json) requis")
	local w, d, h = params.size[1], params.size[2], params.size[3]
	assert(type(w) == "number" and w > 0 and type(d) == "number" and d > 0 and type(h) == "number" and h > 0, ID .. " : size invalide")
	return w, d, h
end

return {
	id = ID,
	build = function(params: any)
		local w, d, h = readSize(params)
		local deckT = h * 0.4
		local runnerH = h - deckT
		local parts = {
			part("Deck", { w, deckT, d }, { 0, h - deckT / 2, 0 }, DECK, "Plastic", false, { "DecorOnly" }),
		}
		-- trois patins sous le plateau ; leurs côtés sont visuellement fermés par des plinthes
		for i, x in { -w / 2 + 0.8, 0, w / 2 - 0.8 } do
			table.insert(parts, part("Runner" .. i, { 1.6, runnerH, d }, { x, runnerH / 2, 0 }, RUNNER, "Plastic", false, { "DecorOnly" }))
		end
		table.insert(
			parts,
			part("SkirtFront", { w, runnerH, 0.2 }, { 0, runnerH / 2, -d / 2 + 0.1 }, RUNNER, "Plastic", false, { "DecorOnly" })
		)
		table.insert(
			parts,
			part("SkirtBack", { w, runnerH, 0.2 }, { 0, runnerH / 2, d / 2 - 0.1 }, RUNNER, "Plastic", false, { "DecorOnly" })
		)
		return {
			id = ID,
			parts = parts,
			-- collision pleine : pas de fente où un pied pourrait se coincer
			collider = { shape = "box", size = { w, h, d }, offset = { 0, h / 2, 0 }, tags = { "FillCollider" }, canCollide = true },
			walkableTop = { size = { w, d }, height = h, center = { 0, h, 0 }, marker = "stable" },
		}
	end,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">reception_suitcase</string>
          <string name="Source"><![CDATA[--!strict
-- reception_suitcase — Valise orange couchée (stable). Générateur paramétrique T03.
-- NOTE : le manifeste prévoit un mesh Blender (production_method = blender_mesh_and_optional_rig) ;
-- ce générateur fournit une version primitives jouable et fidèle au gabarit, en attendant ce mesh.
-- Brief : valise couchée orange à nervures peu profondes ; poignée et roues SANS collision.
local ID = "reception_suitcase"
local SHELL = "#FF8A3D"
local RIB = "#E8732B"
local TRIM = "#203055"

local function part(
	name: string,
	size: { number },
	offset: { number },
	color: string,
	material: string,
	canCollide: boolean,
	tags: { string },
	shape: string?
)
	return {
		name = name,
		size = size,
		offset = offset,
		color = color,
		material = material,
		materialFallback = "SmoothPlastic",
		canCollide = canCollide,
		tags = tags,
		shape = shape or "Block",
	}
end

local function readSize(params: any): (number, number, number)
	assert(type(params) == "table" and type(params.size) == "table", ID .. " : params.size (config/rooms.json) requis")
	local w, d, h = params.size[1], params.size[2], params.size[3]
	assert(type(w) == "number" and w > 0 and type(d) == "number" and d > 0 and type(h) == "number" and h > 0, ID .. " : size invalide")
	return w, d, h
end

return {
	id = ID,
	build = function(params: any)
		local w, d, h = readSize(params)
		local parts = {
			part("Shell", { w, h, d }, { 0, h / 2, 0 }, SHELL, "SmoothPlastic", false, { "DecorOnly" }),
			-- jonction des deux coques, à mi-hauteur
			part("Seam", { w + 0.04, 0.18, d + 0.04 }, { 0, h / 2, 0 }, TRIM, "SmoothPlastic", false, { "DecorOnly" }),
		}
		-- nervures peu profondes sur le dessus (0.05 stud : dessus visible ≈ collision)
		for i = 1, 4 do
			local x = -w / 2 + i * w / 5
			table.insert(
				parts,
				part("Rib" .. i, { 0.35, 0.05, d - 0.6 }, { x, h + 0.025, 0 }, RIB, "SmoothPlastic", false, { "DecorOnly" })
			)
		end
		-- poignée (face avant -Z) et roues (côté droit), décoratives et hors collision
		table.insert(
			parts,
			part("Handle", { w * 0.3, 0.35, 0.5 }, { 0, h * 0.55, -d / 2 - 0.25 }, TRIM, "SmoothPlastic", false, { "DecorOnly" })
		)
		for _, z in { -d / 2 + 0.8, d / 2 - 0.8 } do
			table.insert(
				parts,
				part("Wheel", { 0.4, 0.9, 0.9 }, { w / 2 + 0.2, 0.45, z }, TRIM, "Rubber", false, { "DecorOnly" }, "Cylinder")
			)
		end
		return {
			id = ID,
			parts = parts,
			collider = { shape = "box", size = { w, h, d }, offset = { 0, h / 2, 0 }, tags = { "FillCollider" }, canCollide = true },
			walkableTop = { size = { w, d }, height = h, center = { 0, h, 0 }, marker = "stable" },
			-- une valise posée ne roule jamais : ancrage après stabilisation (rooms.json behavior_defaults.stable)
			anchorAfterSettle = true,
		}
	end,
}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="73">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpHeight">7.2</float>
      <bool name="CharacterUseJumpPower">false</bool>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="74">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="75">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="76">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
-- Mobile-friendly third-person camera: classic follow with a slightly higher default pitch so the
-- next landing stays visible; zoom bounds fit small rooms; decorative parts never block the view
-- (they are CanQuery = false). The camera never performs a jump for the player.
local Players = game:GetService("Players")

local CameraController = {}

function CameraController.start()
	local plr = Players.LocalPlayer
	plr.CameraMinZoomDistance = 8
	plr.CameraMaxZoomDistance = 28
	plr.DevComputerCameraMode = Enum.DevComputerCameraMovementMode.Classic
	plr.DevTouchCameraMode = Enum.DevTouchCameraMovementMode.Classic
	local cam = workspace.CurrentCamera
	cam.FieldOfView = 72
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
-- Immediate visual feedback: wave warnings (coral triangle zone under the mouth, before impact),
-- Radar highlights (mint outline, removed after the configured duration). Purely visual.
local Debris = game:GetService("Debris")

local Net = require(script.Parent.Parent.Net)

local EffectsController = {}

function EffectsController.start()
	Net.on("WaveWarning", function(e)
		if typeof(e.mouth) ~= "CFrame" then
			return
		end
		local zone = Instance.new("Part")
		zone.Name = "WaveWarning"
		zone.Anchored = true
		zone.CanCollide = false
		zone.CanQuery = false
		zone.Size = Vector3.new(e.size.X, 0.2, e.size.Z)
		zone.CFrame = CFrame.new(e.mouth.Position.X, e.mouth.Position.Y - 0.6, e.mouth.Position.Z)
		zone.Color = Color3.fromHex("#FF684B")
		zone.Material = Enum.Material.Neon
		zone.Transparency = 0.35
		local sign = Instance.new("BillboardGui")
		sign.Size = UDim2.new(0, 64, 0, 64)
		sign.AlwaysOnTop = true
		local tri = Instance.new("TextLabel")
		tri.Size = UDim2.new(1, 0, 1, 0)
		tri.BackgroundTransparency = 1
		tri.Text = "▲"
		tri.TextScaled = true
		tri.TextColor3 = Color3.fromHex("#FF684B")
		tri.Parent = sign
		sign.Parent = zone
		zone.Parent = workspace
		Debris:AddItem(zone, math.max(0.2, e.impactIn) + 0.3)
	end)
	Net.on("ToolEffect", function(e)
		if e.kind ~= "highlight" then
			return
		end
		for _, m in e.targets or {} do
			if typeof(m) == "Instance" then
				local h = Instance.new("Highlight")
				h.FillTransparency = 0.7
				h.FillColor = Color3.fromHex("#39E68B")
				h.OutlineColor = Color3.fromHex("#39E68B")
				h.Parent = m
				Debris:AddItem(h, e.duration)
			end
		end
	end)
end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict
-- Room HUD: coins / permits, room label (brief, non-blocking), gains summary in the sas, burial
-- alert "DÉGAGE-TOI" with free direction, KO panel with a FREE restart. Displays server state
-- only; it never credits anything. There is NO survival timer and NO global fill bar.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Strings = require(Shared.Strings)
local Net = require(script.Parent.Parent.Net)
local Ui = require(script.Parent.Ui)

local HUDController = {}

local function lang(): string
	return (Net.state.settings and Net.state.settings.language) or "fr"
end

function HUDController.start()
	local gui = Ui.screen("HUD")
	local top = Ui.panel(gui, UDim2.new(0, 260, 0, 54), UDim2.new(0, 16, 0, 12))
	local coins = Ui.label(top, "0", UDim2.new(0.5, -8, 1, -12), UDim2.new(0, 10, 0, 6), Ui.C.navy)
	local permits = Ui.label(top, "0", UDim2.new(0.5, -8, 1, -12), UDim2.new(0.5, 0, 0, 6), Ui.C.violet)
	local roomLabel = Ui.label(gui, "", UDim2.new(0, 360, 0, 40), UDim2.new(0.5, -180, 0, 14), Ui.C.navy)
	roomLabel.Visible = false
	local toast = Ui.label(gui, "", UDim2.new(0, 420, 0, 46), UDim2.new(0.5, -210, 0.18, 0), Ui.C.navy)
	toast.Visible = false
	local alert = Ui.panel(gui, UDim2.new(0, 300, 0, 64), UDim2.new(0.5, -150, 0.72, 0), Ui.C.coral)
	alert.Visible = false
	Ui.label(alert, "▲ " .. Strings.get(lang(), "dig_out"), UDim2.new(1, -16, 1, -12), UDim2.new(0, 8, 0, 6), Ui.C.cream)

	local function showToast(text: string, seconds: number)
		toast.Text = text
		toast.Visible = true
		task.delay(seconds, function()
			if toast.Text == text then
				toast.Visible = false
			end
		end)
	end

	Net.on("State", function(s)
		coins.Text = "● " .. tostring(s.coins or 0)
		permits.Text = "◆ " .. tostring(s.permits or 0)
		if gui:GetAttribute("NonPersistent") == nil and game:GetService("Players").LocalPlayer:GetAttribute("NonPersistentProgress") then
			gui:SetAttribute("NonPersistent", true)
			showToast("Test : progression non persistante", 4)
		end
	end)

	local koPanel: Frame? = nil
	Net.on("Hud", function(e)
		if e.type == "room_enter" then
			roomLabel.Text = Strings.get(lang(), "room_label", e.family, e.depth)
			roomLabel.Visible = true
			task.delay(2.5, function()
				roomLabel.Visible = false
			end)
			if koPanel then
				koPanel:Destroy()
				koPanel = nil
			end
		elseif e.type == "hint" then
			showToast(Strings.get(lang(), e.key), 4)
		elseif e.type == "reward" or e.type == "milestone" then
			showToast(
				"+"
					.. tostring(e.amount or e.coins)
					.. " Coins"
					.. (if e.type == "milestone" then "  ·  " .. Strings.get(lang(), "climb") else ""),
				1.5
			)
		elseif e.type == "gains" then
			showToast(string.format("+%d Coins  +%d ◆  +%d XP", e.coins or 0, e.permits or 0, e.xp or 0), 2.5)
		elseif e.type == "save_status" then
			showToast(Strings.get(lang(), if e.ok then "saved" else "save_failed"), 1.5)
		elseif e.type == "save_failed_retry" then
			showToast(Strings.get(lang(), "save_failed"), 1)
		elseif e.type == "loading_next" then
			showToast(Strings.get(lang(), "loading_next"), 1)
		elseif e.type == "ko" then
			local panel = Ui.panel(gui, UDim2.new(0, 380, 0, 220), UDim2.new(0.5, -190, 0.5, -110))
			Ui.label(panel, Strings.get(lang(), "ko_title"), UDim2.new(1, -20, 0, 50), UDim2.new(0, 10, 0, 10), Ui.C.coral)
			Ui.label(panel, Strings.get(lang(), "ko_kept"), UDim2.new(1, -20, 0, 40), UDim2.new(0, 10, 0, 70), Ui.C.navy)
			Ui.button(panel, Strings.get(lang(), "restart"), UDim2.new(0, 220, 0, 56), UDim2.new(0.5, -110, 1, -76), Ui.C.mint, function()
				Net.intent("RequestRestart", Net.requestId())
			end)
			koPanel = panel
		end
	end)

	Net.on("BurialWarning", function(e)
		alert.Visible = e.on == true
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--!strict
-- Shared controller for every player (no paid movement advantage): normalized walk speed and jump
-- height from config, coyote time 0.12 s, jump buffer 0.12 s, basic ledge recovery. The assist
-- never jumps by itself: it only honours a jump the player pressed slightly early / late.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.GeneratedConfig)

local P = Config.Runtime.player

local MovementController = {}

local lastGrounded = -math.huge
local lastJumpPress = -math.huge
local glideMultiplier: number? = nil
local glideUntil = 0
local stepConn: RBXScriptConnection? = nil

function MovementController.setGlide(mult: number, duration: number)
	glideMultiplier = mult
	glideUntil = os.clock() + duration
end

local function bind(character: Model)
	local hum = character:WaitForChild("Humanoid") :: Humanoid
	local root = character:WaitForChild("HumanoidRootPart") :: BasePart
	hum.UseJumpPower = false
	hum.WalkSpeed = P.walk_speed_studs_s
	hum.JumpHeight = P.jump_height_studs
	workspace.Gravity = P.gravity_studs_s2
	hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			lastGrounded = os.clock()
			-- jump buffer: a press within 0.12 s before landing is honoured
			if os.clock() - lastJumpPress <= P.jump_buffer_seconds then
				lastJumpPress = -math.huge
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end)
	if stepConn then
		stepConn:Disconnect() -- one per character: no pile-up across respawns
	end
	stepConn = RunService.RenderStepped:Connect(function()
		if hum.FloorMaterial ~= Enum.Material.Air then
			lastGrounded = os.clock()
		end
		-- umbrella glide (server-approved effect): caps descent speed only, never pushes up
		if glideMultiplier and os.clock() < glideUntil then
			local v = root.AssemblyLinearVelocity
			local cap = -math.sqrt(2 * P.gravity_studs_s2 * P.jump_height_studs) * glideMultiplier
			if v.Y < cap then
				root.AssemblyLinearVelocity = Vector3.new(v.X, cap, v.Z)
			end
		else
			glideMultiplier = nil
		end
		-- basic ledge recovery: if chest-high on a ledge edge while rising/falling slowly toward it
		if hum.FloorMaterial == Enum.Material.Air and hum.MoveDirection.Magnitude > 0.5 then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { character }
			params.RespectCanCollide = true -- ignore query-only volumes such as ExitClearance
			local ahead = hum.MoveDirection * 1.6
			local hitChest = workspace:Raycast(root.Position, ahead, params)
			local hitHead = workspace:Raycast(root.Position + Vector3.new(0, 1.6, 0), ahead, params)
			if hitChest and not hitHead and root.AssemblyLinearVelocity.Y < 6 then
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(v.X, 14, v.Z)
			end
		end
	end)
end

function MovementController.start()
	UserInputService.JumpRequest:Connect(function()
		local char = Players.LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then
			return
		end
		lastJumpPress = os.clock()
		-- coyote time: a jump pressed up to 0.12 s after leaving a ledge still counts
		if hum.FloorMaterial == Enum.Material.Air and os.clock() - lastGrounded <= P.coyote_time_seconds then
			lastGrounded = -math.huge
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
	local plr = Players.LocalPlayer
	if plr.Character then
		bind(plr.Character)
	end
	plr.CharacterAdded:Connect(bind)
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">PlushDeformationController</string>
              <string name="Source"><![CDATA[--!strict
-- Client-only plush deformation (docs/05 §7). Reconstructs every frame from the REFERENCE pose and
-- the last server impact event (objectInstanceId, serverTime, impactNormal, impactStrength,
-- settleState) via PlushPose. Two render paths:
--   * rig: imported skinned MeshPart with Bones -> Bone.Transform = CFrame(translation) * rotation
--     (no scale on Bone.Transform, it is a CFrame);
--   * proxy: primitive visual parts (diagnostic proxy) scaled around the collider base.
-- LOD: <= 6 animated plushes near the hero (nearest first), 30 Hz near, 15 Hz mid, static far.
-- Disabling it (reduced effects) changes nothing in collisions, rewards or KO.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.GeneratedConfig)
local Pose = require(Shared.Domain.PlushPose)
local Net = require(script.Parent.Parent.Net)
local Settings = require(script.Parent.SettingsController)

local D = Config.Runtime.deformation

local PlushDeformationController = {}

type Entry = {
	model: Model,
	impactAt: number?,
	strength: number,
	rig: any,
	bones: { [string]: Bone }?,
	proxy: { { part: BasePart, size: Vector3, offset: Vector3 } }?,
	lastUpdate: number,
}

local entries: { [Model]: Entry } = {}

local function setup(model: Model): Entry
	local visual = model:FindFirstChild("PlushVisual")
	local bones: { [string]: Bone } = {}
	local restList = {}
	if visual then
		for _, d in visual:GetDescendants() do
			if d:IsA("Bone") then
				bones[d.Name] = d
				local p = d.WorldPosition - (model.PrimaryPart :: BasePart).Position
				table.insert(restList, { name = d.Name, x = p.X, y = p.Y, z = p.Z })
			end
		end
	end
	local hasRig = next(bones) ~= nil
	local proxy = nil
	if visual then
		proxy = {}
		for _, part in visual:GetDescendants() do
			if part:IsA("BasePart") then
				table.insert(
					proxy,
					{ part = part, size = part.Size, offset = (part:GetAttribute("LocalOffset") :: Vector3?) or Vector3.zero }
				)
			end
		end
	end
	return {
		model = model,
		impactAt = nil,
		strength = 0,
		rig = if hasRig then Pose.rigFromBones(restList) else Pose.mallowRig(),
		bones = if hasRig then bones else nil,
		proxy = proxy,
		lastUpdate = 0,
	}
end

local function apply(e: Entry, pose: any)
	local col = e.model.PrimaryPart :: BasePart
	if e.bones then
		for _, b in pose.bones do
			local bone = e.bones[b.name]
			if bone then
				bone.Transform = CFrame.new(b.offset[1], b.offset[2], b.offset[3])
					* CFrame.Angles(b.rotation[1], b.rotation[2], b.rotation[3])
			end
		end
	end
	if e.proxy then
		local base = col.CFrame * CFrame.new(0, -col.Size.Y / 2, 0)
		for _, pp in e.proxy do
			-- skinned mesh: only follows the physical root (deformation comes from the bones)
			local sy, sxz = if e.bones then 1 else pose.scaleY, if e.bones then 1 else pose.scaleXZ
			pp.part.Size = Vector3.new(pp.size.X * sxz, pp.size.Y * sy, pp.size.Z * sxz)
			local off = pp.offset + Vector3.new(0, col.Size.Y / 2, 0)
			pp.part.CFrame = base * CFrame.new(off.X * sxz, off.Y * sy, off.Z * sxz)
		end
	end
end

function PlushDeformationController.start()
	Net.on("PlushImpact", function(ev)
		local model = ev.model
		if typeof(model) ~= "Instance" or not model:IsA("Model") then
			return
		end
		local e = entries[model] or setup(model)
		entries[model] = e
		-- serverTime keeps all clients consistent; poses always start from the reference
		e.impactAt = os.clock() - math.max(0, Workspace:GetServerTimeNow() - ev.serverTime)
		e.strength = ev.impactStrength
	end)
	CollectionService:GetInstanceRemovedSignal("Plush"):Connect(function(inst)
		entries[inst :: Model] = nil
	end)
	RunService.RenderStepped:Connect(function()
		local char = Players.LocalPlayer.Character
		local hero = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not hero then
			return
		end
		local enabled = not Settings.reducedEffects()
		-- discover plushes and rank by distance
		local ranked = {}
		for _, inst in CollectionService:GetTagged("Plush") do
			local m = inst :: Model
			if m.PrimaryPart and m:IsDescendantOf(Workspace) then
				entries[m] = entries[m] or setup(m)
				table.insert(ranked, { e = entries[m], d = (m.PrimaryPart.Position - hero.Position).Magnitude })
			end
		end
		table.sort(ranked, function(a, b)
			return a.d < b.d
		end)
		local now = os.clock()
		for i, r in ranked do
			local e = r.e
			local col = e.model.PrimaryPart :: BasePart
			local hz = if r.d <= D.near_distance_studs then D.near_visual_hz elseif r.d <= D.mid_distance_studs then D.mid_visual_hz else 0
			local animate = enabled and i <= D.max_near_hero_plush and hz > 0
			if animate and now - e.lastUpdate < 1 / hz then
				continue
			end
			e.lastUpdate = now
			local pose
			if not animate then
				pose = Pose.compute(e.rig, { phase = "impact", t = 99, strength = 0, enabled = false })
			elseif not col.Anchored and col.AssemblyLinearVelocity.Y < -2 and e.impactAt == nil then
				pose = Pose.compute(e.rig, { phase = "falling", verticalSpeed = col.AssemblyLinearVelocity.Y })
			else
				local t = if e.impactAt then now - e.impactAt else 99
				local standing = (hero.Position - col.Position).Magnitude < col.Size.Magnitude / 2 + 3
				pose = Pose.compute(e.rig, { phase = "impact", t = t, strength = e.strength, standing = standing })
			end
			apply(e, pose)
		end
	end)
end

return PlushDeformationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--!strict
-- Comfort settings: reduced effects (plush deformation & cosmetic FX off, danger info kept),
-- language FR/EN, ghost hints. Stored locally for the session; gameplay results never depend on
-- them (deformation is visual only).
local Net = require(script.Parent.Parent.Net)

local SettingsController = {}

SettingsController.values = { reducedEffects = false, language = "fr", ghostHints = true }

function SettingsController.start()
	Net.on("State", function(s)
		if s.settings then
			for k, v in s.settings do
				SettingsController.values[k] = v
			end
		end
	end)
end

function SettingsController.reducedEffects(): boolean
	return SettingsController.values.reducedEffects == true
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!strict
-- Sas shop (Coins), Robux tab (always "Boutique indisponible" while product ids are null) and the
-- rebirth flow (preview from the server, then confirm). Opened by a button only in the sas;
-- continuing straight through the door never requires it. States: owned / buyable / insufficient
-- / locked / unavailable, each with text (not colour only).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Strings = require(Shared.Strings)
local Net = require(script.Parent.Parent.Net)
local Ui = require(script.Parent.Ui)

local ShopController = {}

local function lang(): string
	return (Net.state.settings and Net.state.settings.language) or "fr"
end

local function stateText(item): (string, Color3)
	local L = lang()
	if item.state == "owned" then
		return Strings.get(L, "owned"), Ui.C.mint
	elseif item.state == "buyable" then
		return Strings.get(L, "buy_coins", item.price), Ui.C.yellow
	elseif item.state == "insufficient" then
		return Strings.get(L, "insufficient", item.price - (Net.state.coins or 0)), Ui.C.cream
	elseif item.state == "rooms_required" then
		return Strings.get(L, "locked_rooms", item.minRooms or 0), Ui.C.cream
	elseif item.state == "unavailable" then
		return Strings.get(L, "unavailable"), Ui.C.cream
	end
	return tostring(item.state), Ui.C.cream
end

function ShopController.start()
	local gui = Ui.screen("SasShop")
	local open = Ui.button(gui, "Boutique", UDim2.new(0, 140, 0, 52), UDim2.new(1, -156, 0, 12), Ui.C.cyan, function() end)
	open.Visible = false
	local panel = Ui.panel(gui, UDim2.new(0.62, 0, 0.74, 0), UDim2.new(0.19, 0, 0.13, 0))
	panel.Visible = false
	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, -20, 1, -130)
	list.Position = UDim2.new(0, 10, 0, 60)
	list.BackgroundTransparency = 1
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.Parent = list
	list.Parent = panel
	local robux = Ui.label(panel, "", UDim2.new(1, -20, 0, 26), UDim2.new(0, 10, 1, -64), Ui.C.navy)
	Ui.button(panel, "×", UDim2.new(0, 48, 0, 48), UDim2.new(1, -58, 0, 6), Ui.C.cream, function()
		panel.Visible = false
	end)
	local rebirthBtn = Ui.button(panel, "", UDim2.new(0, 220, 0, 48), UDim2.new(0, 10, 0, 6), Ui.C.violet, function() end)

	local function render()
		for _, c in list:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		for _, item in Net.state.catalog or {} do
			local row = Ui.panel(list, UDim2.new(1, -8, 0, 56), UDim2.new())
			Ui.label(
				row,
				item.name .. (if item.rank then " · rang " .. item.rank else "") .. "  ·  " .. Strings.get(lang(), "permanent"),
				UDim2.new(0.55, 0, 1, -10),
				UDim2.new(0, 10, 0, 5),
				Ui.C.navy
			)
			local text, color = stateText(item)
			local b = Ui.button(row, text, UDim2.new(0.4, 0, 1, -10), UDim2.new(0.58, 0, 0, 5), color, function()
				if item.state == "buyable" then
					Net.intent("RequestCoinPurchase", item.skuId, Net.requestId())
				elseif item.state == "owned" and item.kind ~= "upgrade" then
					Net.intent("RequestEquip", item.skuId, item.slot, Net.requestId())
				end
			end)
			b.AutoButtonColor = item.state == "buyable" or item.state == "owned"
		end
		robux.Text = "Robux : " .. Strings.get(lang(), "robux_unavailable")
		rebirthBtn.Text = Strings.get(lang(), "rebirth")
	end

	rebirthBtn.Activated:Connect(function()
		local prev = Net.intent("RequestRebirthPreview", 1, Net.requestId())
		if not prev.ok then
			robux.Text = tostring(prev.error)
			return
		end
		local max = prev.preview
		-- confirmation screen: exact cost, ranks, bonus, remaining permits, restart at room 1
		local confirm = Ui.panel(gui, UDim2.new(0, 460, 0, 260), UDim2.new(0.5, -230, 0.5, -130))
		local L = lang()
		Ui.label(
			confirm,
			string.format(
				"-%d ◆  →  rang %d  ·  bonus +%d%%  ·  reste %d ◆",
				max.cost,
				max.ranksAfter,
				math.floor(max.bonusAfter * 100 + 0.5),
				max.permitsAfter
			),
			UDim2.new(1, -20, 0, 40),
			UDim2.new(0, 10, 0, 14),
			Ui.C.navy
		)
		Ui.label(confirm, Strings.get(L, "rebirth_restart"), UDim2.new(1, -20, 0, 34), UDim2.new(0, 10, 0, 64), Ui.C.coral)
		Ui.label(confirm, Strings.get(L, "rebirth_kept"), UDim2.new(1, -20, 0, 34), UDim2.new(0, 10, 0, 104), Ui.C.navy)
		Ui.button(confirm, Strings.get(L, "rebirth_confirm"), UDim2.new(0.45, 0, 0, 52), UDim2.new(0.03, 0, 1, -64), Ui.C.violet, function()
			Net.intent("RequestRebirth", max.quantity, max.revision, max.token, Net.requestId())
			confirm:Destroy()
		end)
		Ui.button(confirm, Strings.get(L, "continue"), UDim2.new(0.45, 0, 0, 52), UDim2.new(0.52, 0, 1, -64), Ui.C.mint, function()
			confirm:Destroy()
		end)
	end)

	open.Activated:Connect(function()
		panel.Visible = not panel.Visible
		render()
	end)
	Net.on("State", function(s)
		open.Visible = s.inSas == true and not s.kiosk
		if not s.inSas then
			panel.Visible = false
		elseif panel.Visible then
			render()
		end
	end)
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">ToolController</string>
              <string name="Source"><![CDATA[--!strict
-- Tool button (>= 48 px, bottom-right, away from the jump button) sending a USE INTENT only.
-- Visual feedback starts when the server answers; a refused use shows its reason and nothing else.
local Net = require(script.Parent.Parent.Net)
local Ui = require(script.Parent.Ui)
local Movement = require(script.Parent.MovementController)

local ToolController = {}

local function targetUnderCrosshair(): string
	local cam = workspace.CurrentCamera
	local ray = cam:ViewportPointToRay(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 40)
	local m = hit and hit.Instance.Parent
	if m and m:IsA("Model") and m:GetAttribute("ObjectInstanceId") then
		return m:GetAttribute("ObjectInstanceId") :: string
	end
	return ""
end

function ToolController.start()
	local gui = Ui.screen("ToolButton")
	local btn = Ui.button(gui, "", UDim2.new(0, 84, 0, 84), UDim2.new(1, -196, 1, -110), Ui.C.cyan, function() end)
	btn.Visible = false
	local charges = Ui.label(btn, "", UDim2.new(0, 30, 0, 24), UDim2.new(1, -28, 0, -6), Ui.C.navy)
	btn.Activated:Connect(function()
		local toolId = Net.state.loadout and Net.state.loadout.active
		if not toolId then
			return
		end
		local res = Net.intent("RequestToolUse", toolId, targetUnderCrosshair(), Net.requestId())
		if not res.ok then
			btn.Text = "×"
			task.delay(0.6, function()
				btn.Text = ""
			end)
			return
		end
		charges.Text = tostring(res.charges)
		if res.kind == "glide" then
			Movement.setGlide(res.descentMultiplier, res.duration)
		end
	end)
	Net.on("State", function(s)
		local toolId = s.loadout and s.loadout.active
		btn.Visible = toolId ~= nil and s.phase == "Active" and not s.inSas
		if toolId and s.charges then
			charges.Text = tostring(s.charges[toolId] or 0)
		end
	end)
end

return ToolController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--!strict
-- Tutorial hints: one short message and, after 5 s of inaction, a ghost trajectory (dotted beam
-- from the carton to the exit). It never teleports the avatar nor validates a jump.
local Net = require(script.Parent.Parent.Net)

local TutorialController = {}

function TutorialController.start()
	Net.on("Hud", function(e)
		if e.type ~= "ghost_path" then
			return
		end
		local cell: CFrame = e.cell
		local folder = Instance.new("Folder")
		folder.Name = "GhostPath"
		local prev: Vector3? = nil
		for _, b in e.points do
			local p = (cell * CFrame.new(b.cx, b.cy + b.sy / 2 + 0.5, b.cz)).Position
			if prev then
				for i = 1, 8 do
					local t = i / 9
					local dot = Instance.new("Part")
					dot.Shape = Enum.PartType.Ball
					dot.Size = Vector3.new(0.5, 0.5, 0.5)
					dot.Anchored = true
					dot.CanCollide = false
					dot.CanQuery = false
					dot.Material = Enum.Material.Neon
					dot.Color = Color3.fromHex("#39E68B")
					dot.Transparency = 0.3
					dot.Position = prev:Lerp(p, t) + Vector3.new(0, math.sin(t * math.pi) * 3, 0)
					dot.Parent = folder
				end
			end
			prev = p
		end
		folder.Parent = workspace
		task.delay(4, function()
			folder:Destroy()
		end)
	end)
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">TutorialShopController</string>
              <string name="Source"><![CDATA[--!strict
-- First-purchase kiosk in the sas after the tutorial: the Radar shown big, a 2-second demo, and
-- exactly two buttons "Acheter 50 Coins" / "Continuer". No timer, no Robux offer, no forced buy.
-- The price shown comes from the server catalog (config); the server re-checks everything.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Strings = require(Shared.Strings)
local Net = require(script.Parent.Parent.Net)
local Ui = require(script.Parent.Ui)

local TutorialShopController = {}

function TutorialShopController.start()
	local gui = Ui.screen("RadarKiosk")
	local panel = Ui.panel(gui, UDim2.new(0, 420, 0, 280), UDim2.new(0.5, -210, 0.5, -140))
	panel.Visible = false
	local title = Ui.label(panel, "Radar POP", UDim2.new(1, -20, 0, 44), UDim2.new(0, 10, 0, 10), Ui.C.navy)
	local info = Ui.label(panel, "", UDim2.new(1, -20, 0, 34), UDim2.new(0, 10, 0, 60), Ui.C.navy)
	local icon = Instance.new("Frame")
	icon.Size = UDim2.new(0, 96, 0, 96)
	icon.Position = UDim2.new(0.5, -48, 0, 98)
	icon.BackgroundColor3 = Ui.C.cyan
	Ui.round(icon, 24)
	icon.Parent = panel
	local status = Ui.label(panel, "", UDim2.new(1, -20, 0, 22), UDim2.new(0, 10, 1, -98), Ui.C.coral)
	local closed = false
	local buy = Ui.button(panel, "", UDim2.new(0.5, -20, 0, 56), UDim2.new(0, 10, 1, -66), Ui.C.yellow, function()
		local lang = (Net.state.settings and Net.state.settings.language) or "fr"
		local res = Net.intent("RequestCoinPurchase", "radar_pop", Net.requestId())
		if res.ok then
			Net.intent("RequestEquip", "radar_pop", "active", Net.requestId())
			panel.Visible = false
			closed = true
		else
			status.Text = if res.error == "network_error" then Strings.get(lang, "network_error") else tostring(res.error)
		end
	end)
	Ui.button(panel, "", UDim2.new(0.5, -20, 0, 56), UDim2.new(0.5, 10, 1, -66), Ui.C.mint, function()
		panel.Visible = false
		closed = true
	end).Name =
		"Continue"

	Net.on("State", function(s)
		local lang = (s.settings and s.settings.language) or "fr"
		if not s.kiosk or closed or (s.ownedTools and s.ownedTools.radar_pop) then
			panel.Visible = false
			return
		end
		local price = 50
		for _, item in s.catalog or {} do
			if item.skuId == "radar_pop" then
				price = item.price
			end
		end
		title.Text = "Radar POP"
		info.Text = string.format("%d Coins → %d", s.coins or 0, (s.coins or 0) - price)
		buy.Text = Strings.get(lang, "buy_coins", price);
		(panel:FindFirstChild("Continue") :: TextButton).Text = Strings.get(lang, "continue")
		panel.Visible = true
		-- 2-second demo pulse of the radar wave (visual only)
		task.spawn(function()
			for _ = 1, 4 do
				icon.BackgroundColor3 = Ui.C.mint
				task.wait(0.25)
				icon.BackgroundColor3 = Ui.C.cyan
				task.wait(0.25)
			end
		end)
	end)
end

return TutorialShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Ui</string>
              <string name="Source"><![CDATA[--!strict
-- Tiny UI kit from the design tokens (assets/source/design/design_tokens.json): colours, rounded
-- panels, buttons >= 44 pt, short texts. Every functional state pairs a colour with a text/icon.
local Players = game:GetService("Players")

local Ui = {}

Ui.C = {
	cream = Color3.fromHex("#FFF5DF"),
	navy = Color3.fromHex("#203055"),
	cyan = Color3.fromHex("#16D9FF"),
	yellow = Color3.fromHex("#FFE14D"),
	pink = Color3.fromHex("#FF4CB8"),
	mint = Color3.fromHex("#39E68B"),
	coral = Color3.fromHex("#FF684B"),
	violet = Color3.fromHex("#8855FF"),
}
Ui.MIN_TOUCH = 48

function Ui.screen(name: string): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

function Ui.round(inst: GuiObject, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 14)
	c.Parent = inst
end

function Ui.label(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3?, textSize: number?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Text = text
	l.Font = Enum.Font.GothamBold
	l.TextColor3 = color or Ui.C.navy
	l.TextScaled = textSize == nil
	if textSize then
		l.TextSize = textSize
	end
	l.Parent = parent
	return l
end

function Ui.panel(parent: Instance, size: UDim2, pos: UDim2, color: Color3?): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = color or Ui.C.cream
	f.BorderSizePixel = 0
	Ui.round(f)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Ui.C.navy
	stroke.Thickness = 2
	stroke.Parent = f
	f.Parent = parent
	return f
end

function Ui.button(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3, onClick: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = color
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextColor3 = Ui.C.navy
	b.TextScaled = true
	b.AutoButtonColor = true
	Ui.round(b, 12)
	local c = Instance.new("UISizeConstraint")
	c.MinSize = Vector2.new(Ui.MIN_TOUCH, Ui.MIN_TOUCH)
	c.Parent = b
	b.Activated:Connect(onClick)
	b.Parent = parent
	return b
end

return Ui
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="88">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client bootstrap: controllers consume authoritative server state; none of them grants anything.
local Controllers = script.Parent:WaitForChild("Controllers")

for _, name in
	{
		"SettingsController",
		"MovementController",
		"CameraController",
		"HUDController",
		"TutorialController",
		"TutorialShopController",
		"ShopController",
		"ToolController",
		"EffectsController",
		"PlushDeformationController",
	}
do
	local ok, err = pcall(function()
		(require(Controllers:WaitForChild(name)) :: any).start()
	end)
	if not ok then
		warn("[FillingUp] controller failed:", name, err)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Client network wrapper: sends intents (never amounts), receives authoritative state.
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local intent = remotes:WaitForChild("Intent") :: RemoteFunction

Net.state = {} :: any
local listeners: { [string]: { (any) -> () } } = {}

function Net.requestId(): string
	return HttpService:GenerateGUID(false):sub(1, 18)
end

-- Returns the server answer table ({ ok = bool, ... }); network errors are reported honestly.
function Net.intent(name: string, ...: any): any
	local args = { ... }
	local ok, res = pcall(function()
		return intent:InvokeServer(name, args)
	end)
	if not ok then
		return { ok = false, error = "network_error" }
	end
	return res
end

function Net.on(event: string, fn: (any) -> ())
	listeners[event] = listeners[event] or {}
	table.insert(listeners[event], fn)
end

local function dispatch(event: string, payload: any)
	for _, fn in listeners[event] or {} do
		task.spawn(fn, payload)
	end
end

for _, name in { "State", "Hud", "WaveWarning", "PlushImpact", "RadarHighlight", "BurialWarning", "ToolEffect", "Transition" } do
	local ev = remotes:WaitForChild(name) :: RemoteEvent
	ev.OnClientEvent:Connect(function(payload)
		if name == "State" then
			Net.state = payload
		end
		dispatch(name, payload)
	end)
end

return Net
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
