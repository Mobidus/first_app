      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Public contracts (docs/05_ARCHITECTURE_ET_TESTS.md §4–5). Type-only module.

export type ExpeditionPhase = "Preparing" | "Active" | "Transitioning" | "Suspended" | "KO" | "Extracted"

export type KOCause = "confirmed_burial" | "marked_kill_volume"

export type Checkpoint = {
	runId: string,
	seed: number,
	configVersion: string,
	depth: number,
	roomRewardMask: number,
	lastCommittedDepth: number,
	checkpointRevision: number,
	roomInstanceId: string,
	chargesSnapshot: { [string]: number }?,
	rateBasisPoints: number,
	paidBaseCumulative: number,
}

export type RoomMastery = {
	totalCompleted: number,
	families: { [string]: number },
	firstRebirthQualified: boolean,
}

export type EquippedLoadout = {
	active: string?,
	passive: string?,
	companion: string?,
	trail: string?,
	tool_skin: string?,
	landing_fx: string?,
	victory_fx: string?,
	workshop_skin: string?,
}

export type PurchaseLedger = {
	-- receiptId (PurchaseId) -> true once durably granted (contract extension, decision 0005)
	receipts: { [string]: boolean },
	receiptOrder: { string },
	entitlements: { [string]: boolean },
}

export type PlayerProfile = {
	schemaVersion: number,
	revision: number,
	coins: number,
	xp: number,
	permits: number,
	rebirthCount: number,
	ownedTools: { [string]: boolean },
	toolRanks: { [string]: number },
	ownedCosmetics: { [string]: boolean },
	equippedLoadout: EquippedLoadout,
	roomMastery: RoomMastery,
	bestDepth: number,
	tutorialFlags: { [string]: boolean },
	checkpoint: Checkpoint?,
	settings: { reducedEffects: boolean, language: string, ghostHints: boolean },
	purchaseLedger: PurchaseLedger,
}

export type ExpeditionState = {
	runId: string,
	seed: number,
	configVersion: string,
	controllerProfileId: string,
	depth: number,
	state: ExpeditionPhase,
	roomId: string,
	waveIndex: number,
	roomRewardMask: number,
	lastCommittedDepth: number,
	equippedLoadoutSnapshot: EquippedLoadout,
	checkpointRevision: number,
	koCause: KOCause?,
	transitionsCommitted: number,
	resumed: boolean,
}

export type Box = { cx: number, cy: number, cz: number, sx: number, sy: number, sz: number }

export type RouteNode = {
	id: string,
	kind: "floor" | "column" | "exit_ledge",
	box: Box, -- collider top surface box of the node (studs, room-local, y = up)
	topY: number,
	walkable: { w: number, d: number },
	stack: { { propId: string, box: Box } },
	arrival: "present" | "wave1",
	behavior: string,
	protected: boolean,
}

export type RouteEdge = { from: string, to: string, gap: number, rise: number, kind: "jump" | "walk" }

export type RoomDefinition = {
	templateId: string,
	familyId: string,
	formatId: string,
	exitType: string,
	seed: number,
	depth: number,
	size: { w: number, d: number, h: number },
	routeGraph: { nodes: { RouteNode }, edges: { RouteEdge } },
	spawnZones: { Box },
	safeZones: { Box },
	exitClearance: Box,
	exitOpening: Box,
	waveMouths: { Box },
	collisionBudget: { dynamic: number, static: number, decor: number },
	themeManifestId: string,
	tokens: { { id: number, x: number, y: number, z: number } },
	milestoneHeights: { number },
	fallback: boolean,
	diagnostics: { string },
}

export type ImpactEvent = {
	objectInstanceId: string,
	serverTime: number,
	impactNormal: { x: number, y: number, z: number },
	impactStrength: number,
	settleState: "falling" | "impact" | "settling" | "supporting",
}

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Box</string>
            <string name="Source"><![CDATA[--!strict
-- Axis-aligned boxes in room-local studs (y = up). Pure math for generation and validation.
local Types = require(script.Parent.Parent.Types)
type Box = Types.Box

local Box = {}

function Box.new(cx: number, cy: number, cz: number, sx: number, sy: number, sz: number): Box
	return { cx = cx, cy = cy, cz = cz, sx = sx, sy = sy, sz = sz }
end

-- Box resting on y = bottom
function Box.onFloor(cx: number, bottom: number, cz: number, sx: number, sy: number, sz: number): Box
	return { cx = cx, cy = bottom + sy / 2, cz = cz, sx = sx, sy = sy, sz = sz }
end

function Box.top(b: Box): number
	return b.cy + b.sy / 2
end

function Box.bottom(b: Box): number
	return b.cy - b.sy / 2
end

-- Strict interior overlap (touching faces do not count), shrunk by eps on every axis.
function Box.intersects(a: Box, b: Box, eps: number?): boolean
	local e = eps or 1e-6
	return math.abs(a.cx - b.cx) * 2 < (a.sx + b.sx) - 2 * e
		and math.abs(a.cy - b.cy) * 2 < (a.sy + b.sy) - 2 * e
		and math.abs(a.cz - b.cz) * 2 < (a.sz + b.sz) - 2 * e
end

-- Footprint (x/z) overlap only
function Box.overlapsXZ(a: Box, b: Box, eps: number?): boolean
	local e = eps or 1e-6
	return math.abs(a.cx - b.cx) * 2 < (a.sx + b.sx) - 2 * e and math.abs(a.cz - b.cz) * 2 < (a.sz + b.sz) - 2 * e
end

function Box.expand(b: Box, dx: number, dy: number, dz: number): Box
	return { cx = b.cx, cy = b.cy, cz = b.cz, sx = b.sx + 2 * dx, sy = b.sy + 2 * dy, sz = b.sz + 2 * dz }
end

-- Is footprint of `inner` inside footprint of `outer` (x/z)?
function Box.footprintInside(inner: Box, outer: Box, eps: number?): boolean
	local e = eps or 1e-6
	return inner.cx - inner.sx / 2 >= outer.cx - outer.sx / 2 - e
		and inner.cx + inner.sx / 2 <= outer.cx + outer.sx / 2 + e
		and inner.cz - inner.sz / 2 >= outer.cz - outer.sz / 2 - e
		and inner.cz + inner.sz / 2 <= outer.cz + outer.sz / 2 + e
end

-- Edge-to-edge horizontal gap between two footprints (0 when touching/overlapping).
function Box.gapXZ(a: Box, b: Box): number
	local dx = math.max(0, math.abs(a.cx - b.cx) - (a.sx + b.sx) / 2)
	local dz = math.max(0, math.abs(a.cz - b.cz) - (a.sz + b.sz) / 2)
	return math.sqrt(dx * dx + dz * dz)
end

function Box.containsPoint(b: Box, x: number, y: number, z: number): boolean
	return math.abs(x - b.cx) * 2 <= b.sx and math.abs(y - b.cy) * 2 <= b.sy and math.abs(z - b.cz) * 2 <= b.sz
end

-- Is box fully inside the room volume [-w/2,w/2] x [0,h] x [-d/2,d/2]?
function Box.insideRoom(b: Box, w: number, d: number, h: number, eps: number?): boolean
	local e = eps or 1e-6
	return b.cx - b.sx / 2 >= -w / 2 - e
		and b.cx + b.sx / 2 <= w / 2 + e
		and b.cz - b.sz / 2 >= -d / 2 - e
		and b.cz + b.sz / 2 <= d / 2 + e
		and b.cy - b.sy / 2 >= -e
		and b.cy + b.sy / 2 <= h + e
end

return Box
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Maid</string>
            <string name="Source"><![CDATA[--!strict
-- Owner-scoped cleanup: every connection, instance, thread or callback created for a room is
-- given to that room's Maid and destroyed with it (no callbacks surviving a transition).
local Maid = {}
Maid.__index = Maid

export type Maid = typeof(setmetatable({} :: { _tasks: { any }, _live: number }, Maid))

Maid.globalLive = 0

function Maid.new(): Maid
	return setmetatable({ _tasks = {}, _live = 0 }, Maid)
end

function Maid.give<T>(self: Maid, task: T): T
	table.insert(self._tasks, task)
	self._live += 1
	Maid.globalLive += 1
	return task
end

function Maid.count(self: Maid): number
	return self._live
end

local function cleanup(task: any)
	local kind = typeof(task)
	if kind == "function" then
		task()
	elseif kind == "RBXScriptConnection" then
		task:Disconnect()
	elseif kind == "Instance" then
		task:Destroy()
	elseif kind == "thread" then
		pcall(coroutine.close, task)
	elseif type(task) == "table" then
		if type(task.Disconnect) == "function" then
			task:Disconnect()
		elseif type(task.Destroy) == "function" then
			task:Destroy()
		elseif type(task.destroy) == "function" then
			task:destroy()
		end
	end
end

function Maid.clean(self: Maid)
	local tasks = self._tasks
	self._tasks = {}
	for i = #tasks, 1, -1 do
		cleanup(tasks[i])
	end
	Maid.globalLive -= self._live
	self._live = 0
end

Maid.Destroy = Maid.clean

return Maid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic PRNG (xorshift32 + FNV-1a seed derivation) implemented with bit32 so that
-- Roblox servers and the offline test runner (Lune) produce identical sequences for a seed.
-- Roblox's Random is not used in domain code because it is unavailable outside the engine.

local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { state: number }, Rng))

local function fnv1a(text: string): number
	local hash = 2166136261
	for i = 1, #text do
		hash = bit32.bxor(hash, string.byte(text, i))
		-- multiply by FNV prime 16777619 = 2^24 + 403 modulo 2^32 (exact in doubles: < 2^53)
		hash = (bit32.lshift(hash, 24) + hash * 403) % 4294967296
	end
	return hash
end

function Rng.hash(text: string): number
	return fnv1a(text)
end

-- Derive a child seed from a parent seed and a salt (e.g. "room:12" or "wave:3").
function Rng.derive(seed: number, salt: string): number
	local h = fnv1a(tostring(math.floor(seed)) .. "|" .. salt)
	if h == 0 then
		h = 0x9E3779B9
	end
	return h
end

function Rng.new(seed: number): Rng
	local s = bit32.band(math.floor(seed), 0xFFFFFFFF)
	if s == 0 then
		s = 0x6D2B79F5
	end
	local self = setmetatable({ state = s }, Rng)
	-- warm up
	for _ = 1, 4 do
		self:nextU32()
	end
	return self
end

function Rng.nextU32(self: Rng): number
	local x = self.state
	x = bit32.bxor(x, bit32.lshift(x, 13))
	x = bit32.bxor(x, bit32.rshift(x, 17))
	x = bit32.bxor(x, bit32.lshift(x, 5))
	self.state = x
	return x
end

-- Uniform number in [0, 1)
function Rng.nextNumber(self: Rng): number
	return self:nextU32() / 4294967296
end

-- Uniform integer in [lo, hi]
function Rng.nextInt(self: Rng, lo: number, hi: number): number
	assert(hi >= lo, "Rng.nextInt: empty range")
	return lo + (self:nextU32() % (hi - lo + 1))
end

function Rng.nextRange(self: Rng, lo: number, hi: number): number
	return lo + (hi - lo) * self:nextNumber()
end

function Rng.pick<T>(self: Rng, list: { T }): T
	assert(#list > 0, "Rng.pick: empty list")
	return list[self:nextInt(1, #list)]
end

function Rng.shuffle<T>(self: Rng, list: { T }): { T }
	local copy = table.clone(list)
	for i = #copy, 2, -1 do
		local j = self:nextInt(1, i)
		copy[i], copy[j] = copy[j], copy[i]
	end
	return copy
end

return Rng
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
